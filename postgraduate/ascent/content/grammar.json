{
  "chapter": 1,
  "title": "夯实高中",
  "subtitle": "高中常见句式 · 知识地图",
  "blurb": "开章先诊断，已经扎实的单元直接点亮；每个单元学完一张回顾卡。全部点亮，就是一张完整的高中英语知识地图。",
  "units": [
    {
      "id": "tense",
      "name": "时态",
      "order": 1,
      "difficulty": 1,
      "blurb": "把事情发生的时间说清楚",
      "patterns": [
        { "id": "tense-present-simple", "name": "一般现在时", "difficulty": 1 },
        { "id": "tense-present-continuous", "name": "现在进行时", "difficulty": 1 },
        { "id": "tense-past-simple", "name": "一般过去时", "difficulty": 1 },
        { "id": "tense-present-perfect", "name": "现在完成时", "difficulty": 2 },
        { "id": "tense-past-continuous", "name": "过去进行时", "difficulty": 2 },
        { "id": "tense-past-perfect", "name": "过去完成时", "difficulty": 2 },
        { "id": "tense-future", "name": "将来时", "difficulty": 1 }
      ]
    },
    {
      "id": "passive",
      "name": "被动语态",
      "order": 2,
      "difficulty": 1,
      "blurb": "强调动作承受者，或不必说出动作发出者",
      "patterns": [
        { "id": "passive-basic", "name": "一般被动：be + 过去分词", "difficulty": 1 },
        { "id": "passive-perfect", "name": "完成被动：have been + 过去分词", "difficulty": 2 },
        { "id": "passive-modal", "name": "情态 + 被动", "difficulty": 2 },
        { "id": "passive-get", "name": "get + 过去分词", "difficulty": 2 }
      ]
    },
    {
      "id": "nonfinite",
      "name": "非谓语动词",
      "order": 3,
      "difficulty": 2,
      "blurb": "用 to do / doing / done 把动作嵌进句子里",
      "patterns": [
        { "id": "nonfinite-infinitive-object", "name": "不定式作宾语", "difficulty": 1 },
        { "id": "nonfinite-infinitive-attributive", "name": "不定式作定语", "difficulty": 2 },
        { "id": "nonfinite-bare-infinitive-complement", "name": "省 to 的不定式", "difficulty": 2 },
        { "id": "nonfinite-gerund-object", "name": "动名词作宾语", "difficulty": 1 },
        { "id": "nonfinite-participle-adverbial", "name": "分词作状语", "difficulty": 2 },
        { "id": "nonfinite-participle-waste-doing", "name": "waste … doing", "difficulty": 2 },
        { "id": "nonfinite-participle-attributive", "name": "分词作定语", "difficulty": 2 }
      ]
    },
    {
      "id": "relative",
      "name": "定语从句",
      "order": 4,
      "difficulty": 2,
      "blurb": "用从句给名词加一层说明",
      "patterns": [
        { "id": "relative-clause-who-which", "name": "who / which 引导", "difficulty": 1 },
        { "id": "relative-clause-that", "name": "that 引导", "difficulty": 1 },
        { "id": "relative-clause-whose", "name": "whose 引导", "difficulty": 2 },
        { "id": "relative-clause-where-when", "name": "where / when 引导", "difficulty": 2 },
        { "id": "relative-clause-nonrestrictive", "name": "非限制性定语从句", "difficulty": 3 }
      ]
    },
    {
      "id": "noun-clause",
      "name": "名词性从句",
      "order": 5,
      "difficulty": 2,
      "blurb": "让一整句话当主语、宾语或表语",
      "patterns": [
        { "id": "noun-clause-object", "name": "宾语从句", "difficulty": 1 },
        { "id": "noun-clause-subject", "name": "主语从句", "difficulty": 2 },
        { "id": "noun-clause-predicative", "name": "表语从句", "difficulty": 2 },
        { "id": "noun-clause-appositive", "name": "同位语从句", "difficulty": 3 }
      ]
    },
    {
      "id": "adverbial",
      "name": "状语从句",
      "order": 6,
      "difficulty": 2,
      "blurb": "说明时间、原因、条件、结果和让步",
      "patterns": [
        { "id": "adverbial-time", "name": "时间状语从句", "difficulty": 1 },
        { "id": "adverbial-reason", "name": "原因状语从句", "difficulty": 1 },
        { "id": "adverbial-condition", "name": "条件状语从句", "difficulty": 1 },
        { "id": "adverbial-concession", "name": "让步状语从句", "difficulty": 2 },
        { "id": "adverbial-result-purpose", "name": "结果 / 目的状语从句", "difficulty": 2 }
      ]
    },
    {
      "id": "modal",
      "name": "情态动词",
      "order": 7,
      "difficulty": 2,
      "blurb": "表达可能、必要、建议和推测",
      "patterns": [
        { "id": "modal-can-could", "name": "can / could", "difficulty": 1 },
        { "id": "modal-may-might", "name": "may / might", "difficulty": 1 },
        { "id": "modal-must-have-to", "name": "must / have to", "difficulty": 1 },
        { "id": "modal-should-ought", "name": "should / ought to", "difficulty": 1 },
        { "id": "modal-speculation", "name": "情态动词表推测", "difficulty": 2 }
      ]
    },
    {
      "id": "subjunctive",
      "name": "虚拟语气",
      "order": 8,
      "difficulty": 3,
      "blurb": "说假设、愿望和建议，而不是现实",
      "patterns": [
        { "id": "subjunctive-if-present", "name": "与现在事实相反", "difficulty": 2 },
        { "id": "subjunctive-if-past", "name": "与过去事实相反", "difficulty": 3 },
        { "id": "subjunctive-wish", "name": "wish 虚拟", "difficulty": 2 },
        { "id": "subjunctive-suggest", "name": "suggest / insist 等", "difficulty": 3 }
      ]
    },
    {
      "id": "inversion",
      "name": "倒装",
      "order": 9,
      "difficulty": 3,
      "blurb": "把语序倒过来，加强语气或衔接",
      "patterns": [
        { "id": "inversion-neg-front", "name": "否定词前置倒装", "difficulty": 3 },
        { "id": "inversion-so-neither", "name": "so / neither 倒装", "difficulty": 2 },
        { "id": "inversion-only", "name": "only 开头倒装", "difficulty": 3 },
        { "id": "inversion-here-there", "name": "here / there 倒装", "difficulty": 1 }
      ]
    },
    {
      "id": "emphasis",
      "name": "强调",
      "order": 10,
      "difficulty": 2,
      "blurb": "突出句子里最想让人听见的部分",
      "patterns": [
        { "id": "emphasis-it-cleft", "name": "It is … that / who …", "difficulty": 2 },
        { "id": "emphasis-what-cleft", "name": "What … is …", "difficulty": 2 },
        { "id": "emphasis-do", "name": "do / does / did 强调", "difficulty": 1 },
        { "id": "emphasis-own-very", "name": "own / very 等强调词", "difficulty": 1 }
      ]
    }
  ]
