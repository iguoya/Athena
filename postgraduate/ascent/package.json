{
  "name": "athena-ascent",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.15.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "content:ecdict": "node scripts/content/import-ecdict.mjs",
    "content:stages": "node scripts/content/make-stages.mjs",
    "content:tatoeba": "node --max-old-space-size=6144 scripts/content/import-tatoeba.mjs",
    "content:cet4": "node scripts/content/import-cet4-local.mjs",
    "content:textbook": "node scripts/content/import-textbook-local.mjs",
    "content:english2": "node scripts/content/import-english2.mjs",
    "content:check": "node scripts/content/check-sources.mjs"
  },
  "dependencies": {
    "@athena/app-update": "workspace:",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/noto-sans-sc": "catalog:",
    "@fontsource/sora": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@tauri-apps/api": "catalog:",
    "@tauri-apps/plugin-process": "catalog:",
    "@tauri-apps/plugin-updater": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "catalog:",
    "@tauri-apps/cli": "catalog:",
    "@types/node": "^26.6.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "^8.72.1",
    "vite": "catalog:",
    "vitest": "^5.0.5"
  }
