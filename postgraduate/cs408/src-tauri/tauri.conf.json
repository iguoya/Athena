{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "athena-cs408",
  "version": "10.1.0",
  "identifier": "cn.athena.cs408",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1503",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "408 计算机学科专业基础",
        "width": 1600,
        "height": 1000,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../content"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3NUQ0NjZDQzRFRDE0QTcKUldTbkZPM0ViRVpkdDNDcHdhZHdTS0N6dTZ2REp5Q2NjcTN6UzE4dzRqL3FLWHlOeFVjODFjNXgK",
      "endpoints": [
        "https://github.com/iguoya/Athena/releases/download/app-updates/cs408.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
