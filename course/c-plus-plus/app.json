{
  "id": "c-plus-plus",
  "title": "C++ 教程",
  "group": "程序设计",
  "description": "C++ 语言学习：教学大纲、学习页与可运行实验。侧栏可以运行 practice/cpp 里已经编好的旧窗口。",
  "icon": {
    "type": "theme",
    "name": "text-x-cpp-symbolic",
    "symbol": "chevron.left.forwardslash.chevron.right",
    "letter": "C++",
    "accent": "#00599C",
    "file": "icon.svg",
    "renders": {
      "icon.ico": "ico",
      "src-tauri/icons/32x32.png": 32,
      "src-tauri/icons/128x128.png": 128,
      "src-tauri/icons/128x128@2x.png": 256,
      "src-tauri/icons/icon.ico": "ico",
      "src-tauri/icons/icon.icns": "icns"
    }
  },
  "dev": {
    "env": {
      "ATHENA_APPS_ROOT": "${dir}/..",
      "ATHENA_CPP_ROOT": "${dir}"
    },
    "prepare": [
      {
        "when_missing": "node_modules",
        "run": ["pnpm", "install"],
        "label": "安装前端依赖"
      }
    ],
    "run": ["pnpm", "run", "tauri:dev"],
    "ready": { "http": "http://localhost:1512" },
    "match": "src-tauri/target",
    "binary": "athena-c-plus-plus"
  }
}
