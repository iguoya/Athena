{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "启动器",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/launcher/target/debug/athena-launcher",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "ATHENA_ROOT": "${workspaceFolder}"
            },
            "environment": [
                {
                    "name": "ATHENA_ROOT",
                    "value": "${workspaceFolder}"
                }
            ],
            "preLaunchTask": "Athena: Build launcher",
            "windows": {
                "program": "${workspaceFolder}/launcher/target/debug/athena-launcher.exe"
            },
            "osx": {
                "type": "lldb",
                "program": "${workspaceFolder}/launcher/target/debug/athena-launcher"
            },
            "linux": {
                "type": "cppdbg",
                "program": "${workspaceFolder}/launcher/target/debug/athena-launcher",
                "MIMode": "gdb",
                "miDebuggerPath": "/usr/bin/gdb"
            }
        }
    ]
}
