{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Athena（Ubuntu：构建并用 GDB 调试）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/builddir/Athena",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "Athena: Build"
        },
        {
            "name": "Athena（macOS：构建并用 LLDB 调试）",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/builddir/Athena",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Athena: Build"
        },
        {
            "name": "附加到 Athena",
            "type": "cppdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
