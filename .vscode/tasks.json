{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Athena: Configure",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "if [ \"$(uname -s)\" = Linux ]; then if [ -d build ]; then meson setup build --reconfigure --buildtype=debug -Dcpp_args=-I/usr/include/gtk-4.0; else meson setup build --buildtype=debug -Dcpp_args=-I/usr/include/gtk-4.0; fi; else if [ -d build ]; then meson setup build --reconfigure --buildtype=debug; else meson setup build --buildtype=debug; fi; fi"
            ],
            "options": {
                "cwd": "${workspaceFolder}/apps/cpp"
            },
            "problemMatcher": [],
            "detail": "配置 Debug 构建；Ubuntu 26.04 额外补齐 GTK4 头文件搜索路径"
        },
        {
            "label": "Athena: Build",
            "type": "shell",
            "command": "meson",
            "args": [
                "compile",
                "-C",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}/apps/cpp"
            },
            "dependsOn": "Athena: Configure",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "配置后增量编译 Athena"
        },
        {
            "label": "Athena: Check",
            "type": "shell",
            "command": "python3",
            "args": [
                "scripts/check.py",
                "--build-dir",
                "build",
                "--buildtype",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}/apps/cpp"
            },
            "dependsOn": "Athena: Configure",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": "test",
            "detail": "执行项目完整校验、构建与测试"
        },
        {
            "label": "Athena: Run",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "cargo build -q -p athena-dev --manifest-path launcher/Cargo.toml && launcher/target/debug/athena-dev open cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$gcc",
            "presentation": {
                "clear": true,
                "panel": "dedicated",
                "focus": true
            },
            "detail": "经编排器构建并启动 C++ 教程（ADR 0046）"
        }
    ]
}
