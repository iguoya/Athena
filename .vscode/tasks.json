{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Athena: Configure",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "if [ \"$(uname -s)\" = Linux ]; then if [ -d builddir ]; then meson setup builddir --reconfigure --buildtype=debug -Dcpp_args=-I/usr/include/gtk-4.0; else meson setup builddir --buildtype=debug -Dcpp_args=-I/usr/include/gtk-4.0; fi; else if [ -d builddir ]; then meson setup builddir --reconfigure --buildtype=debug; else meson setup builddir --buildtype=debug; fi; fi"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "detail": "配置 Debug 构建；Ubuntu 26.04 额外补齐 GTK4 头文件搜索路径"
        },
        {
            "label": "Athena: Build",
            "type": "shell",
            "command": "meson",
            "args": [
                "compile",
                "-C",
                "builddir"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Athena: Configure",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "配置后增量编译 Athena"
        },
        {
            "label": "Athena: Check",
            "type": "shell",
            "command": "scripts/check.sh",
            "args": [
                "--build-dir",
                "builddir",
                "--buildtype",
                "debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "Athena: Configure",
            "dependsOrder": "sequence",
            "problemMatcher": "$gcc",
            "group": "test",
            "detail": "执行项目完整校验、构建与测试"
        }
    ]
}
