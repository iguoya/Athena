{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Athena: Build launcher",
            "type": "process",
            "command": "cargo",
            "args": [
                "build",
                "--manifest-path",
                "launcher/Cargo.toml",
                "-p",
                "athena-launcher"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$rustc",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "增量编译跨平台启动器（托盘 + 列表窗口）"
        },
        {
            "label": "Athena: Check All",
            "type": "process",
            "command": "python3",
            "windows": {
                "command": "python"
            },
            "args": [
                "scripts/check.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "group": "test",
            "detail": "跨应用出处检查 + 每个应用自己的检查"
        }
    ]
}
