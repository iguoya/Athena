{
  "hooks": {
    "enabled": true,
    "events": {
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "args": ["${ZCODE_PROJECT_DIR}/comms/hooks/agent-notify.py", "--agent", "zcode"],
              "timeoutMs": 15000,
              "statusMessage": "检查 Athena 协作通讯未读"
            }
          ]
        }
      ],
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "process",
              "command": "python",
              "args": ["${ZCODE_PROJECT_DIR}/comms/hooks/agent-notify.py", "--agent", "zcode"],
              "timeoutMs": 15000,
              "statusMessage": "检查 Athena 协作通讯未读"
            }
          ]
        }
      ]
    }
  }
}
