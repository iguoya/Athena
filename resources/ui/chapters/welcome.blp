using Gtk 4.0;

ScrolledWindow welcome_page {
  hexpand: true;
  vexpand: true;
  hscrollbar-policy: never;
  vscrollbar-policy: automatic;

  Box welcome_container {
    orientation: vertical;
    spacing: 14;
    halign: center;
    valign: start;
    hexpand: true;
    vexpand: true;

    styles [
      "welcome-page"
    ]

    Box text_container {
      orientation: vertical;
      spacing: 10;
      halign: center;

      Label welcome_title {
        label: "C++ 学习之旅";

        styles [
          "title-1"
        ]
      }

      Label welcome_subtitle {
        label: "从零基础到高级特性，系统性学习 C++ 编程语言";
        wrap: true;
        justify: center;

        styles [
          "title-4",
          "dim-label"
        ]
      }
    }

    // 品牌主视觉
    Box icon_container {
      halign: center;

      styles [
        "hero-icon"
      ]

      Image welcome_icon {
        resource: "/app/icons/tiger.svg";
        pixel-size: 560;
        width-request: 560;
        height-request: 560;

        styles [
          "icon-dropshadow"
        ]
      }
    }

    // 学习路线在宽屏下横向展开，减少页面纵向堆叠。
    Box roadmap_preview {
      orientation: vertical;
      spacing: 16;
      width-request: 1244;

      styles [
        "section-card"
      ]

      Label {
        label: "学习路线预览";

        styles [
          "title-3"
        ]
      }

      Box roadmap_stages {
        orientation: horizontal;
        spacing: 14;
        homogeneous: true;

        Box {
          orientation: vertical;
          spacing: 8;
          hexpand: true;

          styles [
            "roadmap-stage"
          ]

          Image {
            icon-name: "input-keyboard-symbolic";
            pixel-size: 36;

            styles [
              "welcome-route-icon",
              "welcome-route-icon-blue"
            ]
          }

          Label {
            label: "基础入门";

            styles [
              "heading"
            ]
          }

          Label {
            label: "基础语法";
            wrap: true;
            justify: center;

            styles [
              "caption",
              "dim-label"
            ]
          }
        }

        Box {
          orientation: vertical;
          spacing: 8;
          hexpand: true;

          styles [
            "roadmap-stage"
          ]

          Image {
            icon-name: "applications-engineering-symbolic";
            pixel-size: 36;

            styles [
              "welcome-route-icon",
              "welcome-route-icon-purple"
            ]
          }

          Label {
            label: "面向对象";

            styles [
              "heading"
            ]
          }

          Label {
            label: "类对象、构造析构、继承与多态";
            wrap: true;
            justify: center;

            styles [
              "caption",
              "dim-label"
            ]
          }
        }

        Box {
          orientation: vertical;
          spacing: 8;
          hexpand: true;

          styles [
            "roadmap-stage"
          ]

          Image {
            icon-name: "view-grid-symbolic";
            pixel-size: 36;

            styles [
              "welcome-route-icon",
              "welcome-route-icon-green"
            ]
          }

          Label {
            label: "STL 标准库";

            styles [
              "heading"
            ]
          }

          Label {
            label: "容器、算法与迭代器使用";
            wrap: true;
            justify: center;

            styles [
              "caption",
              "dim-label"
            ]
          }
        }

        Box {
          orientation: vertical;
          spacing: 8;
          hexpand: true;

          styles [
            "roadmap-stage"
          ]

          Image {
            icon-name: "system-run-symbolic";
            pixel-size: 36;

            styles [
              "welcome-route-icon",
              "welcome-route-icon-orange"
            ]
          }

          Label {
            label: "现代 C++";

            styles [
              "heading"
            ]
          }

          Label {
            label: "RAII、智能指针、并发与新标准特性";
            wrap: true;
            justify: center;

            styles [
              "caption",
              "dim-label"
            ]
          }
        }

        Box {
          orientation: vertical;
          spacing: 8;
          hexpand: true;

          styles [
            "roadmap-stage"
          ]

          Image {
            icon-name: "folder-documents-symbolic";
            pixel-size: 36;

            styles [
              "welcome-route-icon",
              "welcome-route-icon-red"
            ]
          }

          Label {
            label: "项目实战";

            styles [
              "heading"
            ]
          }

          Label {
            label: "工程组织、构建测试与完整项目实践";
            wrap: true;
            justify: center;

            styles [
              "caption",
              "dim-label"
            ]
          }
        }
      }
    }

    // 概览与特色作为两个独立分组放在页面最下方。
    Box overview_row {
      orientation: horizontal;
      spacing: 24;
      halign: center;

      Box stats_section {
        orientation: vertical;
        spacing: 16;
        width-request: 500;

        styles [
          "section-card"
        ]

        Label {
          label: "学习概览";

          styles [
            "title-3"
          ]
        }

        Box stats_container {
          orientation: horizontal;
          spacing: 14;
          homogeneous: true;

          Box chapters_stat {
            orientation: vertical;
            spacing: 8;
            halign: center;
            hexpand: true;

            styles [
              "stat-card"
            ]

            Image {
              icon-name: "view-grid-symbolic";
              pixel-size: 48;
            }

            Label {
              label: "学习章节";

              styles [
                "heading"
              ]
            }

            Label {
              label: "61 个章节";

              styles [
                "caption",
                "dim-label"
              ]
            }
          }

          Box stages_stat {
            orientation: vertical;
            spacing: 8;
            halign: center;
            hexpand: true;

            styles [
              "stat-card"
            ]

            Image {
              icon-name: "view-list-symbolic";
              pixel-size: 48;
            }

            Label {
              label: "学习阶段";

              styles [
                "heading"
              ]
            }

            Label {
              label: "5 个阶段";

              styles [
                "caption",
                "dim-label"
              ]
            }
          }

          Box progress_stat {
            orientation: vertical;
            spacing: 8;
            halign: center;
            hexpand: true;

            styles [
              "stat-card"
            ]

            Image {
              icon-name: "task-due-symbolic";
              pixel-size: 48;
            }

            Label {
              label: "完成进度";

              styles [
                "heading"
              ]
            }

            Label {
              label: "0%";

              styles [
                "caption",
                "dim-label"
              ]
            }
          }
        }
      }

      Box features_section {
        orientation: vertical;
        spacing: 16;
        width-request: 720;

        styles [
          "section-card"
        ]

        Label {
          label: "学习特色";

          styles [
            "title-3"
          ]
        }

        Box features_grid {
          orientation: horizontal;
          spacing: 18;
          homogeneous: true;

          Box {
            orientation: vertical;
            spacing: 8;
            halign: center;
            hexpand: true;

            styles [
              "feature-card"
            ]

            Image {
              icon-name: "media-playback-start-symbolic";
              pixel-size: 48;
            }

            Label {
              label: "互动练习";

              styles [
                "heading"
              ]
            }

            Label {
              label: "边学边练，及时验证学习效果";
              wrap: true;
              justify: center;

              styles [
                "caption",
                "dim-label"
              ]
            }
          }

          Box {
            orientation: vertical;
            spacing: 8;
            halign: center;
            hexpand: true;

            styles [
              "feature-card"
            ]

            Image {
              icon-name: "text-x-generic-symbolic";
              pixel-size: 48;
            }

            Label {
              label: "代码示例";

              styles [
                "heading"
              ]
            }

            Label {
              label: "丰富的代码实例，直观理解概念";
              wrap: true;
              justify: center;

              styles [
                "caption",
                "dim-label"
              ]
            }
          }

          Box {
            orientation: vertical;
            spacing: 8;
            halign: center;
            hexpand: true;

            styles [
              "feature-card"
            ]

            Image {
              icon-name: "view-refresh-symbolic";
              pixel-size: 48;
            }

            Label {
              label: "循序渐进";

              styles [
                "heading"
              ]
            }

            Label {
              label: "从简单到复杂，逐步掌握 C++";
              wrap: true;
              justify: center;

              styles [
                "caption",
                "dim-label"
              ]
            }
          }
        }
      }
    }
  }
}
