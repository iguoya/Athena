using Gtk 4.0;
using GtkSource 5;

Box chapter_page {
  orientation: vertical;
  spacing: 14;
  hexpand: true;
  vexpand: true;
  margin-top: 16;
  margin-start: 20;
  margin-end: 20;
  margin-bottom: 18;

  // 紧凑章节导语：由 chapter.icon/title/description 驱动。
  Box chapter_header {
    orientation: horizontal;
    spacing: 14;

    Image chapter_icon {
      name: "chapter_icon";
      pixel-size: 34;
      valign: center;
    }

    Box {
      orientation: vertical;
      spacing: 3;
      hexpand: true;

      Label chapter_title_label {
        name: "chapter_title_label";
        halign: start;

        styles [
          "title-2"
        ]
      }

      Label chapter_description_label {
        name: "chapter_description_label";
        halign: start;
        wrap: true;
        xalign: 0;

        styles [
          "header-description"
        ]
      }
    }

    Button chapter_overview_button {
      name: "chapter_overview_button";
      label: "本章总纲";
      valign: center;
      tooltip-text: "把本章标题、简介与全部知识点组成总纲请求放入剪贴板，并唤起本机 AI 助手";

      styles [
        "btn-sm",
        "btn-chapter-overview"
      ]
    }
  }

  Separator {
    orientation: horizontal;
  }

  // 主体：左侧真实源码，右侧知识点和运行结果。
  Paned main_body {
    orientation: horizontal;
    position: 1040;
    wide-handle: true;
    resize-start-child: true;
    resize-end-child: true;
    shrink-start-child: false;
    shrink-end-child: false;
    hexpand: true;
    vexpand: true;

    Box source_panel {
      orientation: vertical;
      spacing: 8;
      width-request: 620;
      margin-end: 8;
      hexpand: true;
      vexpand: true;

      Frame source_frame {
        name: "source_frame";
        label: "源代码";
        hexpand: true;
        vexpand: true;

        styles [
          "panel-frame",
          "group-frame"
        ]

        ScrolledWindow {
          hexpand: true;
          vexpand: true;

          GtkSource.View source_view {
            name: "source_view";
            editable: false;
            cursor-visible: false;
            monospace: true;
            show-line-numbers: true;
            highlight-current-line: false;
            tab-width: 4;
            left-margin: 14;
            right-margin: 14;
            top-margin: 12;
            bottom-margin: 12;

            styles [
              "code-view"
            ]
          }
        }
      }
    }

    Paned right_side {
      orientation: vertical;
      position: 430;
      wide-handle: true;
      resize-start-child: true;
      resize-end-child: true;
      shrink-start-child: false;
      shrink-end-child: false;
      width-request: 460;
      margin-start: 8;
      vexpand: true;

      Box topics_panel {
          orientation: vertical;
          spacing: 8;
          height-request: 260;
          margin-bottom: 8;
          vexpand: true;

          Frame {
            name: "topics_frame";
            label: "本章知识点";
            hexpand: true;
            vexpand: true;

            styles [
              "panel-frame",
              "group-frame"
            ]

            ScrolledWindow {
              hscrollbar-policy: never;
              hexpand: true;
              vexpand: true;

              ListBox topics_list {
                name: "topics_list";
                selection-mode: none;
                show-separators: true;

                styles [
                  "topic-list"
                ]
              }
            }
          }
      }

      Box tools_and_result {
        orientation: vertical;
        spacing: 8;
        vexpand: true;

        Frame {
          name: "note_frame";
          label: "笔记";
          hexpand: true;

          styles [
            "panel-frame",
            "group-frame"
          ]

          ScrolledWindow {
            hscrollbar-policy: never;
            hexpand: true;
            height-request: 64;

            TextView note_view {
              name: "note_view";
              editable: true;
              cursor-visible: true;
              wrap-mode: word_char;
              sensitive: false;
              left-margin: 8;
              right-margin: 8;
              top-margin: 6;
              bottom-margin: 6;
            }
          }
        }

        Box result_panel {
          orientation: vertical;
          spacing: 8;
          height-request: 190;
          margin-top: 0;
          vexpand: true;

          Frame {
            name: "result_frame";
            label: "运行结果";
            hexpand: true;
            vexpand: true;

            styles [
              "panel-frame",
              "group-frame"
            ]

          ScrolledWindow {
            hexpand: true;
            vexpand: true;

            TextView result_view {
              name: "result_view";
              editable: false;
              cursor-visible: false;
              monospace: true;
              left-margin: 14;
              right-margin: 14;
              top-margin: 12;
              bottom-margin: 12;

              styles [
                "code-view"
              ]
            }
          }
        }
      }
      }
    }
  }

  // 底部状态栏：跨越整个章节页面，随选中的知识点更新。
  Frame {
    height-request: 58;
    hexpand: true;

    styles [
      "knowledge-status-bar"
    ]

    Box {
      orientation: horizontal;
      spacing: 14;
      margin-top: 8;
      margin-start: 16;
      margin-end: 16;
      margin-bottom: 8;

      Image {
        icon-name: "dialog-information-symbolic";
        pixel-size: 24;
        valign: center;

        styles [
          "knowledge-status-icon"
        ]
      }

      Label knowledge_description_label {
        name: "knowledge_description_label";
        label: "选择右侧知识点后，这里会显示对应的学习目标和实验提示。";
        halign: start;
        valign: center;
        hexpand: true;
        wrap: true;
        wrap-mode: word_char;
        xalign: 0;

        styles [
          "knowledge-status-text"
        ]
      }

      Spinner experiment_spinner {
        name: "experiment_spinner";
        visible: false;
        valign: center;
      }

      Label experiment_status_label {
        name: "experiment_status_label";
        visible: false;
        valign: center;
        xalign: 1.0;

        styles [
          "experiment-status-text"
        ]
      }
    }
  }
}
