using Gtk 4.0;

ScrolledWindow chapter_page {
  hexpand: true;
  vexpand: true;

  Box {
    orientation: vertical;
    spacing: 16;
    hexpand: true;
    vexpand: true;
    margin-top: 24;
    margin-start: 32;
    margin-end: 32;
    margin-bottom: 24;

    Label chapter_title_label {
      name: "chapter_title_label";
      halign: start;

      styles [
        "title-1"
      ]
    }

    // 主体：左源码 + 右知识点/结果（约 3:1）
    Box main_body {
      orientation: horizontal;
      spacing: 16;
      hexpand: true;
      vexpand: true;

      // 左：源代码（约 3 份宽）
      Box source_side {
        orientation: vertical;
        spacing: 8;
        hexpand: true;
        vexpand: true;

        Box {
          orientation: horizontal;
          spacing: 12;

          Label {
            label: "源代码";
            halign: start;
            hexpand: true;

            styles [
              "heading"
            ]
          }

          Button run_button {
            name: "run_button";
            label: "▶ 运行";

            styles [
              "suggested-action",
              "pill"
            ]
          }
        }

        ScrolledWindow {
          hexpand: true;
          vexpand: true;

          TextView source_view {
            name: "source_view";
            editable: false;
            monospace: true;
          }
        }
      }

      // 右：知识点 + 结果（约 1 份宽）
      Box right_side {
        orientation: vertical;
        spacing: 8;
        width-request: 420;
        vexpand: true;

        // 上：本章知识点（约 1 份高）
        Label topics_label {
          name: "topics_label";
          label: "本章知识点";
          halign: start;

          styles [
            "heading"
          ]
        }

        ScrolledWindow {
          vexpand: false;

          ListBox topics_list {
            name: "topics_list";
            selection-mode: none;
          }
        }

        // 下：运行结果（约 3 份高）
        Label {
          label: "运行结果";
          halign: start;

          styles [
            "heading"
          ]
        }

        ScrolledWindow {
          hexpand: true;
          vexpand: true;

          TextView result_view {
            name: "result_view";
            editable: false;
            monospace: true;
          }
        }
      }
    }
  }
}
