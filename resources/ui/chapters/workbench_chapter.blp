using Gtk 4.0;

// 文档主导的学习工作台。正文实验入口打开进程内唯一的非模态实验窗口；
// 页面本身不再保留一份内嵌实验坞。
Box workbench_chapter_page {
  orientation: vertical;
  spacing: 10;
  hexpand: true;
  vexpand: true;
  margin-top: 16;
  margin-start: 20;
  margin-end: 20;
  margin-bottom: 18;

  Frame workbench_header_frame {
    hexpand: true;

    styles [
      "panel-frame"
    ]

    Box {
      orientation: horizontal;
      spacing: 14;
      margin-top: 10;
      margin-bottom: 10;
      margin-start: 14;
      margin-end: 14;

      Image workbench_chapter_icon {
        name: "workbench_chapter_icon";
        pixel-size: 34;
        valign: center;
      }

      Box {
        orientation: vertical;
        spacing: 3;
        hexpand: true;
        valign: center;

        Label workbench_chapter_title_label {
          name: "workbench_chapter_title_label";
          halign: start;

          styles [
            "title-2"
          ]
        }

        Label workbench_chapter_description_label {
          name: "workbench_chapter_description_label";
          halign: start;
          wrap: true;
          xalign: 0;

          styles [
            "header-description"
          ]
        }
      }
    }
  }

  Separator {
    orientation: horizontal;
  }

  Box {
    orientation: vertical;
    hexpand: true;
    vexpand: true;

    styles [
      "article-page"
    ]

    Frame workbench_article_frame {
      hexpand: true;
      vexpand: true;
      label: "学习文档";

      styles [
        "panel-frame",
        "group-frame",
        "article-surface"
      ]

      DrawingArea workbench_article_host {
        name: "workbench_article_host";
        hexpand: true;
        vexpand: true;
      }
    }
  }
}
