using Gtk 4.0;

// 文档主导的学习工作台。顶层标签按 Markdown H2 学习小节拆分；每页内部
// 仍是连续的正文、预测与实验入口流，避免把同一概念按函数机械拆散。
Box workbench_chapter_page {
  orientation: vertical;
  spacing: 10;
  hexpand: true;
  vexpand: true;
  margin-top: 16;
  margin-start: 20;
  margin-end: 20;
  margin-bottom: 18;

  Frame workbench_header_frame {
    hexpand: true;

    styles [
      "panel-frame"
    ]

    Box {
      orientation: horizontal;
      spacing: 14;
      margin-top: 10;
      margin-bottom: 10;
      margin-start: 14;
      margin-end: 14;

      Image workbench_chapter_icon {
        name: "workbench_chapter_icon";
        pixel-size: 34;
        valign: center;
      }

      Box {
        orientation: vertical;
        spacing: 3;
        hexpand: true;
        valign: center;

        Label workbench_chapter_title_label {
          name: "workbench_chapter_title_label";
          halign: start;

          styles [
            "title-2"
          ]
        }

        Label workbench_chapter_description_label {
          name: "workbench_chapter_description_label";
          halign: start;
          wrap: true;
          xalign: 0;

          styles [
            "header-description"
          ]
        }
      }
    }
  }

  Separator {
    orientation: horizontal;
  }

  Box {
    orientation: vertical;
    hexpand: true;
    vexpand: true;

    styles [
      "article-page"
    ]

    Notebook workbench_section_notebook {
      name: "workbench_section_notebook";
      hexpand: true;
      vexpand: true;
      scrollable: true;

      styles [
        "workbench-section-notebook"
      ]
    }
  }
}
