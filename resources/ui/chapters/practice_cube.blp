using Gtk 4.0;

// “应用实践”类章节专属布局，不套用标准教学页（chapter_page）那套
// “知识点列表 + 源码框 + 结果区”三栏结构——实践类内容形态还没定，
// 先只保留标题/简介/本章总纲这三个跟其它章节一致的通用部分，加一个
// “运行”按钮和一块结果显示区；具体界面以后再细化。
Box practice_cube_page {
  orientation: vertical;
  spacing: 14;
  hexpand: true;
  vexpand: true;
  margin-top: 16;
  margin-start: 20;
  margin-end: 20;
  margin-bottom: 18;

  Frame chapter_header_frame {
    hexpand: true;

    styles [
      "panel-frame"
    ]

    Box chapter_header {
      orientation: horizontal;
      spacing: 14;
      margin-top: 10;
      margin-bottom: 10;
      margin-start: 14;
      margin-end: 14;

      Image chapter_icon {
        name: "chapter_icon";
        pixel-size: 34;
        valign: center;
      }

      Box {
        orientation: vertical;
        spacing: 3;
        hexpand: true;
        valign: center;

        Label chapter_title_label {
          name: "chapter_title_label";
          halign: start;

          styles [
            "title-2"
          ]
        }

        Label chapter_description_label {
          name: "chapter_description_label";
          halign: start;
          wrap: true;
          xalign: 0;

          styles [
            "header-description"
          ]
        }
      }

      Button chapter_overview_button {
        name: "chapter_overview_button";
        label: "本章总纲";
        valign: center;
        tooltip-text: "把本章标题、简介与全部知识点组成总纲请求放入剪贴板，并唤起本机 AI 助手";

        styles [
          "btn-sm",
          "btn-chapter-overview"
        ]
      }
    }
  }

  Separator {
    orientation: horizontal;
  }

  // 主体分左右两栏：左边运行按钮 + 输出框，右边状态标签 + 3D 绘图
  // 区域。绘图区域现在只画一个占位的等距视角魔方示意图（固定配色），
  // 没有跟真实魔方状态联动——状态表示方案还没定。
  Box practice_body {
    orientation: horizontal;
    spacing: 14;
    hexpand: true;
    vexpand: true;

    Box practice_left_panel {
      orientation: vertical;
      spacing: 10;
      hexpand: true;
      vexpand: true;

      Box {
        orientation: horizontal;
        spacing: 10;

        Button practice_run_button {
          name: "practice_run_button";
          label: "运行";

          styles [
            "btn-sm",
            "btn-primary"
          ]
        }
      }

      ScrolledWindow {
        hexpand: true;
        vexpand: true;
        hscrollbar-policy: never;

        styles [
          "panel-frame"
        ]

        TextView practice_result_view {
          name: "practice_result_view";
          editable: false;
          cursor-visible: false;
          wrap-mode: word_char;
          top-margin: 10;
          bottom-margin: 10;
          left-margin: 12;
          right-margin: 12;

          styles [
            "code-view"
          ]
        }
      }
    }

    Box practice_right_panel {
      orientation: vertical;
      spacing: 10;
      hexpand: true;
      vexpand: true;

      Label practice_status_label {
        name: "practice_status_label";
        label: "就绪";
        halign: start;
        wrap: true;
        xalign: 0;

        styles [
          "dim-label"
        ]
      }

      Frame {
        hexpand: true;
        vexpand: true;

        styles [
          "panel-frame"
        ]

        // 空容器，实际的绘图控件（render/cube_view.h 的
        // make_cube_isometric_view()）在 C++ 侧动态创建后塞进来，
        // 跟“结构在 Blueprint、内容在 C++”的一贯分工一致。
        Box practice_cube_canvas_host {
          name: "practice_cube_canvas_host";
          orientation: vertical;
          hexpand: true;
          vexpand: true;
          halign: center;
          valign: center;
        }
      }
    }
  }
}
