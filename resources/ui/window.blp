using Gtk 4.0;

ApplicationWindow window {
  title: "Athena - C++ 学习指南";
  default-width: 1920;
  default-height: 1080;

  Box main_container {
    orientation: horizontal;

    // === 左侧分类导航 ===
    Box category_sidebar {
      name: "category_sidebar";
      orientation: vertical;
      width-request: 80;
      spacing: 0;
    }

    Separator {
      orientation: vertical;
    }

    // === 右侧主区域 ===
    Box content_area {
      name: "content_area";
      orientation: vertical;
      hexpand: true;

      // 章节标签栏（FlowBox 自动换行）
      ScrolledWindow tab_scroll {
        hscrollbar-policy: never;
        vscrollbar-policy: never;
        vexpand: false;

        FlowBox chapter_tab_box {
          name: "chapter_tab_box";
          selection-mode: none;
          max-children-per-line: 100;
          homogeneous: false;
          column-spacing: 6;
          row-spacing: 6;
          margin-start: 8;
          margin-end: 8;
          margin-top: 6;
          margin-bottom: 6;
        }
      }

      Separator {
        orientation: horizontal;
      }

      // 章节内容栈
      Stack chapter_stack {
        name: "chapter_stack";
        transition-type: crossfade;
        hexpand: true;
        vexpand: true;
      }
    }
  }
}
