using Gtk 4.0;

// 首页：一级大类的入口。FlowBox 按宽度自适应换行，不强行凑满一个固定
// 宫格数——分类数量以后增加或减少时无需改版式。
Box home_page {
  name: "home_page";
  orientation: vertical;
  vexpand: true;

  styles [
    "app-content"
  ]

  ScrolledWindow {
    hscrollbar-policy: never;
    vexpand: true;

    Box {
      orientation: vertical;
      spacing: 0;

      // C++ 学习路线预览：进入具体分类前的一条全局印象条，五个阶段只说明
      // 学习的大致顺序，真正的入口仍是下方按 athena.json 生成的分类网格。
      Box home_roadmap {
        name: "home_roadmap";
        orientation: vertical;
        spacing: 14;
        halign: center;
        margin-top: 48;
        margin-bottom: 12;
        margin-start: 40;
        margin-end: 40;

        styles [
          "roadmap-card"
        ]

        Label {
          label: "C++ 学习路线";
          halign: start;

          styles [
            "title-4"
          ]
        }

        Box {
          orientation: horizontal;
          spacing: 12;
          homogeneous: true;

          Box {
            orientation: vertical;
            spacing: 6;
            hexpand: true;

            styles [
              "roadmap-stage"
            ]

            Image {
              icon-name: "input-keyboard-symbolic";
              pixel-size: 32;

              styles [
                "route-icon-blue"
              ]
            }

            Label {
              label: "基础入门";
              halign: start;

              styles [
                "heading"
              ]
            }

            Label {
              label: "基础语法与流程控制";
              wrap: true;
              xalign: 0;

              styles [
                "caption",
                "dim-label"
              ]
            }
          }

          Box {
            orientation: vertical;
            spacing: 6;
            hexpand: true;

            styles [
              "roadmap-stage"
            ]

            Image {
              icon-name: "applications-engineering-symbolic";
              pixel-size: 32;

              styles [
                "route-icon-purple"
              ]
            }

            Label {
              label: "面向对象";
              halign: start;

              styles [
                "heading"
              ]
            }

            Label {
              label: "类对象、构造析构、继承与多态";
              wrap: true;
              xalign: 0;

              styles [
                "caption",
                "dim-label"
              ]
            }
          }

          Box {
            orientation: vertical;
            spacing: 6;
            hexpand: true;

            styles [
              "roadmap-stage"
            ]

            Image {
              icon-name: "view-grid-symbolic";
              pixel-size: 32;

              styles [
                "route-icon-green"
              ]
            }

            Label {
              label: "STL 标准库";
              halign: start;

              styles [
                "heading"
              ]
            }

            Label {
              label: "容器、算法与迭代器使用";
              wrap: true;
              xalign: 0;

              styles [
                "caption",
                "dim-label"
              ]
            }
          }

          Box {
            orientation: vertical;
            spacing: 6;
            hexpand: true;

            styles [
              "roadmap-stage"
            ]

            Image {
              icon-name: "system-run-symbolic";
              pixel-size: 32;

              styles [
                "route-icon-orange"
              ]
            }

            Label {
              label: "现代 C++";
              halign: start;

              styles [
                "heading"
              ]
            }

            Label {
              label: "RAII、智能指针、并发与新标准特性";
              wrap: true;
              xalign: 0;

              styles [
                "caption",
                "dim-label"
              ]
            }
          }

          Box {
            orientation: vertical;
            spacing: 6;
            hexpand: true;

            styles [
              "roadmap-stage"
            ]

            Image {
              icon-name: "folder-documents-symbolic";
              pixel-size: 32;

              styles [
                "route-icon-red"
              ]
            }

            Label {
              label: "项目实战";
              halign: start;

              styles [
                "heading"
              ]
            }

            Label {
              label: "工程组织、构建测试与完整项目实践";
              wrap: true;
              xalign: 0;

              styles [
                "caption",
                "dim-label"
              ]
            }
          }
        }
      }

      // 分类按钮由 MainWindow 根据 athena.json 动态追加。
      FlowBox home_grid {
        name: "home_grid";
        orientation: horizontal;
        selection-mode: none;
        homogeneous: true;
        min-children-per-line: 2;
        max-children-per-line: 4;
        row-spacing: 28;
        column-spacing: 28;
        valign: start;
        halign: center;
        margin-top: 24;
        margin-bottom: 56;
        margin-start: 40;
        margin-end: 40;
      }
    }
  }
}

// 某一分类内部：只有章节内容栈。进入分类默认落在生成的索引页（章节网格），
// 章节之间的横向切换由顶栏的章节切换器承担，不再有常驻标签条（见 ADR 0021）。
// 分类切换只影响这里，首页布局与它互不干扰——两者是 root_stack 里并列的两页。
Box content_area {
  name: "content_area";
  orientation: vertical;
  vexpand: true;

  styles [
    "app-content"
  ]

  Stack chapter_stack {
    name: "chapter_stack";
    transition-type: crossfade;
    hexpand: true;
    vexpand: true;
  }
}

ApplicationWindow window {
  title: "Athena - C++ 学习指南";
  default-width: 1920;
  default-height: 1080;

  styles [
    "athena-window"
  ]

  Box main_container {
    orientation: vertical;

    // === 顶栏：应用菜单、返回首页、当前位置 ===
    Box top_bar {
      name: "top_bar";
      orientation: horizontal;
      spacing: 4;

      styles [
        "app-topbar"
      ]

      // macOS 上系统标准菜单栏已经接管同一份菜单模型，这里保持隐藏；
      // 其他平台没有这层系统集成，MainWindow 在此显示它并绑定菜单。
      PopoverMenuBar app_menu_bar {
        name: "app_menu_bar";
        visible: false;
      }

      Button home_button {
        name: "home_button";
        tooltip-text: "返回首页";

        styles [
          "flat",
          "home-button"
        ]

        Box {
          orientation: horizontal;
          spacing: 8;
          valign: center;

          Image {
            icon-name: "go-home-symbolic";
            pixel-size: 18;
          }

          Label {
            label: "首页";
          }
        }
      }

      // 当前位置：MainWindow 按层级填充。分类名是一个 breadcrumb-link
      // 按钮（点回本分类索引页），其余层级是纯文本 Label。
      Box breadcrumb_box {
        name: "breadcrumb_box";
        orientation: horizontal;
        spacing: 6;
        halign: start;
        hexpand: true;
        valign: center;

        styles [
          "breadcrumb"
        ]
      }

      // 章节切换器：进入分类后显示，弹出层列出目录 + 本分类各章 + 学习工具。
      // 只在分类页可见，首页隐藏。内容由 MainWindow 按当前分类重建。
      MenuButton chapter_switcher {
        name: "chapter_switcher";
        visible: false;
        tooltip-text: "切换章节";

        styles [
          "flat"
        ]
      }
    }

    Separator {
      orientation: horizontal;
    }

    // 首页 / 分类内容二选一；MainWindow 运行时把 home_page 和
    // content_area 加进来，两个页面各自的内部结构与这里无关。
    Stack root_stack {
      name: "root_stack";
      transition-type: crossfade;
      vexpand: true;
    }
  }
}
