using Gtk 4.0;

ApplicationWindow window {
  title: "Athena - C++ 学习指南";
  default-width: 1920;
  default-height: 1080;

  styles [
    "athena-window"
  ]

  Box main_container {
    orientation: horizontal;

    // === 左侧导航 ===
    Box sidebar {
      orientation: vertical;
      width-request: 108;
      spacing: 0;

      styles [
        "app-sidebar"
      ]

      // 分类按钮由 MainWindow 根据 athena.json 动态追加。
      Box category_sidebar {
        name: "category_sidebar";
        orientation: vertical;
        spacing: 0;
        vexpand: true;
      }

      Separator {
        orientation: horizontal;
      }

      Button settings_button {
        name: "settings_button";
        tooltip-text: "配置 AI 服务商等应用设置";

        styles [
          "nav-button"
        ]

        Box {
          orientation: vertical;
          spacing: 4;
          valign: center;
          margin-top: 10;
          margin-bottom: 10;

          Image {
            icon-name: "preferences-system-symbolic";
            pixel-size: 22;
          }

          Label {
            label: "设置";
          }
        }
      }

      Button about_button {
        name: "about_button";
        tooltip-text: "关于 Athena";

        styles [
          "nav-button"
        ]

        Box {
          orientation: vertical;
          spacing: 4;
          valign: center;
          margin-top: 10;
          margin-bottom: 10;

          Image {
            icon-name: "help-about-symbolic";
            pixel-size: 22;
          }

          Label {
            label: "关于";
          }
        }
      }
    }

    Separator {
      orientation: vertical;
    }

    // === 右侧主区域 ===
    Box content_area {
      name: "content_area";
      orientation: vertical;
      hexpand: true;

      styles [
        "app-content"
      ]

      // 章节标签栏（FlowBox 自动换行）
      ScrolledWindow tab_scroll {
        hscrollbar-policy: never;
        vscrollbar-policy: never;
        vexpand: false;

        styles [
          "tab-bar"
        ]

        FlowBox chapter_tab_box {
          name: "chapter_tab_box";
          selection-mode: none;
          max-children-per-line: 100;
          homogeneous: false;
          column-spacing: 6;
          row-spacing: 6;
          margin-start: 8;
          margin-end: 8;
          margin-top: 6;
          margin-bottom: 6;
        }
      }

      Separator {
        orientation: horizontal;
      }

      // 章节内容栈
      Stack chapter_stack {
        name: "chapter_stack";
        transition-type: crossfade;
        hexpand: true;
        vexpand: true;
      }
    }
  }
}
