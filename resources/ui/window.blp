using Gtk 4.0;

// 首页：按计算机专业学习脉络铺开的学科知识图谱，取代旧的九宫格入口。
// MainWindow 运行时把 render/domain_graph_view 生成的视图挂进 home_graph。
Box home_page {
  name: "home_page";
  orientation: vertical;
  vexpand: true;

  styles [
    "app-content"
  ]

    // 学科图谱的两张图是固定宽度、不压缩的，窄窗口时整页横向滚动查看。
  ScrolledWindow {
    hscrollbar-policy: automatic;
    vexpand: true;

    Box home_graph {
      name: "home_graph";
      orientation: vertical;
      valign: start;
      halign: start;
      margin-top: 40;
      margin-bottom: 56;
      margin-start: 40;
      margin-end: 40;
    }
  }
}

// 某一分类内部：只有章节内容栈。进入分类默认落在生成的索引页（章节网格），
// 章节之间的横向切换由顶栏的章节切换器承担，不再有常驻标签条（见 ADR 0021）。
// 分类切换只影响这里，首页布局与它互不干扰——两者是 root_stack 里并列的两页。
Box content_area {
  name: "content_area";
  orientation: vertical;
  vexpand: true;

  styles [
    "app-content"
  ]

  Stack chapter_stack {
    name: "chapter_stack";
    transition-type: crossfade;
    hexpand: true;
    vexpand: true;
  }
}

ApplicationWindow window {
  title: "计算机与电子信息学习实验室";
  default-width: 2160;
  default-height: 1440;

  styles [
    "athena-window"
  ]

  Box main_container {
    orientation: vertical;

    // === 顶栏：应用菜单、返回首页、当前位置 ===
    Box top_bar {
      name: "top_bar";
      orientation: horizontal;
      spacing: 4;

      styles [
        "app-topbar"
      ]

      // macOS 上系统标准菜单栏已经接管同一份菜单模型，这里保持隐藏；
      // 其他平台没有这层系统集成，MainWindow 在此显示它并绑定菜单。
      PopoverMenuBar app_menu_bar {
        name: "app_menu_bar";
        visible: false;
      }

      Button home_button {
        name: "home_button";
        tooltip-text: "返回首页";

        styles [
          "flat",
          "home-button"
        ]

        Box {
          orientation: horizontal;
          spacing: 8;
          valign: center;

          Image {
            icon-name: "go-home-symbolic";
            pixel-size: 18;
          }

          Label {
            label: "首页";
          }
        }
      }

      // 当前位置：MainWindow 按层级填充。分类名是一个 breadcrumb-link
      // 按钮（点回本分类索引页），其余层级是纯文本 Label。
      Box breadcrumb_box {
        name: "breadcrumb_box";
        orientation: horizontal;
        spacing: 6;
        halign: start;
        hexpand: true;
        valign: center;

        styles [
          "breadcrumb"
        ]
      }

      // 章节切换器：进入分类后显示，弹出层列出目录 + 本分类各章 + 学习工具。
      // 只在分类页可见，首页隐藏。内容由 MainWindow 按当前分类重建。
      MenuButton chapter_switcher {
        name: "chapter_switcher";
        visible: false;
        tooltip-text: "切换章节";

        styles [
          "flat"
        ]
      }
    }

    Separator {
      orientation: horizontal;
    }

    // 首页 / 分类内容二选一；MainWindow 运行时把 home_page 和
    // content_area 加进来，两个页面各自的内部结构与这里无关。
    Stack root_stack {
      name: "root_stack";
      transition-type: crossfade;
      vexpand: true;
    }
  }
}
