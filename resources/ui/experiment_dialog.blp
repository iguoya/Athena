using Gtk 4.0;
using GtkSource 5;

// ADR 0023 阶段一：模态实验窗口先改成纵向证据链——当前目标、真实源码、
// 运行操作、观察结果。它仍是过渡窗口；后续再迁入主窗口的专注实验页。
Window experiment_dialog_window {
  title: "Athena · 实验台";
  default-width: 1120;
  default-height: 820;

  styles [
    "athena-window"
  ]

  Box {
    orientation: vertical;
    spacing: 12;
    margin-top: 16;
    margin-bottom: 16;
    margin-start: 16;
    margin-end: 16;

    Frame {
      hexpand: true;

      styles [
        "panel-frame",
        "group-frame"
      ]

      Box {
        orientation: vertical;
        spacing: 8;
        margin-top: 12;
        margin-bottom: 12;
        margin-start: 14;
        margin-end: 14;

        Label experiment_title_label {
          name: "experiment_title_label";
          halign: start;
          wrap: true;
          xalign: 0;

          styles [
            "title-3"
          ]
        }

        Label experiment_objective_label {
          name: "experiment_objective_label";
          halign: start;
          wrap: true;
          wrap-mode: word_char;
          xalign: 0;

          styles [
            "dim-label"
          ]
        }
      }
    }

    Paned experiment_flow_paned {
      name: "experiment_flow_paned";
      orientation: vertical;
      position: 470;
      wide-handle: true;
      resize-start-child: true;
      resize-end-child: true;
      shrink-start-child: false;
      shrink-end-child: false;
      hexpand: true;
      vexpand: true;

      Frame {
        label: "真实源码";
        height-request: 320;
        hexpand: true;
        vexpand: true;

        styles [
          "panel-frame",
          "group-frame"
        ]

        ScrolledWindow {
          hexpand: true;
          vexpand: true;

          GtkSource.View experiment_source_view {
            name: "experiment_source_view";
            editable: false;
            cursor-visible: false;
            monospace: true;
            show-line-numbers: true;
            highlight-current-line: false;
            tab-width: 4;
            left-margin: 14;
            right-margin: 14;
            top-margin: 12;
            bottom-margin: 12;

            styles [
              "code-view"
            ]
          }
        }
      }

      Box {
        orientation: vertical;
        spacing: 10;
        margin-top: 10;
        hexpand: true;
        vexpand: true;

        Box {
          orientation: horizontal;
          spacing: 8;

          Spinner experiment_spinner {
            name: "experiment_spinner";
            visible: false;
            valign: center;
          }

          Label experiment_status_label {
            name: "experiment_status_label";
            visible: false;
            halign: start;
            valign: center;
            hexpand: true;

            styles [
              "dim-label"
            ]
          }

          Button experiment_run_button {
            name: "experiment_run_button";
            label: "▶ 运行验证";
            halign: end;

            styles [
              "btn-sm",
              "btn-primary"
            ]
          }
        }

        Frame {
          label: "观察结果";
          height-request: 190;
          hexpand: true;
          vexpand: true;

          styles [
            "panel-frame",
            "group-frame"
          ]

          ScrolledWindow {
            hexpand: true;
            vexpand: true;

            TextView experiment_result_view {
              name: "experiment_result_view";
              editable: false;
              cursor-visible: false;
              monospace: true;
              wrap-mode: word_char;
              left-margin: 14;
              right-margin: 14;
              top-margin: 12;
              bottom-margin: 12;

              styles [
                "code-view"
              ]
            }
          }
        }
      }
    }
  }
}
