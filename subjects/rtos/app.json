{
  "id": "rtos",
  "title": "实时操作系统（RTOS）",
  "group": "实时操作系统",
  "parent": "embedded",
  "description": "嵌入式系统设计师第 4 章的实践课程：FreeRTOS 任务/抢占真板观测、QEMU 交叉编译全流程、线程级调度模拟。按 ADR 0106 从 embedded 独立成挂靠子应用，可单独使用。",
  "icon": {
    "type": "theme",
    "name": "rtos-symbolic",
    "symbol": "arrow.trianglehead.branch",
    "letter": "实",
    "accent": "#8A125A",
    "file": "icon.svg",
    "renders": {
      "src-tauri/icons/32x32.png": 32,
      "src-tauri/icons/128x128.png": 128,
      "src-tauri/icons/128x128@2x.png": 256,
      "src-tauri/icons/icon.png": 512,
      "src-tauri/icons/icon.ico": "ico",
      "src-tauri/icons/icon.icns": "icns"
    }
  },
  "dev": {
    "prepare": [
      {
        "when_missing": "node_modules",
        "run": ["npm", "install"],
        "label": "安装前端依赖"
      }
    ],
    "run": ["npm", "run", "tauri:dev"],
    "ready": { "http": "http://localhost:1496" },
    "match": "src-tauri/target",
    "binary": "athena-rtos"
  }
}
