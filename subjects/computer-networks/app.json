{
  "id": "network",
  "title": "网络与信息安全",
  "group": "网络",
  "parent": "software",
  "description": "软考软件设计师第 10 章的实践课程：socket 真收发、子网计算、加密真算。按 ADR 0103 从 software 独立成挂靠子应用，可单独使用。",
  "icon": {
    "type": "theme",
    "name": "network-symbolic",
    "symbol": "network",
    "letter": "网",
    "accent": "#B03A2E",
    "file": "icon.svg",
    "renders": {
      "src-tauri/icons/32x32.png": 32,
      "src-tauri/icons/128x128.png": 128,
      "src-tauri/icons/128x128@2x.png": 256,
      "src-tauri/icons/icon.png": 512,
      "src-tauri/icons/icon.ico": "ico",
      "src-tauri/icons/icon.icns": "icns"
    }
  },
  "dev": {
    "prepare": [
      {
        "when_missing": "node_modules",
        "run": ["npm", "install"],
        "label": "安装前端依赖"
      }
    ],
    "run": ["npm", "run", "tauri:dev"],
    "ready": { "http": "http://localhost:1493" },
    "match": "src-tauri/target",
    "binary": "athena-network"
  }
}
