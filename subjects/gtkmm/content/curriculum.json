      "knowledge_points": [
        {
          "id": "gtkmm.buttons.push-button",
          "title": "clicked：按钮与信号",
          "type": "concept",
          "difficulty": 1,
          "mastery_goal": "required",
          "requires": [],
          "blocks": [
            {
              "type": "text",
              "text": "Gtk::Button 是最常用的交互控件：显示一个标签或图标，用户按下并释放后发出 clicked 信号，连接到该信号的处理器随即被调用。"
            },
            {
              "type": "code",
              "lang": "cpp",
              "caption": "Gtk::Button 常用设置与信号连接（语义基准：docs.gtk.org/gtk4/class.Button.html）",
              "source": "auto button = Gtk::Button();\nbutton.set_label(\"点击我（_C）\");      // 下划线助记符：Alt+C 触发\nbutton.set_use_underline(true);\nbutton.set_icon_name(\"document-save\"); // 或只显示图标\nbutton.signal_clicked().connect([] {\n  // 处理器：点击后执行\n});"
            },
            {
              "type": "callout",
              "variant": "tip",
              "text": "助记符只在 set_use_underline(true) 时生效：标签里的 _C 表示 Alt+C，按钮显示时下划线出现在 C 下面。"
            },
            {
              "type": "simulation",
              "sim": "signal-flow",
              "demo_ref": "demo.buttons",
              "note": "模型简化：真实 GTK 由 GDK 事件分发到 main loop，此处省略事件队列与捕获阶段。"
            },
            {
              "type": "demo",
              "demo_ref": "demo.buttons"
            },
            {
              "type": "quiz",
              "id": "q1",
              "stem": "Gtk::Button 的 clicked 信号在什么时刻发出？",
              "options": [
                "按下鼠标键时",
                "按下并释放之后",
                "释放鼠标且光标已移出按钮时",
                "调用 set_sensitive(true) 时"
              ],
              "answer": 1,
              "source_refs": [
                {
                  "relation": "adapted",
                  "url": "https://docs.gtk.org/gtk4/signal.Button.clicked.html",
                  "note": "语义基准（应用 ADR 0002）"
                }
              ],
              "page_ref": "sec-pushbuttons"
            },
            {
              "type": "experiment",
              "demo_ref": "exp.buttons"
            },
            {
              "type": "quiz",
              "id": "q-icon",
              "page_ref": "sec-pushbuttons",
              "stem": "让按钮只显示一个图标（不显示文字），应使用哪个方法？",
              "options": [
                "set_image()",
                "set_icon_name()",
                "set_label_icon()",
                "add_icon()"
              ],
              "answer": 1,
              "source_refs": [
                {
                  "relation": "adapted",
                  "url": "https://docs.gtk.org/gtk4/method.Button.set_icon_name.html",
                  "note": "语义基准（应用 ADR 0002）"
                }
              ]
            },
            {
              "type": "quiz",
              "id": "q-sensitive",
              "page_ref": "sec-pushbuttons",
              "stem": "按钮处于不可点击状态（点击无响应）最可能是因为？",
              "options": [
                "没有设置图标",
                "调用了 set_sensitive(false)",
                "没有设置标题",
                "未调用 set_use_underline(true)"
              ],
              "answer": 1,
              "source_refs": [
                {
                  "relation": "adapted",
                  "url": "https://docs.gtk.org/gtk4/method.Widget.set_sensitive.html",
                  "note": "语义基准（应用 ADR 0002）"
                }
              ]
            }
          ]
        },
        {
          "id": "gtkmm.buttons.toggle",
          "title": "toggled：保持状态的按钮",
          "type": "concept",
          "difficulty": 2,
          "mastery_goal": "required",
          "requires": [
            "gtkmm.buttons.push-button"
          ],
          "blocks": [
            {
              "type": "text",
              "text": "Gtk::ToggleButton 在「按下/弹起」之间保持状态：内部有 active 布尔值，get_active()/set_active() 读写它；状态每次变化后发出 toggled 信号。"
            },
            {
              "type": "code",
              "lang": "cpp",
              "caption": "读写状态、响应状态变化",
              "source": "auto toggle = Gtk::ToggleButton();\ntoggle.set_label(\"切换我\");\ntoggle.signal_toggled().connect([this] {\n  if (toggle.get_active()) { /* 按下 */ } else { /* 弹起 */ }\n});"
            },
            {
              "type": "simulation",
              "sim": "toggle-state",
              "demo_ref": "demo.buttons",
              "note": "模型简化：真实切换由按下/释放完成，状态存于控件内部。",
              "page_ref": "sec-toggle-buttons"
            },
            {
              "type": "observation_quiz",
              "id": "oq1",
              "demo_ref": "demo.buttons",
              "stem": "打开真机演示，点击「切换我」两次：最后一次发出的 toggled 信号 detail 是什么、此时 get_active() 返回多少？",
              "options": [
                "active / true",
                "inactive / false",
                "第二次不再发信号",
                "两次都是 active"
              ],
              "answer": 1,
              "source_refs": [
                {
                  "relation": "authored",
                  "locator": "content/demos.json :: demo.buttons",
                  "note": "观察真机演示作答（应用 ADR 0002 决策 5）"
                }
              ],
              "page_ref": "sec-toggle-buttons"
            },
            {
              "type": "quiz",
              "id": "q-toggled-name",
              "page_ref": "sec-toggle-buttons",
              "stem": "Gtk::ToggleButton 的状态每变化一次，发出什么信号？",
              "options": [
                "clicked",
                "toggled",
                "pressed",
                "changed"
              ],
              "answer": 1,
              "source_refs": [
                {
                  "relation": "adapted",
                  "url": "https://docs.gtk.org/gtk4/signal.ToggleButton.toggled.html",
                  "note": "语义基准（应用 ADR 0002）"
                }
              ]
            }
          ]
        },
        {
          "id": "gtkmm.buttons.check",
          "title": "CheckButton：勾选与互斥",
          "type": "concept",
          "difficulty": 1,
          "mastery_goal": "required",
          "requires": [
            "gtkmm.buttons.toggle"
          ],
          "blocks": [
            {
              "type": "text",
              "text": "Gtk::CheckButton 是勾选框，视觉是圆圈或对勾，语义上继承自 Gtk::ToggleButton：同样用 toggled 信号与 get_active()。"
            },
            {
              "type": "callout",
              "variant": "warning",
              "text": "GTK3 的 Gtk::RadioButton 在 GTK4 中已被移除。要一组互斥选项，用多个 Gtk::CheckButton 并调用 set_group() 加入同一组。"
            },
            {
              "type": "quiz",
              "id": "q2",
              "stem": "GTK4 中要实现一组互斥的单选项，正确做法是？",
              "options": [
                "使用 Gtk::RadioButton",
                "使用多个 Gtk::CheckButton 并 set_group() 成组",
                "使用 Gtk::ToggleButton 并连接 pressed 信号",
                "使用 Gtk::Switch 并 set_group()"
              ],
              "answer": 1,
              "source_refs": [
                {
                  "relation": "adapted",
                  "url": "https://docs.gtk.org/gtk4/class.CheckButton.html",
                  "note": "语义基准（应用 ADR 0002）"
                }
              ],
              "page_ref": "sec-checkbuttons"
            },
            {
              "type": "quiz",
              "id": "q-check-hierarchy",
              "page_ref": "sec-checkbuttons",
              "stem": "GTK4 中 Gtk::CheckButton 在类层次上的直接基类是？",
              "options": [
                "Gtk::Button",
                "Gtk::ToggleButton",
                "Gtk::Widget",
                "Gtk::Switch"
              ],
              "answer": 1,
              "source_refs": [
                {
                  "relation": "adapted",
                  "url": "https://docs.gtk.org/gtk4/class.CheckButton.html",
                  "note": "语义基准（应用 ADR 0002）"
                }
              ]
            },
            {
              "type": "quiz",
              "id": "q-radio-gone",
              "page_ref": "sec-radio-buttons",
              "stem": "从 GTK3 迁移到 GTK4 后，原来用 Gtk::RadioButton 实现的互斥单选应该改用？",
              "options": [
                "Gtk::RadioButton 仍然可用",
                "Gtk::CheckButton 加 set_group()",
                "Gtk::Switch 成组",
                "Gtk::ComboBoxText"
              ],
              "answer": 1,
              "source_refs": [
                {
                  "relation": "adapted",
                  "url": "https://docs.gtk.org/gtk4/class.CheckButton.html",
                  "note": "语义基准（应用 ADR 0002）"
                }
              ]
            }
          ]
        }
      ],
