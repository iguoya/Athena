#| "  wrap_init(); //Tells the Glib::wrap() table about the libsomethingmm classes.\n"
#| "}\n"
msgid ""
"<code>void init()\n"
"{\n"
"  Gtk::init_gtkmm_internals(); //Sets up the g type system and the Glib::wrap() table.\n"
"  wrap_init(); //Tells the Glib::wrap() table about the libsomethingmm classes.\n"
"}\n"
"</code>"
msgstr ""
"\n"
"void init()\n"
"{\n"
