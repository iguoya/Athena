{
  "id": "mathematics",
  "title": "数学学习",
  "group": "数理",
  "description": "数学学习：按线性变换组织线性代数，先看见平面被搬了一次，再用符号说清楚。可单独使用。",
  "icon": {
    "type": "theme",
    "name": "accessories-calculator-symbolic",
    "symbol": "x.squareroot",
    "letter": "数",
    "accent": "#EF6C00",
    "file": "icon.svg",
    "renders": {
      "src-tauri/icons/32x32.png": 32,
      "src-tauri/icons/128x128.png": 128,
      "src-tauri/icons/128x128@2x.png": 256,
      "src-tauri/icons/icon.png": 512,
      "src-tauri/icons/icon.ico": "ico",
      "src-tauri/icons/icon.icns": "icns",
      "src-tauri/icons/StoreLogo.png": 50,
      "src-tauri/icons/Square30x30Logo.png": 30,
      "src-tauri/icons/Square44x44Logo.png": 44,
      "src-tauri/icons/Square71x71Logo.png": 71,
      "src-tauri/icons/Square89x89Logo.png": 89,
      "src-tauri/icons/Square107x107Logo.png": 107,
      "src-tauri/icons/Square142x142Logo.png": 142,
      "src-tauri/icons/Square150x150Logo.png": 150,
      "src-tauri/icons/Square284x284Logo.png": 284,
      "src-tauri/icons/Square310x310Logo.png": 310
    }
  },
  "dev": {
    "env": {
      "ATHENA_MATH_ROOT": "${dir}"
    },
    "prepare": [
      {
        "when_missing": "node_modules",
        "run": [
          "npm",
          "install"
        ],
        "label": "安装前端依赖"
      }
    ],
    "run": [
      "npm",
      "run",
      "tauri:dev"
    ],
    "ready": {
      "http": "http://localhost:1430"
    },
    "match": "src-tauri/target",
    "binary": "athena-math"
  }
}
