{
  "id": "polaris",
  "title": "北极星",
  "group": "图谱",
  "description": "计算机与电子信息的课程图谱：先看见学科全局、主次和去向，再决定进哪个应用练细节。",
  "icon": {
    "type": "theme",
    "name": "starred-symbolic",
    "symbol": "sparkles",
    "letter": "北",
    "accent": "#316B78",
    "file": "icon.svg",
    "renders": {
      "icon.png": 256,
      "icon.ico": "ico"
    }
  },
  "dev": {
    "env": {
      "POLARIS_ROOT": "${dir}"
    },
    "prepare": [
      {
        "when_missing": "node_modules",
        "run": [
          "npm",
          "install"
        ],
        "label": "安装前端依赖"
      }
    ],
    "run": [
      "npm",
      "run",
      "tauri:dev"
    ],
    "ready": {
      "http": "http://localhost:1470"
    },
    "match": "src-tauri/target",
    "binary": "athena-polaris"
  }
}
