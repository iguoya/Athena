// Windows 可执行文件资源：文件属性（右键属性 -> 详细信息）。
// 由 CMakeLists.txt 的 configure_file() 替换版本号后编译。
// VS_VERSION_INFO 必须来自 winver.h 才会展开成数字 ID 1——不 include 这个头，
// RC 编译器会把它当成字符串资源名字编译，Windows 的版本信息 API 读不到。
//
// 字符串一律用英文：MSVC rc.exe 和 GNU windres 对窄字符串都不做代码页转换，
// 非 ASCII 字符（包括中文）编出来的资源 Windows 版本信息 API 读不出正确文本——
// 这是 RC 资源格式本身的历史包袱，不代表软件不能用中文；全仓的用户可见界面
// 仍然一律中文，这里只有『右键属性』这个开发者视角的对话框例外。
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @VERSION_COMMA@
PRODUCTVERSION @VERSION_COMMA@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Athena"
            VALUE "FileDescription", "Athena Polaris"
            VALUE "FileVersion", "@VERSION_STR@"
            VALUE "InternalName", "polaris"
            VALUE "OriginalFilename", "athena-polaris.exe"
            VALUE "ProductName", "Athena Polaris"
            VALUE "ProductVersion", "@VERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
