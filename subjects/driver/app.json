{
  "id": "driver",
  "title": "驾考学习",
  "description": "独立的驾考学习应用：科目一法规与科目四文明驾驶，做题在桌面完成，可脱离其他应用单独使用。",
  "icon": {
    "type": "theme",
    "name": "mark-location-symbolic",
    "symbol": "car",
    "letter": "驾",
    "accent": "#1565C0",
    "file": "icon.svg",
    "renders": {
      "icon.png": 256,
      "windows/runner/resources/app_icon.ico": "ico",
      "macos/Runner/Assets.xcassets/AppIcon.appiconset/app_icon_16.png": 16,
      "macos/Runner/Assets.xcassets/AppIcon.appiconset/app_icon_32.png": 32,
      "macos/Runner/Assets.xcassets/AppIcon.appiconset/app_icon_64.png": 64,
      "macos/Runner/Assets.xcassets/AppIcon.appiconset/app_icon_128.png": 128,
      "macos/Runner/Assets.xcassets/AppIcon.appiconset/app_icon_256.png": 256,
      "macos/Runner/Assets.xcassets/AppIcon.appiconset/app_icon_512.png": 512,
      "macos/Runner/Assets.xcassets/AppIcon.appiconset/app_icon_1024.png": 1024
    }
  },
  "dev": {
    "env": {
      "ATHENA_DRIVER_ROOT": "${dir}"
    },
    "prepare": [
      {
        "when_missing": ".dart_tool",
        "run": ["python3", "scripts/run_dev.py", "pub", "get"],
        "label": "安装 Dart 依赖"
      }
    ],
    "run": ["python3", "scripts/run_dev.py"],
    "ready": "process",
    "match": "build",
    "binary": "athena-driver"
  }
}
