          "source_id": "road-safety-regulation",
          "locator": "第四十七条"
        },
        {
          "scenario": "超车时前方车辆不减速、不让道",
          "points": [
            "停止超车并适当减速，与前车保持安全距离，不能加速硬超"
          ],
          "source_id": "road-safety-regulation",
          "locator": "第四十七条"
        },
        {
          "scenario": "无法保证与被超车辆的横向安全间距",
