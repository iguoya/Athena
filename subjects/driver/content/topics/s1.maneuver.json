      "items": [
        {
          "scenario": "什么时候不能超车",
          "points": [
            "前车正在左转弯、掉头、超车",
            "与对面来车有会车可能",
            "前车是执行紧急任务的警车、消防车、救护车、工程救险车"
          ],
          "source_id": "road-safety-law",
          "locator": "第四十三条"
        },
        {
          "scenario": "什么路段不能超车",
          "points": [
            "铁路道口、交叉路口、窄桥、弯道、陡坡、隧道、人行横道",
            "市区交通流量大的路段，以及其他没有超车条件的路段"
          ],
          "source_id": "road-safety-law",
          "locator": "第四十三条"
        },
        {
          "scenario": "怎么超",
          "points": [
            "从前车左侧超越，便于观察",
            "提前开左转向灯，变换使用远、近光灯或鸣喇叭，不能用鸣喇叭代替转向灯"
