          "source_id": "road-safety-regulation",
          "locator": "第四十七条"
        },
        {
          "scenario": "夜间超车",
          "points": [
            "变换远、近光灯示意前车，选路宽车少的地段"
          ],
          "source_id": "road-safety-regulation",
          "locator": "第四十七条"
        },
        {
          "scenario": "不按规定超车、让行",
          "points": [
            "一次记 3 分；河南在多车道上长时间占用超车道罚 200 元"
