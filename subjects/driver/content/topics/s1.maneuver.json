          ],
          "source_id": "road-safety-regulation",
          "locator": "第四十八条"
        },
        {
          "scenario": "夜间会车",
          "points": [
            "在距对向来车 150 米以外改用近光灯；窄路、窄桥、与非机动车会车也用近光灯"
