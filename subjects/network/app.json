{
 "id": "network",
 "title": "计算机网络",
 "group": "计算机网络",
 "parent": "cs408",
 "also_under": ["software"],
 "description": "计算机网络：软设第 10 章的实践课程——socket 真连、子网计算、加密真算（ADR 0110 更名）。可单独使用。",
 "icon": {
  "type": "theme",
  "name": "network-symbolic",
  "symbol": "network",
  "letter": "网",
  "accent": "#B03A2E",
  "file": "icon.svg",
  "renders": {
   "src-tauri/icons/32x32.png": 32,
   "src-tauri/icons/128x128.png": 128,
   "src-tauri/icons/128x128@2x.png": 256,
   "src-tauri/icons/icon.png": 512,
   "src-tauri/icons/icon.ico": "ico",
   "src-tauri/icons/icon.icns": "icns"
  }
 },
 "dev": {
  "prepare": [
   {
    "when_missing": "node_modules",
    "run": [
     "npm",
     "install"
    ],
    "label": "安装前端依赖"
   }
  ],
  "run": [
   "npm",
   "run",
   "tauri:dev"
  ],
  "ready": {
   "http": "http://localhost:1493"
  },
  "match": "src-tauri/target",
  "binary": "athena-network",
  "env": {
   "ATHENA_NETWORK_ROOT": "${dir}"
  }
 }
}
