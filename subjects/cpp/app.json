{
  "id": "cpp",
  "title": "C++ 教程",
  "description": "C++ 语言学习：教学大纲、学习页与可运行实验。与其他应用平级，不负责打开别的应用。",
  "icon": {
    "type": "theme",
    "name": "text-x-cpp-symbolic",
    "symbol": "chevron.left.forwardslash.chevron.right",
    "letter": "C++",
    "accent": "#00599C",
    "file": "icon.svg"
  },
  "dev": {
    "env": {
      "ATHENA_APPS_ROOT": "${dir}/..",
      "ATHENA_CPP_ROOT": "${dir}"
    },
    "prepare": [
      {
        "when_missing": "build",
        "run": [
          "meson",
          "setup",
          "build",
          "--buildtype=debug"
        ],
        "label": "配置构建目录"
      },
      {
        "run": [
          "meson",
          "compile",
          "-C",
          "build"
        ],
        "label": "增量编译"
      }
    ],
    "run": [
      "build/athena-cpp"
    ],
    "ready": "process",
    "match": "build",
    "binary": "athena-cpp"
  },
  "evolves_from": "c"
}
