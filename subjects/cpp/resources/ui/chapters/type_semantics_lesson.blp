using Gtk 4.0;

// ADR 0026：类型与表达式的第一条原生学习场景。学习顺序和双路径对比完全由
// GUI 控件表达。
//
// Notebook 第一个标签是章节教学大纲（ADR 0028 第一层），其余标签是这一页
// 自己的教学过程（第二层）。大纲只在这里维护，没有第二份副本（ADR 0039）。
Box type_semantics_lesson_page {
  name: "type_semantics_lesson_page";
  orientation: vertical;
  spacing: 14;
  hexpand: true;
  vexpand: true;
  margin-top: 16;
  margin-bottom: 20;
  margin-start: 20;
  margin-end: 20;

  styles [ "native-lesson-page" ]

  Frame {
    styles [ "panel-frame", "native-lesson-hero" ]

    Box {
      orientation: vertical;
      spacing: 6;
      margin-top: 16;
      margin-bottom: 16;
      margin-start: 18;
      margin-end: 18;

      Box {
        orientation: horizontal;
        spacing: 12;

        Image {
          icon-name: "text-x-generic-symbolic";
          pixel-size: 34;
        }

        Box {
          orientation: vertical;
          spacing: 3;
          hexpand: true;

          // 小节名由 TypeSemanticsLessonPage 随当前标签更新，不写死在这里。
          Label type_semantics_page_title {
            name: "type_semantics_page_title";
            label: "类型与表达式";
            halign: start;
            styles [ "title-2" ]
          }

          // 副标题同样随标签走：显示当前小节要解决什么，取自 athena.json 的
          // description，不在这里另写一份。
          Label type_semantics_page_subtitle {
            name: "type_semantics_page_subtitle";
            label: "从初始化、类型推导和值类别建立阅读 C++ 对象与表达式的基本方法。";
            halign: start;
            wrap: true;
            xalign: 0;
            styles [ "header-description" ]
          }
        }

        // 实验台入口：标题与描述是一个整体，它站在这一整块的右侧。读者在任何
        // 一节都能直接把专注实验调出来，不必滚到节末尾找按钮。
        Button type_semantics_open_dock_button {
          name: "type_semantics_open_dock_button";
          valign: center;
          tooltip-text: "打开当前小节的实验台";
          styles [ "btn-primary", "btn-lg", "lesson-dock-button" ]

          Box {
            orientation: horizontal;
            spacing: 10;
            halign: center;

            Image { icon-name: "system-run-symbolic"; pixel-size: 22; }
            Label { label: "实验台"; }
          }
        }

      }

    }
  }

  // 每个标签页写成"内容在前、[tab] 标签在后"。顺序不能反过来：GtkBuilder 按
  // XML 顺序处理 child，遇到 <child type="tab"> 就调
  // gtk_notebook_set_tab_label(notebook, child, label)，而那时对应的 page 还没
  // 加进 notebook，child 是 NULL，每次加载都会打两条
  // "gtk_notebook_get/set_tab_label: assertion 'GTK_IS_WIDGET (child)' failed"。
  //
  // 标签直接对应课程的子章节。第一个标签是章节教学大纲（ADR 0028 第一层），
  // 用 GTK 控件手写而不是渲染 Markdown——主次、评级、检查点这些结构用徽章和
  // 卡片一眼可辨，摊平成正文就看不出轻重。此章不再维护 Markdown 大纲副本。
  // ADR 0039 撤销了原先排在它前面的「本章导览」：那四块内容大纲全都有，
  // 而且更完整，两份并存只会漂移。
  Notebook type_semantics_section_notebook {
      // 必须 vexpand：不然 Notebook 向父 Box 要的是"最高那一页的自然高度"
      // （本章约 13600px），窗口只有一千多，GTK 只能强行压缩，页内 Picture 的
      // height-request 被违反、图被压成一条看不见的白边。vexpand 之后 Notebook
      // 填满可用空间，页内的 ScrolledWindow 才真正负责滚动。
      vexpand: true;

      ScrolledWindow {
        hscrollbar-policy: never;
        vexpand: true;

        Box {
          orientation: vertical;
          spacing: 16;
          margin-bottom: 18;

          // 这一页是 ADR 0028 三层里的第一层：只指方向，不讲语法机制。
          // 用控件手写而不是渲染 Markdown，因为主次、评级、检查点编号这些
          // 结构用徽章和卡片一眼可辨，纯正文会把它们摊平。
          //
          // ADR 0039：这里是本章大纲的唯一一份，前面不再有「本章导览」。
          // 导览当初是为了解决"大纲太长"，正确的解法是把大纲写短——所以
          // 地图（主次、顺序、难度）放在最前，细节一律下放到各知识点小节，
          // 这一页不再重复它们。

          Label {
            label: "建立判断对象如何初始化、何时有效，以及表达式如何参与传递与转换的基本框架。";
            halign: start; wrap: true; xalign: 0;
            styles [ "native-lesson-lead" ]
          }
          Label {
            use-markup: true;
            label: "读 C++ 代码时，只知道「这个变量存着什么」还不够。<span foreground='#052c65' weight='bold'>同一个结果，可能被复制，也可能只是被另一个名字引用</span>；看似普通的一次传递，可能丢失信息，也可能留下失效的引用。本章把这些日常判断背后的语言规则连成一条线。";
            halign: start; wrap: true; xalign: 0;
            styles [ "lesson-prose" ]
          }

          // 1. 地图：先让读者看清轻重缓急，再往下读
          Frame {
            label: "先看主次与顺序";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Box {
                orientation: horizontal;
                spacing: 8;
                halign: start;

                Label { label: "初始化"; styles [ "outline-step" ] }
                Label { label: "→"; styles [ "outline-step-arrow" ] }
                Label { label: "对象生命周期"; styles [ "outline-step" ] }
                Label { label: "→"; styles [ "outline-step-arrow" ] }
                Label { label: "auto"; styles [ "outline-step" ] }
                Label { label: "→"; styles [ "outline-step-arrow" ] }
                Label { label: "枚举 / 转换"; styles [ "outline-step" ] }
                Label { label: "→"; styles [ "outline-step-arrow" ] }
                Label { label: "值类别"; styles [ "outline-step" ] }
                Label { label: "→"; styles [ "outline-step-arrow" ] }
                Label { label: "decltype"; styles [ "outline-step" ] }
              }

              Label {
                label: "这不是随口排的，它就是知识点之间先修关系的拓扑序——decltype 的规则要用值类别说明，值类别要先知道临时对象何时销毁，跳着学会在后面卡住。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              // Cairo 自绘：节点位置、依赖连线、难度配色和熟练度都来自运行时
              // 数据（requires 拓扑序 + 评级 + 学习库），不是画好的图片，也不是
              // .blp 能表达的结构（AGENTS.md GTK 规则第 3 条）。
              Box ts_outline_roadmap_host {
                name: "ts_outline_roadmap_host";
                orientation: vertical;
                height-request: 300;
              }
              Label {
                label: "一张图给出四件事：箭头是先修关系；方框配色是难度，冷色较易、暖色较难，和知识点徽章同一套色阶；框里第二行是要学到什么程度；底部细条是你当前的熟练度。点任意一个方块直接跳到那一节。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-figure-caption" ]
              }

              Box {
                orientation: vertical; spacing: 5;
                styles [ "lesson-callout", "outline-tier-master" ]
                Box {
                  orientation: horizontal; spacing: 8;
                  Label { label: "先拿下"; styles [ "badge", "badge-mastery-goal", "mastery-goal-master" ] }
                  Label { label: "初中级 · 需要精通"; halign: start; styles [ "dim-label" ] }
                }
                Label { label: "初始化的保证、对象生命周期与临时对象、auto 的副本与别名之分。这三样在后面每一章都会用到，判断错的代价最直接。"; halign: start; wrap: true; xalign: 0; }
              }

              Box {
                orientation: vertical; spacing: 5;
                styles [ "lesson-callout", "outline-tier-required" ]
                Box {
                  orientation: horizontal; spacing: 8;
                  Label { label: "随后掌握"; styles [ "badge", "badge-mastery-goal", "mastery-goal-required" ] }
                  Label { label: "初中级 · 必须掌握"; halign: start; styles [ "dim-label" ] }
                }
                Label { label: "枚举的类型边界、转换的意图与检查位置。它们不难，但决定接口能不能替你挡住误用。"; halign: start; wrap: true; xalign: 0; }
              }

              Box {
                orientation: vertical; spacing: 5;
                styles [ "lesson-callout", "outline-tier-required" ]
                Box {
                  orientation: horizontal; spacing: 8;
                  Label { label: "可以慢一点"; styles [ "badge", "badge-mastery-goal", "mastery-goal-required" ] }
                  Label { label: "进阶 · 必须掌握"; halign: start; styles [ "dim-label" ] }
                }
                Label { label: "值类别。规则密度高，第一遍能判断左值／纯右值／将亡值并说明它影响哪种绑定即可，写模板时会再深入。"; halign: start; wrap: true; xalign: 0; }
              }

              Box {
                orientation: vertical; spacing: 5;
                styles [ "lesson-callout", "outline-tier-familiar" ]
                Box {
                  orientation: horizontal; spacing: 8;
                  Label { label: "可以先跳过"; styles [ "badge", "badge-mastery-goal", "mastery-goal-familiar" ] }
                  Label { label: "进阶 · 一般了解"; halign: start; styles [ "dim-label" ] }
                }
                Label { label: "decltype 的表达式取类型规则。先知道它解决什么问题，等真正写泛型代码时回来补。"; halign: start; wrap: true; xalign: 0; }
              }

              Label {
                label: "贯穿全章、没有独立实验的是静态类型本身：它表达什么意图、限制哪些操作、编译器能检查到哪里。每学完一个方向回头问一次「这里的类型到底约束住了什么」，比单独为它安排一节更有用。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }

          // 2. 主脊：五个检查点，每条同时说明不检查会怎样（原先拆成「五类风险」
          //    和「五个检查点」两节，同一组东西写了两遍，ADR 0039 合并）
          Frame {
            label: "读代码时的五个检查点";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "本章的主脊：每一条都是一个要问的问题，后面跟着不问它会付出的代价。实际阅读时允许往返，不必机械地走固定步骤。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: horizontal; spacing: 10;
                Label { label: "①"; valign: start; styles [ "outline-risk-index" ] }
                Box {
                  orientation: vertical; spacing: 2; hexpand: true;
                  Label { label: "认类型 —— 对象和表达式分别是什么类型，const 与引用修饰了哪一层"; halign: start; wrap: true; xalign: 0; styles [ "lesson-callout-title" ] }
                  Label { label: "不问：枚举、整数和强制转换混在一起，不同含义被当成同一种类型，编译器很难替代码守住边界。"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                }
              }

              Box {
                orientation: horizontal; spacing: 10;
                Label { label: "②"; valign: start; styles [ "outline-risk-index" ] }
                Box {
                  orientation: vertical; spacing: 2; hexpand: true;
                  Label { label: "看初始化 —— 对象怎样取得初始状态，会不会丢信息"; halign: start; wrap: true; xalign: 0; styles [ "lesson-callout-title" ] }
                  Label { use-markup: true; label: "不问：读到没有可靠初值的对象，代码可能表现不稳定，甚至<span foreground='#052c65' weight='bold'>直接进入未定义行为</span>；精度也可能在一次看不见的转换里悄悄丢掉。"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                }
              }

              Box {
                orientation: horizontal; spacing: 10;
                Label { label: "③"; valign: start; styles [ "outline-risk-index" ] }
                Box {
                  orientation: vertical; spacing: 2; hexpand: true;
                  Label { label: "查有效期 —— 对象此刻是否仍然存在，引用会不会活得比所指对象更久"; halign: start; wrap: true; xalign: 0; styles [ "lesson-callout-title" ] }
                  Label { use-markup: true; label: "不问：对象已经失效而引用仍被使用，表面上还能访问，<span foreground='#052c65' weight='bold'>实际已经越过对象的有效期</span>。"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                }
              }

              Box {
                orientation: horizontal; spacing: 10;
                Label { label: "④"; valign: start; styles [ "outline-risk-index" ] }
                Box {
                  orientation: vertical; spacing: 2; hexpand: true;
                  Label { label: "辨表达式 —— 指向已有对象还是产生新值，它的值类别怎样影响绑定与重载"; halign: start; wrap: true; xalign: 0; styles [ "lesson-callout-title" ] }
                  Label { label: "不问：分不清在操作副本还是原对象——写法很像，改动却落在不同对象上；反过来没察觉产生了副本时，大对象的复制会变成真实的时间和内存代价。"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                }
              }

              Box {
                orientation: horizontal; spacing: 10;
                Label { label: "⑤"; valign: start; styles [ "outline-risk-index" ] }
                Box {
                  orientation: vertical; spacing: 2; hexpand: true;
                  Label { label: "找转换 —— 在哪里发生，隐式还是显式，哪些前提仍需你保证"; halign: start; wrap: true; xalign: 0; styles [ "lesson-callout-title" ] }
                  Label { label: "不问：数值进入范围更小或表达能力不同的类型后，结果可能已经不是原来的值，而这次转换在代码里根本搜不到。"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                }
              }

              Label {
                label: "这些风险大多是表达能力增强后留下的选择题。构造函数和引用让对象的建立与使用有了更丰富的表达，也让「这是新对象还是已有对象的别名」成了每次都要判断的事；C++11 的类型推导省掉重复书写，同时把「副本还是别名」的意图交还给你；列表初始化和作用域枚举则是反过来收紧检查，把一部分风险挪到编译期。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-figure" ]

                DrawingArea ts_outline_loop_figure {
                  name: "ts_outline_loop_figure";
                  height-request: 760;
                  hexpand: true;
                }
                Label {
                  use-markup: true;
                  label: "依据规则形成预期，再用证据修正理解——<span foreground='#052c65' weight='bold'>一次运行正常不能证明代码总是正确</span>，尤其不能据此排除未定义行为。";
                  halign: start; wrap: true; xalign: 0;
                  styles [ "lesson-figure-caption" ]
                }
              }
            }
          }

          // 3. 心智模型：全章都要用的那组区分
          Frame {
            label: "心智模型：对象与表达式";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                use-markup: true;
                label: "对象是程序中具有身份、承载状态的实体；表达式是代码中参与求值的部分，可以指向已有对象，也可以计算出用于后续操作的值。<span foreground='#052c65' weight='bold'>多个表达式可以指向同一个对象</span>，所以<span background='#fff3cd' weight='bold'>「写法不同」不一定意味着「多出了一份对象」</span>。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-lead" ]
              }

              Box {
                orientation: horizontal;
                spacing: 14;
                homogeneous: true;

                Box {
                  orientation: vertical; spacing: 6;
                  styles [ "figure-stance", "figure-stance-decltype" ]
                  Label { label: "对象 · 看三样"; halign: start; styles [ "figure-stance-title" ] }
                  Label { label: "类型、状态、生命周期。缺一样就判断不了这次访问安不安全。"; halign: start; wrap: true; xalign: 0; }
                }

                Box {
                  orientation: vertical; spacing: 6;
                  styles [ "figure-stance", "figure-stance-auto" ]
                  Label { label: "表达式 · 看两样"; halign: start; styles [ "figure-stance-title" ] }
                  Label { label: "类型、值类别。没有「生命周期」这一项——那是对象的属性。"; halign: start; wrap: true; xalign: 0; }
                }
              }

              Label {
                use-markup: true;
                label: "<span background='#fff3cd' weight='bold'>值类别描述表达式怎样参与操作，生命周期描述对象何时有效</span>——二者必须分别判断：<span foreground='#052c65' weight='bold'>不能靠「持久还是临时」直接判定值类别</span>。这是本章最需要建立的区分，具体怎么判断留给「值类别」和「对象生命周期」两节。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }

          // 4. 判断与代价
          Frame {
            label: "反复出现的三组选择";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Box {
                orientation: vertical; spacing: 4;
                styles [ "lesson-callout" ]
                Label { label: "明确类型，还是交给推导？"; halign: start; styles [ "lesson-callout-title" ] }
                Label { label: "推导减少重复，也能适应复杂类型；明确写出类型能直接表达接口意图。两者都要检查是否保留了所需的只读约束与引用关系。"; halign: start; wrap: true; xalign: 0; }
              }
              Box {
                orientation: vertical; spacing: 4;
                styles [ "lesson-callout" ]
                Label { label: "保留副本，还是共享原对象？"; halign: start; styles [ "lesson-callout-title" ] }
                Label { use-markup: true; label: "副本让后续修改相互独立，但可能带来复制代价；<span foreground='#052c65' weight='bold'>引用避免复制，却要求关心原对象的有效期</span>。"; halign: start; wrap: true; xalign: 0; }
              }
              Box {
                orientation: vertical; spacing: 4;
                styles [ "lesson-callout" ]
                Label { label: "接受转换，还是保留类型边界？"; halign: start; styles [ "lesson-callout-title" ] }
                Label { label: "更严格的初始化与独立枚举类型能拦住一部分误用；与外部数据或旧接口交互时，仍需检查范围、含义和前提。"; halign: start; wrap: true; xalign: 0; }
              }
            }
          }

          // 5. 落点：学完能做到什么（UbD 逆向设计）
          Frame {
            label: "学完这一章，你应该能做到";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "前提只要知道变量、赋值和基本类型。下面每一条都可以拿一段没见过的代码当场检验，顺序与推荐学习顺序一致。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box { orientation: horizontal; spacing: 10;
                Label { label: "精通"; valign: start; styles [ "badge", "badge-mastery-goal", "mastery-goal-master" ] }
                Label { label: "面对一次初始化，说明它提供了什么保证、可能在哪里丢失信息、谁来检查。"; halign: start; wrap: true; xalign: 0; hexpand: true; }
              }
              Box { orientation: horizontal; spacing: 10;
                Label { label: "精通"; valign: start; styles [ "badge", "badge-mastery-goal", "mastery-goal-master" ] }
                Label { label: "说出一个对象从哪一行开始存在、到哪一行结束，并判断某个引用此刻是否还有效。"; halign: start; wrap: true; xalign: 0; hexpand: true; }
              }
              Box { orientation: horizontal; spacing: 10;
                Label { label: "精通"; valign: start; styles [ "badge", "badge-mastery-goal", "mastery-goal-master" ] }
                Label { label: "指出哪些名字指向同一个对象、哪些是各自独立的副本，并说明在一个具体场景里该选哪种。"; halign: start; wrap: true; xalign: 0; hexpand: true; }
              }
              Box { orientation: horizontal; spacing: 10;
                Label { label: "掌握"; valign: start; styles [ "badge", "badge-mastery-goal", "mastery-goal-required" ] }
                Label { label: "说明一组状态什么时候值得有独立的枚举类型，它挡住了哪些误用。"; halign: start; wrap: true; xalign: 0; hexpand: true; }
              }
              Box { orientation: horizontal; spacing: 10;
                Label { label: "掌握"; valign: start; styles [ "badge", "badge-mastery-goal", "mastery-goal-required" ] }
                Label { label: "看到一次转换，说出它表达什么意图、检查发生在编译期还是运行期、哪些前提仍由自己保证。"; halign: start; wrap: true; xalign: 0; hexpand: true; }
              }
              Box { orientation: horizontal; spacing: 10;
                Label { label: "掌握"; valign: start; styles [ "badge", "badge-mastery-goal", "mastery-goal-required" ] }
                Label { label: "判断一个表达式是左值、纯右值还是将亡值，并据此说明它能绑定到哪种引用。"; halign: start; wrap: true; xalign: 0; hexpand: true; }
              }
              Box { orientation: horizontal; spacing: 10;
                Label { label: "了解"; valign: start; styles [ "badge", "badge-mastery-goal", "mastery-goal-familiar" ] }
                Label { label: "说明 decltype 解决的是哪一类问题，知道它和 auto 问的不是同一件事。"; halign: start; wrap: true; xalign: 0; hexpand: true; }
              }

              Label {
                label: "这套判断会继续用于「引用」中的传参与返回、「RAII 与资源管理」中的所有权与资源转移，以及「模板与泛型」中的类型推导。每一节末尾的随堂考核按这些目标出题，易错点也在各节当场说明——这一页不再重复列一遍。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }
        }
      }

      [tab]
      Label { label: "教学大纲"; }

      ScrolledWindow {
        hscrollbar-policy: never;
        vexpand: true;

        Box {
          orientation: vertical;
          spacing: 18;
          margin-bottom: 18;

          // 1. 动机：为什么初始化值得单独一节
          Frame {
            label: "为什么要专门学初始化";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "初始化不是“先把对象创建出来，再赋一个值给它”。对象从生命周期的第一刻起，就按某条语言规则取得初始状态——这条规则由你写下的初始化形式决定，一旦选错，编译器未必会拦你。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                label: "C++ 提供圆括号、等号、花括号等好几种写法，不是历史包袱式的语法冗余。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-why" ]

                Label { label: "一句话抓住重点"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "这几种写法的差别在一个关键问题上：当类型需要转换时，谁来检查“信息会不会丢”。没分清楚，常见代价是——窄化转换悄悄丢精度、本该显式的构造被隐式绕过、读到从未写入的“垃圾值”。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 2. 把四种写法摆出来
          Frame {
            label: "四种写法：结果相近，规则不同";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label { label: "int direct(7);    // 直接初始化"; halign: start; styles [ "native-lesson-code" ] }
              Label { label: "int copied = 8;   // 拷贝初始化"; halign: start; styles [ "native-lesson-code" ] }
              Label { label: "int listed{9};    // 列表初始化"; halign: start; styles [ "native-lesson-code" ] }
              Label { label: "int zero{};       // 值初始化"; halign: start; styles [ "native-lesson-code" ] }

              // 四种写法的对照表。ADR 0038：表格用控件排版而不是 SVG 图片——
              // 字还是字，能选中、跟随系统字号与主题，改措辞只改这里。
              Box {
                orientation: vertical;
                spacing: 10;
                styles [ "lesson-figure" ]

                Label {
                  label: "同一个 3.75 进入 int：谁来检查「信息会不会丢」";
                  halign: start;
                  styles [ "lesson-callout-title" ]
                }

                Grid {
                  column-spacing: 22;
                  row-spacing: 12;
                  styles [ "figure-table" ]

                  Label { label: "写法"; halign: start; styles [ "figure-head" ] layout { column: 0; row: 0; } }
                  Label { label: "它提供什么保证"; halign: start; styles [ "figure-head" ] layout { column: 1; row: 0; } }
                  Label { label: "遇到窄化时"; halign: start; styles [ "figure-head" ] layout { column: 2; row: 0; } }

                  Separator { layout { column: 0; row: 1; column-span: 3; } }

                  Box {
                    orientation: vertical; spacing: 2;
                    layout { column: 0; row: 2; }
                    Label { label: "int direct(7);"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "直接初始化"; halign: start; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 2; hexpand: true;
                    layout { column: 1; row: 2; }
                    Label { label: "按参数调用构造，允许有损转换"; halign: start; wrap: true; xalign: 0; styles [ "figure-cell" ] }
                    Label { label: "截断由你承担"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }
                  Label {
                    label: "放行 · 3.75 变成 3";
                    halign: start; valign: center;
                    styles [ "figure-verdict", "figure-verdict-pass" ]
                    layout { column: 2; row: 2; }
                  }

                  Box {
                    orientation: vertical; spacing: 2;
                    layout { column: 0; row: 3; }
                    Label { label: "int copied = 8;"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "拷贝初始化"; halign: start; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 2; hexpand: true;
                    layout { column: 1; row: 3; }
                    Label { label: "同样允许有损转换"; halign: start; wrap: true; xalign: 0; styles [ "figure-cell" ] }
                    Label { label: "还会被 explicit 构造函数拒绝"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }
                  Label {
                    label: "放行 · 3.75 变成 3";
                    halign: start; valign: center;
                    styles [ "figure-verdict", "figure-verdict-pass" ]
                    layout { column: 2; row: 3; }
                  }

                  Box {
                    orientation: vertical; spacing: 2;
                    layout { column: 0; row: 4; }
                    Label { label: "int listed{9};"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "列表初始化"; halign: start; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 2; hexpand: true;
                    layout { column: 1; row: 4; }
                    Label { label: "把「会不会丢信息」交给编译器"; halign: start; wrap: true; xalign: 0; styles [ "figure-cell" ] }
                    Label { label: "这是它和上面两种的真正区别"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }
                  Label {
                    label: "编译失败 · 拒绝窄化";
                    halign: start; valign: center;
                    styles [ "figure-verdict", "figure-verdict-stop" ]
                    layout { column: 2; row: 4; }
                  }

                  Box {
                    orientation: vertical; spacing: 2;
                    layout { column: 0; row: 5; }
                    Label { label: "int zero{};"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "值初始化"; halign: start; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 2; hexpand: true;
                    layout { column: 1; row: 5; }
                    Label { label: "保证得到 0，而不是残留的垃圾值"; halign: start; wrap: true; xalign: 0; styles [ "figure-cell" ] }
                    Label { label: "对照：int uninit; 读它是未定义行为"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }
                  Label {
                    label: "不涉及转换 · 值为 0";
                    halign: start; valign: center;
                    styles [ "figure-verdict", "figure-verdict-compile" ]
                    layout { column: 2; row: 5; }
                  }
                }

                Label {
                  label: "四行都得到一个普通的 int。差别不在括号长相，在谁来检查信息丢失。";
                  halign: start; wrap: true; xalign: 0;
                  styles [ "lesson-prose" ]
                }
                Label {
                  label: "第三处边界是 explicit：它只挡住不写类型名的隐式转换，写出 ExplicitNumber{3} 仍然可以。";
                  halign: start; wrap: true; xalign: 0;
                  styles [ "lesson-figure-caption" ]
                }
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-key" ]

                Label { label: "要点"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "四行都得到一个普通的 int。要关注的不是括号长相，而是下面两处边界——它们决定同样的写法遇到风险时是放行还是报错。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 3. 边界一：窄化（保留双路径对比）
          Frame {
            label: "边界一：花括号会拦住“窄化”";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "同一个 double 值 3.75 要放进 int：圆括号允许，代价是小数部分被丢掉；花括号在编译期直接拒绝，因为这是一次可能丢信息的窄化转换。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-lead" ]
              }

              Box {
                orientation: horizontal;
                spacing: 14;
                homogeneous: true;

                Frame {
                  label: "圆括号：允许，但要承担后果";
                  styles [ "native-lesson-lane", "native-lesson-lane-warning" ]

                  Box {
                    orientation: vertical;
                    spacing: 6;
                    margin-top: 12;
                    margin-bottom: 12;
                    margin-start: 14;
                    margin-end: 14;

                    Label { label: "double source = 3.75"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "↓ 转成 int"; halign: start; styles [ "dim-label" ] }
                    Label { label: "int value(source)  →  3"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "运行可以继续，但小数部分已经被丢弃。"; halign: start; wrap: true; xalign: 0; styles [ "native-lesson-warning" ] }
                  }
                }

                Frame {
                  label: "花括号：把边界交给编译器";
                  styles [ "native-lesson-lane", "native-lesson-lane-safe" ]

                  Box {
                    orientation: vertical;
                    spacing: 6;
                    margin-top: 12;
                    margin-bottom: 12;
                    margin-start: 14;
                    margin-end: 14;

                    Label { label: "double source = 3.75"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "↓ 窄化检查"; halign: start; styles [ "dim-label" ] }
                    Label { label: "int value{source}  →  拒绝编译"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "没有执行结果：这是编译期规则，而非运行时输出。"; halign: start; wrap: true; xalign: 0; styles [ "native-lesson-safe" ] }
                  }
                }
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-key" ]

                Label { label: "怎么选"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "需要表达“这个值必须无损进入目标类型”时用花括号，让编译器替你把关；确实接受截断时用圆括号，把这次决定写在明处。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 4. 边界二：explicit
          Frame {
            label: "边界二：explicit 挡住悄悄发生的转换";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "单参数构造函数默认可以当隐式转换用：一个 int 会在你没察觉时变成某个领域类型。给构造函数加 explicit，就是要求这次转换必须由调用者写清楚。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label { label: "class Distance { explicit Distance(int metres); };"; halign: start; styles [ "native-lesson-code" ] }
              Label { label: "Distance a{10};      // 可以：直接初始化，显式选择该构造函数"; halign: start; styles [ "native-lesson-code" ] }
              Label { label: "Distance b = 10;     // 编译错误：拷贝初始化不走 explicit 构造"; halign: start; styles [ "native-lesson-code" ] }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-use" ]

                Label { label: "什么时候用"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "从数字造一个有含义的类型（距离、金额、ID）时，让构造函数 explicit、调用处写 Distance{10}，隐式转换的口子就关上了。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 5. 零值 vs 未初始化
          Frame {
            label: "第三个区分：值初始化为 0，和根本没初始化";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label { label: "int a{};   // 一定是 0（值初始化）"; halign: start; styles [ "native-lesson-code" ] }
              Label { label: "int b;     // 局部变量未初始化，先读它就是未定义行为"; halign: start; styles [ "native-lesson-code" ] }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-trap" ]

                Label { label: "别踩这里"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "普通局部变量不会自动清零。读一个没写过的变量“看看它碰巧是几”不是实验，是未定义行为——结果不可复现，也可能随编译选项变化。想要零，就写 int a{}。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 6. 预测单元（由 TypeSemanticsLessonPage 填入 LearningUnitView）
          Box type_semantics_learning_unit_host {
            name: "type_semantics_learning_unit_host";
            orientation: vertical;
            hexpand: true;
          }

          // 7. 常见误区
          // 误区与选型合成一节：两者都是收尾判断，拆成两个 Frame 是形式
          // （AGENTS.md：固定组件不是模板）。
          Frame {
            label: "怎么选，以及最容易栽的四处";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-use" ]

                Label { label: "按意图选"; halign: start; styles [ "lesson-callout-title" ] }
                Label { label: "· 值必须无损进入目标类型 → 花括号 {}"; halign: start; wrap: true; xalign: 0; }
                Label { label: "· 需要调用者明确接受截断或收窄 → 圆括号 ()"; halign: start; wrap: true; xalign: 0; }
                Label { label: "· 只是想要一个零值 → int x{}"; halign: start; wrap: true; xalign: 0; }
                Label { label: "· 从数字造一个领域类型 → 构造函数写 explicit，调用处写 Type{n}"; halign: start; wrap: true; xalign: 0; }
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-trap" ]

                Label { label: "最容易栽的四处"; halign: start; styles [ "lesson-callout-title" ] }
                Label { label: "· 把花括号和圆括号当成风格偏好——它们在窄化检查上规则不同，不能随意互换。"; halign: start; wrap: true; xalign: 0; }
                Label { label: "· 以为 int x; 会得到 0——只有 int x{}、静态存储期变量或类内值初始化才保证清零。"; halign: start; wrap: true; xalign: 0; }
                Label { label: "· 以为 Distance d = 10; 会调用 explicit 构造——拷贝初始化根本不考虑 explicit 构造函数，这行直接编译失败。"; halign: start; wrap: true; xalign: 0; }
                Label { label: "· 用花括号初始化容器时忘了 initializer_list 优先——vector&lt;int&gt; v{3, 0} 是两个元素，vector&lt;int&gt; v(3, 0) 才是三个 0。"; halign: start; wrap: true; xalign: 0; }
              }

              Label {
                label: "下一节「对象生命周期」接着问：这个取得了初始状态的对象，能活到什么时候。再往后的「类型推导」里，auto x = expr 不再需要你在括号之间做选择——auto 先按初始化表达式决定 x 的类型，再谈初始化。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }

          Frame {
            label: "在真实代码里验证";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "initialization() 把四种写法和两处边界写在同一个函数里：圆括号版本能实际运行，越过花括号和 explicit 边界的写法保留成注释。先按上面的规则预测每一行输出，再打开实验逐条对照。";
                halign: start;
                wrap: true;
                xalign: 0;
                styles [ "lesson-prose" ]
              }

              Button type_semantics_run_button {
                name: "type_semantics_run_button";
                label: "打开初始化实验";
                halign: start;
                styles [ "btn-primary" ]
              }
            }
          }

          Frame {
            label: "总结：四种写法，同一个问题";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                use-markup: true;
                label: "四种写法都得到一个普通的 int，差别不在括号长相，而在<span bgcolor='#fff3cd'>谁来检查「信息会不会丢」</span>。圆括号把这个判断交给你，花括号交给编译器；explicit 决定一次转换能不能不写类型名就发生；值初始化决定对象一开始是确定的 0，还是根本没有初值。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                label: "所以读到一次初始化，问的顺序是：这个值进入目标类型会不会丢信息 → 如果会，是我明确接受，还是该让编译器拦住 → 这个对象有没有可靠的初值。三问都有答案，这一行就算读明白了。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }

          // 随堂考核挂载点：CheckpointView 由 TypeSemanticsLessonPage 填入。
          Box type_semantics_init_checkpoint_host {
            name: "type_semantics_init_checkpoint_host";
            orientation: vertical;
          }
        }
      }

      [tab]
      Label { label: "初始化"; }

      ScrolledWindow {
        hscrollbar-policy: never;
        vexpand: true;

        Box {
          orientation: vertical;
          spacing: 18;
          margin-bottom: 18;

          // 1. 为什么要判断有效期
          Frame {
            label: "引用还在，对象可能已经不在了";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "上一节解决的是对象怎样取得第一份状态。这一节接着问：对象什么时候开始存在、什么时候结束，以及一个引用能不能比它指向的对象活得更久。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-lead" ]
              }
              Label {
                label: "这是本章“查有效期”这条检查线的落点。判断错的代价很实际：访问已经结束的对象是未定义行为，程序可能照常运行一次，也可能在别的机器、别的优化级别上给出完全不同的结果。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }

          // 2. 三个时点
          Frame {
            label: "同一个函数里，三种结束时点";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              DrawingArea ts_lifetime_figure {
                  name: "ts_lifetime_figure";
                  height-request: 580;
                  hexpand: true;
                }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "① 有名字的局部对象：活到它所在的那对花括号"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "初始化完成后开始存在，离开块时按与构造相反的顺序析构。块不一定是函数体——一对花括号就够了，这也是缩短一个对象寿命的常用手段。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "② 没有名字的临时对象：活到这条语句的分号"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "临时对象在完整表达式结束时销毁，也就是分号处。它常常出现在你没写出它的地方：函数返回值、隐式转换、拼接出来的中间结果。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "③ 被 const 引用绑定的临时对象：寿命被延长"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  use-markup: true;
                  label: "把一个临时对象直接绑到 const 引用上，它会活到这个引用自己的作用域结束。这条规则让“接住一个临时结果再多用几行”成为可能，但它只对<span foreground='#052c65' weight='bold'>直接绑到临时对象或其子对象</span>的那条引用生效。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 3. 去实验里看真实的构造与析构顺序
          Frame {
            label: "去实验里看真实的构造与析构顺序";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "实验里的探针对象在构造和析构时各打印一行。进入前先预测三件事：块里依次构造的 a、b、c，离开块时按什么顺序析构？被 const 引用延长的整个临时对象，会在函数返回前还是返回后析构？直接绑子对象与经 label() 取得成员引用时，外层临时对象又分别何时析构？";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                label: "这一次的输出是程序真实运行的结果，不是编排好的示意——顺序由语言规则和实际执行共同决定。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-safe" ]
              }
              Button type_semantics_lifetime_button {
                name: "type_semantics_lifetime_button";
                label: "验证对象生命周期";
                halign: start;
                styles [ "btn-primary" ]
              }
            }
          }

          // 4. 边界
          Frame {
            label: "边界：延长规则能做什么，不能做什么";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "经成员函数返回的引用，不会延长临时对象"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "直接绑整个临时对象会延长；绑到它的子对象（例如某个成员）也会延长整个临时对象。但经成员函数返回的引用不行：const string&amp; dangling = LifetimeProbe{...}.label(); 绑到的是函数返回值，临时对象仍在分号处结束，dangling 当场悬垂。实验会运行这条声明，并用析构输出证明对象已经结束；但不会读取 dangling，因为访问它才是未定义行为。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "延长不会跨过函数边界"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "从函数里返回一个指向局部对象的引用，调用方拿到的就是失效引用；返回类型写成引用并不会让局部对象多活一秒。要把结果带出函数，返回值本身即可。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Label {
                label: "完整的绑定与返回规则在「引用」章展开，这里只要建立“先问对象还在不在”的习惯。";
                halign: start; wrap: true; xalign: 0;
                styles [ "dim-label" ]
              }
            }
          }

          // 5. 小结
          Frame {
            label: "总结：先问对象还在不在，再问能不能改";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "有名字的局部对象活到块结束，临时对象活到分号，const 引用可以把直接绑定的临时对象延长到自己的作用域结束。三者都不受“有没有人还在引用它”影响——引用不会让对象多活。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                label: "所以读到一个引用，先问<span bgcolor='#fff3cd'>使用期间原对象还在不在</span>——对象不在，后面一切都无从谈起。<span bgcolor='#fff3cd'>要不要改原对象</span>、副本还是别名，留给后面的「auto」。";
                use-markup: true;
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }

          // 随堂考核挂载点：CheckpointView 由 TypeSemanticsLessonPage 填入。
          Box type_semantics_lifetime_checkpoint_host {
            name: "type_semantics_lifetime_checkpoint_host";
            orientation: vertical;
          }
        }
      }

      [tab]
      Label { label: "对象生命周期"; }


      ScrolledWindow {
        hscrollbar-policy: never;
        vexpand: true;

        Box {
          orientation: vertical;
          spacing: 16;
          margin-bottom: 18;

          // ================= 第一单元：auto 的三种访问意图 =================

          // 1. 为什么需要 auto
          Frame {
            label: "为什么需要 auto";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "当初始化表达式已经写出了类型，再手写一遍类型往往没有增加多少信息。容器和泛型代码里的类型还可能很长；改了初始化表达式，手写的类型也要跟着改。auto 让编译器按初始化表达式推导声明里的类型部分，省掉这些重复。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-why" ]

                Label { label: "但这里还有一个问题没回答"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "“编译器知道类型”不等于“你想要什么”：你要的是一份值，还是要继续访问原来的对象？这决定了修改会不会传回原处、有没有复制、访问是否受原对象寿命限制。本节先讲清这项选择，再谈更细的推导规则。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 3. 三种写法，三种访问意图
          Frame {
            label: "三种写法，三种访问意图";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                use-markup: true;
                label: "先把两组词分清：一个整数 original 和用它的值初始化出来的另一个 int，是<b>两个对象</b>，此后改一个不会动另一个；而引用只是访问已有对象的另一个<b>名字</b>，通过它赋值改的是它绑定的那个对象。判断会不会互相影响：<span bgcolor='#fff3cd'>先数有几个对象，再看每个名字关联谁</span>。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Label { label: "int original = 42;"; halign: start; styles [ "native-lesson-code" ] }
              Label { label: "auto        copy  = original;"; halign: start; styles [ "native-lesson-code" ] }
              Label { label: "auto&       alias = original;"; halign: start; styles [ "native-lesson-code" ] }
              Label { label: "const auto& view  = original;"; halign: start; styles [ "native-lesson-code" ] }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-use" ]

                Label { label: "auto copy = original —— 取值，另建一个整数"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "声明一个新的 int，用 original 当前的值初始化，之后有自己的值。即使右边写的是这个整数的引用名字，按值推导也不会因此把 copy 变成引用。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-note" ]

                Label { label: "auto&amp; alias = original —— 你明确保留的引用意图"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "这次声明的是 int&，没有创建第二个整数。写 alias = 99 时，被改变的是 original。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-why" ]

                Label { label: "const auto&amp; view = original —— 只读的访问路径"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "声明的是 const int&。它同样访问 original，但不允许通过 view 给这个整数赋值。const 限制的是这一条访问路径，不会把 original 整个锁死——original 若经别的可写名字改变，view 再读取时也会看到新值。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 4. 让变化说明规则 —— 对象图 + 可控逐步演示
          Frame {
            label: "让变化说明规则";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "下面每次只执行一个动作：先改副本，再通过别名改原对象，最后从只读名字观察。“值相同”和“指向同一个对象”是两件事——数值刚好相同，不能说明对象相同。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                label: "概念演示：按已核对的语言规则编排，矩形表示语义对象，不代表真实内存地址或耗时。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-figure-caption" ]
              }

              DrawingArea type_semantics_deduction_graph {
                name: "type_semantics_deduction_graph";
                height-request: 400;
                hexpand: true;
              }

              Box {
                orientation: horizontal;
                spacing: 8;

                Button ts_deduction_anim_prev {
                  name: "ts_deduction_anim_prev";
                  label: "上一步";
                  styles [ "btn-outline-secondary", "btn-sm" ]
                }
                Button ts_deduction_anim_playpause {
                  name: "ts_deduction_anim_playpause";
                  label: "播放";
                  styles [ "btn-primary", "btn-sm" ]
                }
                Button ts_deduction_anim_next {
                  name: "ts_deduction_anim_next";
                  label: "下一步";
                  styles [ "btn-outline-secondary", "btn-sm" ]
                }
                Button ts_deduction_anim_reset {
                  name: "ts_deduction_anim_reset";
                  label: "重置";
                  styles [ "btn-outline-secondary", "btn-sm" ]
                }
                Label ts_deduction_anim_status {
                  name: "ts_deduction_anim_status";
                  label: "步骤 0 / 6";
                  valign: center;
                  styles [ "lesson-anim-status" ]
                }
              }

              Label ts_deduction_anim_note {
                name: "ts_deduction_anim_note";
                label: "起点：创建 original，值是 42。点“下一步”或“播放”逐步观察。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-anim-step-note" ]
              }

              Expander {
                label: "展开：每一步的静态状态表";

                Box {
                  orientation: vertical;
                  spacing: 4;
                  margin-top: 8;
                  margin-start: 6;

                  Label { label: "0 · 创建 original：一个整数对象，值 42"; halign: start; wrap: true; xalign: 0; }
                  Label { label: "1 · 初始化 copy：出现第二个整数对象 42（用旧对象的值初始化）"; halign: start; wrap: true; xalign: 0; }
                  Label { label: "2 · 绑定 alias：alias 是 original 的名字，不新增整数框"; halign: start; wrap: true; xalign: 0; }
                  Label { label: "3 · 绑定 view：view 是 original 的只读访问路径"; halign: start; wrap: true; xalign: 0; }
                  Label { label: "4 · copy = 7：copy 变 7，original 仍 42（改的是独立副本）"; halign: start; wrap: true; xalign: 0; }
                  Label { label: "5 · alias = 99：original 变 99，view 读到 99，copy 仍 7"; halign: start; wrap: true; xalign: 0; }
                  Label { label: "6 · view = 20 的边界：不能通过 view 赋值，数值不变（规则说明，不是编译器诊断）"; halign: start; wrap: true; xalign: 0; }
                }
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-note" ]

                Label { label: "走完之后"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "copy 为 7，original 为 99。alias 和 view 都访问 original，所以它们读到 99。copy 与 original 曾经同为 42，只是初始化时复制了数值，并没有建立自动同步关系。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 5. 学后小练习：由 TypeSemanticsLessonPage 填入 LearningUnitView
          Box type_semantics_deduction_unit_host {
            name: "type_semantics_deduction_unit_host";
            orientation: vertical;
            hexpand: true;
          }

          // 6. 去真实实验对照
          Frame {
            label: "去真实实验里对照";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "进入前先想好看哪里：先确认副本是否独立，再找经别名赋值的位置，最后看 const auto&amp; view 那一行读到多少。注意实验里第一条“副本 / 原对象”输出发生在两次修改之后，不代表初始化那一刻。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                label: "源码里“通过 view 赋值”被保留为注释，并附上实测的编译器诊断：它是编译期就被拒绝的写法，不是运行时能打印出来的现象。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-safe" ]
              }
              Button type_semantics_auto_button {
                name: "type_semantics_auto_button";
                label: "验证 auto";
                halign: start;
                styles [ "btn-primary" ]
              }
            }
          }

          // 7. 怎样用于真实代码 —— 选型流程图
          Frame {
            label: "怎样用于真实代码";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "先决定你希望程序做什么，再选择写法。引用把访问联系到原对象，也因此要求使用时原对象仍然存活。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-figure" ]

                DrawingArea ts_auto_selection_figure {
                  name: "ts_auto_selection_figure";
                  height-request: 620;
                  hexpand: true;
                }
                Label {
                  label: "前提写在图上：已存在且在使用期间存活的普通对象、非代理引用。";
                  halign: start; wrap: true; xalign: 0;
                  styles [ "lesson-figure-caption" ]
                }
              }

              Label {
                label: "这个判断可以带到容器里：要修改一个已存在容器中的元素，就不能误把元素复制出来再改副本；反过来，想得到一份独立数据用于尝试修改，也不应意外地保留可写别名。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-note" ]

                Label { label: "自己说依据（不必再做机械选择题）"; halign: start; styles [ "lesson-callout-title" ] }
                Label { label: "① 保存当前整数值，供以后比较"; halign: start; wrap: true; xalign: 0; }
                Label { label: "② 修改已有的那个整数"; halign: start; wrap: true; xalign: 0; }
                Label { label: "③ 观察已有整数，但禁止在本处对它赋值"; halign: start; wrap: true; xalign: 0; }
              }
            }
          }

          // 7.5 结构化绑定：同一套「副本还是别名」的选择，换一个语法出现
          // athena.json 把它列进这个知识点，实验里也有两行输出，讲解不能缺。
          Frame {
            label: "结构化绑定：同一个选择，换个写法又出现一次";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "把一个 pair、tuple 或结构体的成员一次性取出来，用的是结构化绑定。它看起来是个新语法，其实还是上面那道题：你要的是一份副本，还是原对象的别名？答案同样由 auto 后面跟不跟 &amp; 决定。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: vertical;
                spacing: 3;

                Label { label: "pair record{string(\"Athena\"), 5};"; halign: start; styles [ "native-lesson-code" ] }
                Label { label: ""; halign: start; styles [ "native-lesson-code" ] }
                Label { label: "auto  [name, score]         = record;   // 先复制整个 record，再绑到副本上"; halign: start; styles [ "native-lesson-code" ] }
                Label { label: "auto& [name_ref, score_ref] = record;   // 不复制，直接绑到 record 自己的成员"; halign: start; styles [ "native-lesson-code" ] }
              }

              Box {
                orientation: horizontal;
                spacing: 16;
                homogeneous: true;

                Box {
                  orientation: vertical;
                  spacing: 6;
                  styles [ "figure-stance", "figure-stance-auto" ]

                  Label { label: "auto [name, score]"; halign: start; styles [ "figure-stance-title", "native-lesson-code" ] }
                  Label { label: "改 score 只改副本，record.second 不动。"; halign: start; wrap: true; xalign: 0; }
                  Label { label: "复制的是整个 record，不是逐个成员分别复制——这一点在成员很大时是真实成本。"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                }

                Box {
                  orientation: vertical;
                  spacing: 6;
                  styles [ "figure-stance", "figure-stance-decltype" ]

                  Label { label: "auto&amp; [name_ref, score_ref]"; halign: start; styles [ "figure-stance-title", "native-lesson-code" ] }
                  Label { label: "改 score_ref 就是改 record.second。"; halign: start; wrap: true; xalign: 0; }
                  Label { label: "常用在遍历容器时就地修改元素：for (auto&amp; [key, value] : table)。写成 auto 就变成逐个复制再改副本，改动不会落回容器。"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                }
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-trap" ]

                Label { label: "name 和 score 不是两个新变量"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "结构化绑定引入的是这两个成员的**名字**，背后仍是那一个被绑定的对象（副本或原件）。所以「改了 score，name 会不会跟着变」这种问题不成立——它们指向的是同一个对象的两个不同成员。真正要判断的始终是：被绑定的那个对象，是副本还是原件。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Label {
                label: "实验里两种写法都有：先看 auto 那组改完之后 record 的原值有没有变，再看 auto&amp; 那组。判断依据和前面的 copy / alias 完全一样。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-safe" ]
              }
            }
          }

          Frame {
            label: "边界：两处别推广过头";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-trap" ]

                Label { label: "auto 本身不保证「深拷贝」"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "复制指针或共享所有权对象，仍可能访问同一份底层资源。这一节的对象图只解释普通 int 这个例子，不推广成所有类型的内存图。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-trap" ]

                Label { label: "只读引用也不保证对象永久存活"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "这里引用的是已经存在的 original；临时对象绑定与寿命延长是「对象生命周期」那一节的规则，本例中的引用不能在 original 销毁后继续使用。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 这一节内容最多（三种写法 + 对象图 + 结构化绑定 + 选型流程），
          // 收束单独成节：随堂考核逐题验证判断，串不起这条线。
          Frame {
            label: "总结：推导减少书写，意图仍由你表达";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                use-markup: true;
                label: "类型推导省掉的是重复书写，值、引用与只读访问的意图仍由声明表达。做选择时按「需要怎样的数据关系 → 是否修改原对象 → 复制与寿命代价」思考。两点别忘：<span bgcolor='#fff3cd'>数值相等不等于同一对象</span>，<span bgcolor='#fff3cd'>只读访问也不等于原对象被冻结</span>。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                label: "auto、auto&amp;、const auto&amp; 三种写法、容器元素的就地修改、结构化绑定——这一节从头到尾只在回答同一个问题：你要的是一份独立的数据，还是原对象的另一个名字。换了语法它也还是这个问题。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-why" ]

                Label { label: "接下来：为什么还需要 decltype"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "auto 帮你根据初始化表达式完成声明。有时要问的不是「在这里声明怎样的变量」，而是「这个名字或表达式按语言规则具有什么类型」，以便让另一处声明跟随它。decltype 提供这种类型查询，它排在本章最后，因为取类型的规则要用值类别来说明。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 换一个条件再判断，由 TypeSemanticsLessonPage 填入
          Box type_semantics_deduction_variant_host {
            name: "type_semantics_deduction_variant_host";
            orientation: vertical;
            hexpand: true;
          }

          // 随堂考核挂载点：CheckpointView 由 TypeSemanticsLessonPage 填入。
          Box type_semantics_deduction_checkpoint_host {
            name: "type_semantics_deduction_checkpoint_host";
            orientation: vertical;
          }
        }
      }

      [tab]
      Label { label: "类型推导"; }


      ScrolledWindow {
        hscrollbar-policy: never;
        vexpand: true;

        Box {
          orientation: vertical;
          spacing: 18;
          margin-bottom: 18;

          // 策略节（ADR 0031）：目标不是记住语法，而是能在具体情境里选，
          // 并说清依据和代价。所以这一页从一个真实的选择开始，不从定义开始。

          Frame {
            label: "同一组状态，两种写法";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "一个函数要报告文件的打开状态。你有两种写法，它们都能跑，区别在于编译器愿意替你挡住多少错误。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-lead" ]
              }

              Box {
                orientation: vertical;
                spacing: 3;

                Label { label: "// 写法一：整数常量"; halign: start; styles [ "native-lesson-code" ] }
                Label { label: "const int kClosed = 0;"; halign: start; styles [ "native-lesson-code" ] }
                Label { label: "const int kOpen   = 1;"; halign: start; styles [ "native-lesson-code" ] }
                Label { label: "void report(int state);"; halign: start; styles [ "native-lesson-code" ] }
                Label { label: ""; halign: start; styles [ "native-lesson-code" ] }
                Label { label: "// 写法二：作用域枚举"; halign: start; styles [ "native-lesson-code" ] }
                Label { label: "enum class FileState : unsigned char { closed, open };"; halign: start; styles [ "native-lesson-code" ] }
                Label { label: "void report(FileState state);"; halign: start; styles [ "native-lesson-code" ] }
              }

              Label {
                label: "写法二里这三行全都编译不过。函数签名从「给我一个整数」变成了「给我一个文件状态」，可取的值集合写进了类型本身。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              // 两种写法的逐行对照（ADR 0038：表格用控件，不做成图片）。
              Box {
                orientation: vertical;
                spacing: 10;
                styles [ "lesson-figure" ]

                Label {
                  label: "同一组状态，两种写法：编译器替你挡住多少";
                  halign: start;
                  styles [ "lesson-callout-title" ]
                }

                Grid {
                  column-spacing: 22;
                  row-spacing: 12;
                  styles [ "figure-table" ]

                  Label { label: "写下这一行"; halign: start; styles [ "figure-head" ] layout { column: 0; row: 0; } }
                  Box {
                    orientation: vertical; spacing: 2;
                    layout { column: 1; row: 0; }
                    Label { label: "const int 常量"; halign: start; styles [ "figure-head" ] }
                    Label { label: "void report(int);"; halign: start; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 2;
                    layout { column: 2; row: 0; }
                    Label { label: "enum class FileState"; halign: start; styles [ "figure-head" ] }
                    Label { label: "void report(FileState);"; halign: start; styles [ "figure-note" ] }
                  }

                  Separator { layout { column: 0; row: 1; column-span: 3; } }

                  Box {
                    orientation: vertical; spacing: 2; hexpand: true;
                    layout { column: 0; row: 2; }
                    Label { label: "report(42);"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "42 不是任何一个状态"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }
                  Label {
                    label: "放行 · 它只是个 int";
                    halign: start; valign: center;
                    styles [ "figure-verdict", "figure-verdict-pass" ]
                    layout { column: 1; row: 2; }
                  }
                  Label {
                    label: "编译失败";
                    halign: start; valign: center;
                    styles [ "figure-verdict", "figure-verdict-stop" ]
                    layout { column: 2; row: 2; }
                  }

                  Box {
                    orientation: vertical; spacing: 2; hexpand: true;
                    layout { column: 0; row: 3; }
                    Label { label: "report(kRed);"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "那是另一组常量里的红灯"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }
                  Label {
                    label: "放行 · 同样是 int";
                    halign: start; valign: center;
                    styles [ "figure-verdict", "figure-verdict-pass" ]
                    layout { column: 1; row: 3; }
                  }
                  Label {
                    label: "编译失败";
                    halign: start; valign: center;
                    styles [ "figure-verdict", "figure-verdict-stop" ]
                    layout { column: 2; row: 3; }
                  }

                  Box {
                    orientation: vertical; spacing: 2; hexpand: true;
                    layout { column: 0; row: 4; }
                    Label { label: "state + 1;"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "状态相加没有意义"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }
                  Label {
                    label: "放行 · 算术照做";
                    halign: start; valign: center;
                    styles [ "figure-verdict", "figure-verdict-pass" ]
                    layout { column: 1; row: 4; }
                  }
                  Label {
                    label: "编译失败";
                    halign: start; valign: center;
                    styles [ "figure-verdict", "figure-verdict-stop" ]
                    layout { column: 2; row: 4; }
                  }
                }

                Label {
                  label: "绿 = 编译器替你挡住　　红 = 编译器放行，风险留到运行期。三行代码一字未改，差别只在参数类型是 int 还是 FileState。";
                  halign: start; wrap: true; xalign: 0;
                  styles [ "lesson-prose" ]
                }
                Label {
                  label: "代价：取底层值必须写 static_cast，不能直接当下标，位运算要自己重载——严格检查的价钱。";
                  halign: start; wrap: true; xalign: 0;
                  styles [ "lesson-figure-caption" ]
                }
              }
            }
          }

          Frame {
            label: "什么时候值得给一组值独立类型";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "三条判据同时成立时，收益最明显；只满足一条时未必值得。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout" ]

                Label { label: "① 这组值要跨接口传递"; halign: start; styles [ "lesson-callout-title" ] }
                Label { label: "签名要替你说清「这里只接受这几个值」，调用方才不必回头翻文档。"; halign: start; wrap: true; xalign: 0; }
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout" ]

                Label { label: "② 值本身没有算术意义"; halign: start; styles [ "lesson-callout-title" ] }
                Label { label: "两个状态相加、状态乘二都不代表任何东西。既然没意义，就该让它编译不过。"; halign: start; wrap: true; xalign: 0; }
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout" ]

                Label { label: "③ 你希望编译器挡住来自别处的同类整数"; halign: start; styles [ "lesson-callout-title" ] }
                Label { label: "红灯是 3、打开也是 1，裸整数分不出它们属于哪一组；独立类型能。"; halign: start; wrap: true; xalign: 0; }
              }

              Label {
                label: "代价也要一起算：拿底层值必须显式写 static_cast，不能直接当数组下标，位运算需要你自己重载运算符。这些不是缺陷，是它换来严格检查所付的价钱。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }

          Frame {
            label: "换三个情境，自己判断";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "答案不是清一色的「用」。先自己判断，再看后面的说明。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-lead" ]
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "情境一：协议里的状态字段，要在解析、校验、日志三个模块间传递"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "该用。三条判据全中：跨接口传、没有算术意义、最怕和别处的整数串味。协议编解码那一层做一次显式转换，代价只付在边界上。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "情境二：用状态值直接索引一张查找表"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "可以用，但要想清楚。每次索引都得写 static_cast，如果索引就是这组值的主要用途，收益就被样板代码抵消了一部分。折中做法是保留 enum class，配一个 to_index 函数把转换收在一处。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "情境三：可组合的权限位（读、写、执行，要按位取并）"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "不方便。作用域枚举默认不支持按位运算，要自己重载运算符才能组合；而且「组合出来的值」本来就不在枚举列出的取值里。这正是它的代价所在——不是所有整数常量集合都该改成 enum class。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 学后确认题，由 TypeSemanticsLessonPage 填入
          Box type_semantics_enum_unit_host {
            name: "type_semantics_enum_unit_host";
            orientation: vertical;
            hexpand: true;
          }

          Frame {
            label: "去实验里核对";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "实验分两段。先看裸整数放行了什么：取组外的 42、两个状态相加、红灯和「已打开」被判为相等——三件都没有意义，编译器一件都不拦。再看换成作用域枚举之后，同样三件事全部编译不过，而隐式转成 int 也被挡下，取底层值必须显式写 static_cast。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                label: "两处要留意：「上面三件事都编译不过」是规则说明，不是程序跑出来的——那三行在源文件里是注释，因为它们根本编译不过；最后一行的 static_cast&lt;FileState&gt;(42) 却真的跑了出来，得到一个不在 closed / open 之列的值，这正是「它挡的是意外，不是错误」。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-safe" ]
              }
              Button type_semantics_enum_button {
                name: "type_semantics_enum_button";
                label: "验证 enum class";
                halign: start;
                styles [ "btn-primary" ]
              }
            }
          }

          // 这一节难度 1、内容最少，总结与边界合在一处够用；标题以结论为主，
          // 让读者认得出这是落点（AGENTS.md：形式按内容定，不是套模板）。
          Frame {
            label: "总结：先问这组值要不要跨接口";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "要跨接口传递、没有算术意义、怕和别处的整数混淆——三条都占，就给它独立类型；只是函数内部临时区分几个分支，裸整数或普通枚举也够用。代价是每次跨越类型边界都要显式转换，把这些转换收在协议解析、表索引这样明确的一两处，比散着写划算。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout", "lesson-callout-trap" ]

                Label { label: "它不保证值域完整"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "static_cast<FileState>(42) 能编译，得到一个不在 closed / open 里的值，之后拿它 switch、索引都不再受保护。所以从协议字节、配置文件、用户输入转进枚举时，范围检查得自己在转换点做。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 随堂考核挂载点：CheckpointView 由 TypeSemanticsLessonPage 填入。
          Box type_semantics_enum_checkpoint_host {
            name: "type_semantics_enum_checkpoint_host";
            orientation: vertical;
          }
        }
      }

      [tab]
      Label { label: "enum class"; }


      ScrolledWindow {
        hscrollbar-policy: never;
        vexpand: true;

        Box {
          orientation: vertical;
          spacing: 18;
          margin-bottom: 18;

          // 策略节（ADR 0031）：四种命名转换不按语法罗列，按"你相信什么"来选。
          // 主线是"检查发生在哪一层"，不是"记住四个关键字"。

          // 大纲「转换与边界」第一条承诺的是隐式转换，它排在显式转换之前：
          // 你没写转换的地方，转换照样在发生。

          Frame {
            label: "你没写转换的地方，转换也在发生";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "先说不用写就会发生的那一类。函数传参、赋值、混合类型运算，编译器都会自己插入转换——代码里看不到任何转换的痕迹，值却已经变了。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-lead" ]
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "范围：目标类型装不下"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "大整数赋给小整数类型时高位被丢掉。这类转换本身是良定义的：无符号类型按 2^N 取模（300 存进 unsigned char 得到 44），C++20 起转换到有符号类型同样良定义（标准要求二进制补码表示，按同余取值）。良定义不等于安全——值已经不是原来那个了，而编译器一声不吭。真正的未定义行为是有符号数的算术溢出，比如 INT_MAX + 1，那是另一回事。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "符号：有符号和无符号混在一起比较"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "-1 < 1u 的结果是 false。比较之前 -1 被转成了一个极大的无符号数——这是循环条件里最经典的一类 bug，写的人以为在比较大小，实际比较的是转换之后的两个值。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "精度：浮点与整数之间"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "浮点转整数直接截断小数部分，不是四舍五入；反过来把大整数转成 float 也可能丢掉低位有效数字，因为 float 的有效位数有限。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Label {
                label: "花括号初始化能把这三类里的窄化拦在编译期——这是「初始化」那一节讲过的判断，在这里换了个角度：初始化形式的选择，本身就是在决定隐式转换要不要被检查。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }

          Frame {
            label: "检查发生在哪一层";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "这是本节的主线。同样是「转换成功了」，保证的强度完全不同：";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: vertical;
                spacing: 3;

                Grid {
                  column-spacing: 22;
                  row-spacing: 14;
                  styles [ "figure-table" ]

                  Label { label: "怎么写出来的"; halign: start; styles [ "figure-head" ] layout { column: 0; row: 0; } }
                  Label { label: "你在声明什么意图"; halign: start; styles [ "figure-head" ] layout { column: 1; row: 0; } }
                  Label { label: "谁来检查"; halign: start; styles [ "figure-head" ] layout { column: 2; row: 0; } }

                  Separator { layout { column: 0; row: 1; column-span: 3; } }

                  Box {
                    orientation: vertical; spacing: 2;
                    layout { column: 0; row: 2; }
                    Label { label: "（不写）"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "隐式转换"; halign: start; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 2; hexpand: true;
                    layout { column: 1; row: 2; }
                    Label { label: "你什么也没声明，它自己发生了"; halign: start; wrap: true; xalign: 0; styles [ "figure-cell" ] }
                    Label { label: "传参、赋值、算术提升时随处可见"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 4; valign: center;
                    layout { column: 2; row: 2; }
                    Label {
                      label: "不检查，而且不显眼";
                      halign: start;
                      styles [ "figure-verdict", "figure-verdict-pass" ]
                    }
                    Label { label: "代码里搜不到，最难复查"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }

                  Box {
                    orientation: vertical; spacing: 2;
                    layout { column: 0; row: 3; }
                    Label { label: "static_cast"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "最常用的一种"; halign: start; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 2; hexpand: true;
                    layout { column: 1; row: 3; }
                    Label { label: "这两个类型确实相关，按规则转过去"; halign: start; wrap: true; xalign: 0; styles [ "figure-cell" ] }
                    Label { label: "数值类型之间、继承体系里向上转"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 4; valign: center;
                    layout { column: 2; row: 3; }
                    Label {
                      label: "编译期：类型关系";
                      halign: start;
                      styles [ "figure-verdict", "figure-verdict-compile" ]
                    }
                    Label { label: "范围与精度仍由你保证"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }

                  Box {
                    orientation: vertical; spacing: 2;
                    layout { column: 0; row: 4; }
                    Label { label: "dynamic_cast"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "唯一会真查的一种"; halign: start; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 2; hexpand: true;
                    layout { column: 1; row: 4; }
                    Label { label: "我不确定它到底是哪个派生类，帮我查"; halign: start; wrap: true; xalign: 0; styles [ "figure-cell" ] }
                    Label { label: "多态类型的向下转换"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 4; valign: center;
                    layout { column: 2; row: 4; }
                    Label {
                      label: "运行期：真实类型";
                      halign: start;
                      styles [ "figure-verdict", "figure-verdict-runtime" ]
                    }
                    Label { label: "失败给 nullptr 或抛异常，有开销"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }

                  Box {
                    orientation: vertical; spacing: 2;
                    layout { column: 0; row: 5; }
                    Label { label: "const_cast"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "改的是访问路径"; halign: start; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 2; hexpand: true;
                    layout { column: 1; row: 5; }
                    Label { label: "这条路径上的 const 由我负责去掉"; halign: start; wrap: true; xalign: 0; styles [ "figure-cell" ] }
                    Label { label: "对接不带 const 的旧接口"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 4; valign: center;
                    layout { column: 2; row: 5; }
                    Label {
                      label: "不检查：前提你担保";
                      halign: start;
                      styles [ "figure-verdict", "figure-verdict-unchecked" ]
                    }
                    Label { label: "对象本来是 const 就是未定义行为"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }

                  Box {
                    orientation: vertical; spacing: 2;
                    layout { column: 0; row: 6; }
                    Label { label: "reinterpret_cast"; halign: start; styles [ "native-lesson-code" ] }
                    Label { label: "最后才考虑"; halign: start; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 2; hexpand: true;
                    layout { column: 1; row: 6; }
                    Label { label: "把这段内存按另一种类型重新解释"; halign: start; wrap: true; xalign: 0; styles [ "figure-cell" ] }
                    Label { label: "和硬件、协议字节打交道"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }
                  Box {
                    orientation: vertical; spacing: 4; valign: center;
                    layout { column: 2; row: 6; }
                    Label {
                      label: "不检查：连关系都不看";
                      halign: start;
                      styles [ "figure-verdict", "figure-verdict-unchecked" ]
                    }
                    Label { label: "平台相关，最容易出错"; halign: start; wrap: true; xalign: 0; styles [ "figure-note" ] }
                  }
                }

                Label {
                  label: "底色 = 编译器替你把关到哪一步：蓝 编译期查类型关系 · 绿 运行期查真实类型 · 黄 不查但意图写在代码里 · 红 不查且代码里看不见。";
                  halign: start; wrap: true; xalign: 0;
                  styles [ "lesson-prose" ]
                }
                Label {
                  label: "四种命名转换各自写出来，为的就是让意图留在代码里、能被搜索到——C 风格的 (int)x 会自己挑一种，读的人看不出是哪种。";
                  halign: start; wrap: true; xalign: 0;
                  styles [ "lesson-figure-caption" ]
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "C 风格的 (int)x 属于哪一层？"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "它会依次尝试上面几种，选第一个说得通的——也就是说读代码的人无法从写法看出这次转换到底属于哪种意图，也无法搜索出代码库里所有的危险转换。四种命名转换分开，正是为了让意图留在代码里。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          Frame {
            label: "换三个片段，自己判断";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "先想清楚你相信什么、谁来检查，再选。其中一个片段的答案不是四选一。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-lead" ]
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "片段一：拿到 Shape*，想调用 Circle 特有的方法"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "用 dynamic_cast，并检查返回值。你不确定它是不是 Circle，这正是运行期检查存在的理由。用 static_cast 也能编译，但猜错时不会有任何提示，之后的调用直接进入未定义行为。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "片段二：秒数存成 double，要传给只收 int 的旧接口"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "用 static_cast，并在转换点想清楚小数部分怎么办。转换本身是合法的数值转换，编译器会放行；「9.8 变成 9」这个后果不是编译器该管的事，是你要在这一行决定的——四舍五入还是直接截断，取决于业务。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "片段三：一个函数收 const 引用，你却想在里面改它"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "根本不该转换，应该改接口。const_cast 能让它编译通过，但函数签名承诺了「我不改你的东西」，转换只是把违背承诺的事藏起来；而且一旦调用方传来的真是 const 对象，写入就是未定义行为。需要修改就把参数改成非 const 引用，让签名说实话。const_cast 的合理场景很窄——比如调用一个你无法修改的、忘记标 const 的旧 API。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 学后确认题，由 TypeSemanticsLessonPage 填入
          Box type_semantics_cast_unit_host {
            name: "type_semantics_cast_unit_host";
            orientation: vertical;
            hexpand: true;
          }

          Frame {
            label: "去实验里核对";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "实验先看不用写的那一类：-1 < 1u 为什么是假、300 存进 unsigned char 变成多少。再看四种命名转换：static_cast 把 9.8 截成 9、dynamic_cast 对匹配类型成功而对不匹配的返回空、const_cast 修改一个本来就可写的对象、reinterpret_cast 指针往返后仍相等。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                label: "注意最后一行「往返相等不证明按其它类型解读一直安全」——指针能转回来是这一次的观察结果，不能推广成「这样解读内存总是安全」。实验只展示可观察的合法边界，不把未定义行为包装成可运行示例。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-safe" ]
              }
              Button type_semantics_cast_button {
                name: "type_semantics_cast_button";
                label: "验证类型转换";
                halign: start;
                styles [ "btn-primary" ]
              }
            }
          }

          Frame {
            label: "边界：写出了转换，不等于转换安全";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout", "lesson-callout-trap" ]

                Label { label: "编译通过只说明关系成立，不说明值合理"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "static_cast&lt;int&gt;(1e18) 编译没问题，结果却超出 int 能表示的范围；上一节那个 static_cast&lt;FileState&gt;(42) 也一样。范围检查从来不在转换里，得你自己在转换点做。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout", "lesson-callout-trap" ]

                Label { label: "转换是信号，不是解决方案"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "代码里频繁出现转换，通常说明类型设计没表达清楚意图——该用独立类型的地方用了裸整数，该改接口的地方用了 const_cast。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          Frame {
            label: "总结：先问能不能不转，再问谁来检查";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "四种命名转换按「你相信什么」区分：相信数值或继承关系用 static_cast，不确定就交给 dynamic_cast 在运行期查，只想去掉访问路径上的 const 用 const_cast，要重新解读位模式才用 reinterpret_cast。能用检查更严的就不用更松的。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                use-markup: true;
                label: "写下转换就是接手了它的全部前提：编译期检查只保证关系存在，<span bgcolor='#fff3cd'>值是否合理、对象是否真的可写、按新类型解读是否有意义，全都由你保证</span>。所以两个问题的顺序是——先问这次转换能不能通过改类型或改接口来避免，再问该用哪一种。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }

          // 随堂考核挂载点：CheckpointView 由 TypeSemanticsLessonPage 填入。
          Box type_semantics_cast_checkpoint_host {
            name: "type_semantics_cast_checkpoint_host";
            orientation: vertical;
          }
        }
      }

      [tab]
      Label { label: "类型转换"; }


      ScrolledWindow {
        hscrollbar-policy: never;
        vexpand: true;

        Box {
          orientation: vertical;
          spacing: 18;
          margin-bottom: 18;

          // 概念节（ADR 0031）：目标是辨清边界，主线是正反例并排 + 分类判断。
          // 值类别天然是「有身份 × 可移动」的二维划分，按 ADR 0033 做成可点击
          // 切换的分类器——选一个表达式，看它落在哪一格、能绑到哪种引用。

          Frame {
            label: "表达式有两个属性，类型只是其中一个";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "看一个表达式，先问它是什么类型；但光有类型还不够——同样是 int，有的表达式指向一个你能取地址、能反复访问的对象，有的只是算出来就没了的中间结果。这个区别叫值类别，它决定这个表达式能绑到哪种引用、重载时选中哪一个。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-lead" ]
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "两个问题定三类"; halign: start; styles [ "lesson-callout-title" ] }
                Label { label: "① 它有身份吗——能不能取地址、能不能在后面再访问同一个对象？"; halign: start; wrap: true; xalign: 0; }
                Label { label: "② 它可以被移动吗——它的资源能不能被搬走而不影响别人？"; halign: start; wrap: true; xalign: 0; }
                Label { label: "有身份不可移动是左值，有身份且可移动是将亡值，无身份可移动是纯右值。第四种组合（无身份又不可移动）没有意义，所以只有三类。"; halign: start; wrap: true; xalign: 0; }
              }

              Label {
                label: "关键在于：值类别是表达式的属性，不是对象的属性。同一个对象出现在不同表达式里，值类别可以完全不同——这一点没分清，后面关于引用绑定和重载的判断都会跟着错。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }

          Frame {
            label: "同一个对象，换个表达式试试";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "下面每个表达式都牵涉同一个对象 value。点一个，看它落在哪一格、能绑到哪种引用。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: horizontal;
                spacing: 8;
                halign: start;

                Button ts_vc_expr_named { name: "ts_vc_expr_named"; label: "value"; styles [ "btn-outline-primary", "btn-sm" ] }
                Button ts_vc_expr_move { name: "ts_vc_expr_move"; label: "std::move(value)"; styles [ "btn-outline-primary", "btn-sm" ] }
                Button ts_vc_expr_calc { name: "ts_vc_expr_calc"; label: "value + 0"; styles [ "btn-outline-primary", "btn-sm" ] }
                Button ts_vc_expr_named_rref { name: "ts_vc_expr_named_rref"; label: "具名的 int&& r"; styles [ "btn-outline-primary", "btn-sm" ] }
              }

              // 二维分类矩阵由代码绘制：高亮哪一格由当前选择决定，属于结构随
              // 运行时状态改变的绘制（AGENTS.md GTK 规则第 2、3 条）。
              DrawingArea ts_vc_matrix {
                name: "ts_vc_matrix";
                height-request: 420;
                hexpand: true;
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label ts_vc_result_title {
                  name: "ts_vc_result_title";
                  label: "先选一个表达式";
                  halign: start;
                  styles [ "lesson-callout-title" ]
                }
                Label ts_vc_result_detail {
                  name: "ts_vc_result_detail";
                  label: "矩阵会高亮它所在的格子，并说明它能绑到哪种引用。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          Frame {
            label: "边界：三个几乎人人都踩过的地方";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "有名字的右值引用，本身是左值"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "写下 int&& r = std::move(value); 之后，表达式 r 是左值——它有名字、能取地址、能反复用。「r 的类型是右值引用」和「表达式 r 是什么值类别」是两个问题。所以想让它继续以右值身份传下去，必须再写一次 std::move(r)。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "将亡值不等于「马上要销毁」"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "将亡值说的是「这个表达式允许把资源搬走」，不是「这个对象即将消失」。value 在 std::move(value) 之后照样活到作用域结束——资源是否真被搬走，取决于接收它的那个函数做了什么。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label { label: "std::move 自己不移动任何东西"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "它只是一次类型转换，把表达式变成将亡值——变的是「重载时选哪个」，不是内存里发生了什么。真正的移动怎样发生，留到「RAII 与资源管理」。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 学后确认题，由 TypeSemanticsLessonPage 填入
          Box type_semantics_value_unit_host {
            name: "type_semantics_value_unit_host";
            orientation: vertical;
            hexpand: true;
          }

          Frame {
            label: "去实验里核对";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "实验用一组重载把值类别显示出来：同一个对象，分别以具名表达式、只读表达式、临时对象和 std::move 的形式传进去，看每次选中的是 string&、const string& 还是 string&&。选中的重载不同，就是值类别不同的直接证据。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                label: "重点看两处：std::move 之后选中了 string&&，而对象本身并没有被搬走；以及具名的右值引用再传出去时，选中的是左值那一版。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-safe" ]
              }
              Button type_semantics_value_category_button {
                name: "type_semantics_value_category_button";
                label: "验证值类别";
                halign: start;
                styles [ "btn-primary" ]
              }
            }
          }

          Frame {
            label: "总结：先问有没有身份，再问能不能搬走";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "判断一个表达式：能取地址、后面还能再访问同一个对象，就是左值；算出来就没了的中间结果是纯右值；用 std::move 或返回右值引用把一个有身份的对象标成「可以搬走」，得到将亡值。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                label: "这一节到能判断三类、能说明它影响哪种绑定就够了。规则密度高的部分（引用折叠、完美转发）等写模板时再回来——那时你会需要这套判断，而现在不会。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }

          // 随堂考核挂载点：CheckpointView 由 TypeSemanticsLessonPage 填入。
          Box type_semantics_value_checkpoint_host {
            name: "type_semantics_value_checkpoint_host";
            orientation: vertical;
          }
        }
      }

      [tab]
      Label { label: "值类别"; }


      ScrolledWindow {
        hscrollbar-policy: never;
        vexpand: true;

        Box {
          orientation: vertical;
          spacing: 16;
          margin-bottom: 18;

          // decltype：本章最后一个方向，先修是 auto 与值类别。掌握目标只是
          // 「一般了解」（difficulty 4 / familiar），所以这一节刻意写得短：
          // 讲清它解决哪类问题、和 auto 的分工、两条规则，知道规则有边界就够了。
          // 泛型里的细节等真写模板时再回来补。

          // 1. 问题 + 立场对照（原先拆成"auto 答不了的问题"和"两种立场"两节，
          //    讲的是同一件事）
          Frame {
            label: "auto 答不了的那类问题";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "auto 解决的是「这里的类型我不想再写一遍」。但有一类问题它答不了：我要让这一处的类型精确跟着别处的某个名字或表达式走，而那个类型我根本写不出来——它可能依赖模板参数，可能是别人接口的返回类型，也可能以后会改。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-lead" ]
              }

              Box {
                orientation: vertical;
                spacing: 3;

                Label { label: "const int&amp; pick();               // 别人写的接口，返回类型以后可能变"; halign: start; styles [ "native-lesson-code" ] }
                Label { label: "auto            a = pick();     // int：复制了一份，和 pick 的返回类型脱钩"; halign: start; styles [ "native-lesson-code" ] }
                Label { label: "decltype(pick()) k = pick();     // const int&amp;：pick 改了，这里跟着改"; halign: start; styles [ "native-lesson-code" ] }
              }

              Label {
                label: "差别不在语法细节，在提问的立场。同一个 const int&amp; ref：";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: horizontal;
                spacing: 16;
                homogeneous: true;

                Box {
                  orientation: vertical;
                  spacing: 6;
                  styles [ "figure-stance", "figure-stance-auto" ]

                  Label { label: "auto copy = ref;"; halign: start; styles [ "figure-stance-title", "native-lesson-code" ] }
                  Label { label: "问：我要声明一个什么样的新变量？新变量默认独立、可写，所以引用和顶层 const 都被丢掉。"; halign: start; wrap: true; xalign: 0; }
                  Label { label: "int　（独立副本，可写）"; halign: start; styles [ "figure-result" ] }
                }

                Box {
                  orientation: vertical;
                  spacing: 6;
                  styles [ "figure-stance", "figure-stance-decltype" ]

                  Label { label: "decltype(ref)"; halign: start; styles [ "figure-stance-title", "native-lesson-code" ] }
                  Label { label: "问：ref 按语言规则是什么类型？如实转述，连你不想要的部分也一并带上。"; halign: start; wrap: true; xalign: 0; }
                  Label { label: "const int&amp;　（原样保留）"; halign: start; styles [ "figure-result" ] }
                }
              }

              Box {
                orientation: vertical;
                spacing: 4;
                styles [ "lesson-callout", "lesson-callout-why" ]

                Label { label: "它问的是类型，不执行表达式"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "decltype(pick()) 里的 pick 不会被调用——不求值语境只按规则算类型，不产生任何运行时动作。所以它能出现在还没有对象、函数只有声明没有定义的地方，比如函数的返回类型位置。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 2. 规则本体：两条，够用
          Frame {
            label: "两条规则：名字看声明，表达式看值类别";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 16;
              margin-bottom: 16;
              margin-start: 18;
              margin-end: 18;

              Box {
                orientation: horizontal;
                spacing: 12;
                homogeneous: true;

                Box {
                  orientation: vertical;
                  spacing: 4;
                  styles [ "lesson-callout", "lesson-callout-why" ]

                  Label { label: "decltype(value)  →  int"; halign: start; styles [ "lesson-callout-title" ] }
                  Label { label: "未加括号的名字：取这个实体的声明类型，写的是什么就是什么。"; halign: start; wrap: true; xalign: 0; }
                }

                Box {
                  orientation: vertical;
                  spacing: 4;
                  styles [ "lesson-callout", "lesson-callout-note" ]

                  Label { label: "decltype((value))  →  int&amp;"; halign: start; styles [ "lesson-callout-title" ] }
                  Label { label: "加了括号就不再是实体名，而是表达式：按值类别取类型，左值得 T&amp;、将亡值得 T&amp;&amp;、纯右值得 T。"; halign: start; wrap: true; xalign: 0; }
                }
              }

              Label {
                label: "为什么借引用记号？因为 int 这个类型本身不说明「它指向一个已有对象，还是算完就没了」，而值类别正是这条信息。decltype 要把表达式完整转述出来，就用 T&amp; 记下左值、T&amp;&amp; 记下将亡值——上一节的分类，在类型系统里的写法。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }

          // 3. 活对照：五个表达式挨个问一遍。结果由上面两条规则直接算出来，
          //    做成可切换而不是静态表（ADR 0033）。
          Frame {
            label: "同一批声明，挨个问一遍";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Box {
                orientation: vertical;
                spacing: 3;

                Label { label: "int        value = 42;"; halign: start; styles [ "native-lesson-code" ] }
                Label { label: "const int  fixed = 7;"; halign: start; styles [ "native-lesson-code" ] }
                Label { label: "const int&amp; ref   = fixed;"; halign: start; styles [ "native-lesson-code" ] }
              }

              Label {
                label: "点一个表达式，先自己按两条规则算一遍再看答案。五个问下来，auto 每次都是 int，decltype 给出四种不同的答案——它们不是同一个工具的两种写法。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }

              Box {
                orientation: horizontal;
                spacing: 8;
                halign: start;

                Button ts_dt_expr_named { name: "ts_dt_expr_named"; label: "value"; styles [ "btn-outline-primary", "btn-sm" ] }
                Button ts_dt_expr_paren { name: "ts_dt_expr_paren"; label: "(value)"; styles [ "btn-outline-primary", "btn-sm" ] }
                Button ts_dt_expr_ref { name: "ts_dt_expr_ref"; label: "ref"; styles [ "btn-outline-primary", "btn-sm" ] }
                Button ts_dt_expr_prvalue { name: "ts_dt_expr_prvalue"; label: "value + 0"; styles [ "btn-outline-primary", "btn-sm" ] }
                Button ts_dt_expr_xvalue { name: "ts_dt_expr_xvalue"; label: "std::move(value)"; styles [ "btn-outline-primary", "btn-sm" ] }
              }

              Box {
                orientation: horizontal;
                spacing: 12;
                homogeneous: true;

                Box {
                  orientation: vertical;
                  spacing: 4;
                  styles [ "lesson-callout", "lesson-callout-note" ]

                  Label { label: "auto x = …"; halign: start; styles [ "lesson-callout-title" ] }
                  Label ts_dt_auto_result {
                    name: "ts_dt_auto_result";
                    label: "—";
                    halign: start; wrap: true; xalign: 0;
                    styles [ "native-lesson-code" ]
                  }
                }

                Box {
                  orientation: vertical;
                  spacing: 4;
                  styles [ "lesson-callout", "lesson-callout-why" ]

                  Label { label: "decltype(…)"; halign: start; styles [ "lesson-callout-title" ] }
                  Label ts_dt_decltype_result {
                    name: "ts_dt_decltype_result";
                    label: "—";
                    halign: start; wrap: true; xalign: 0;
                    styles [ "native-lesson-code" ]
                  }
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout" ]

                Label ts_dt_result_title {
                  name: "ts_dt_result_title";
                  label: "先选一个表达式";
                  halign: start;
                  styles [ "lesson-callout-title" ]
                }
                Label ts_dt_result_detail {
                  name: "ts_dt_result_detail";
                  label: "两列会给出各自的结果，下面说明它套用的是哪一条规则。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 4. 边界：三处会改变程序行为的，加一句"规则不止这两条"
          Frame {
            label: "边界：三处会咬人的地方";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout", "lesson-callout-trap" ]

                Label { label: "括号不是排版，是语义"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "把返回类型写成 decltype((local))，返回的就是局部对象的引用——函数一结束对象就没了，调用方拿到悬垂引用。多敲的那对括号在这里改变的是程序行为。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout", "lesson-callout-trap" ]

                Label { label: "具名右值引用：两条规则问的不是同一件事"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "int&amp;&amp; r = std::move(value); 之后，decltype(r) 是 int&amp;&amp;（名字规则取声明类型），但表达式 r 自己是左值，传给重载会选中左值那一版。「声明成什么」和「作为表达式是什么值类别」是两个问题。";
                  halign: start; wrap: true; xalign: 0;
                }
              }

              Box {
                orientation: vertical;
                spacing: 6;
                styles [ "lesson-callout", "lesson-callout-note" ]

                Label { label: "这两条规则不是全部"; halign: start; styles [ "lesson-callout-title" ] }
                Label {
                  label: "结构化绑定、类成员访问等场景另有约定。这一节到「知道 decltype 解决哪类问题、和 auto 分工在哪」就够了——遇到规则边界时意识到要回去查，比背下几条更要紧。";
                  halign: start; wrap: true; xalign: 0;
                }
              }
            }
          }

          // 5. 学后预测：由 TypeSemanticsLessonPage 填入 LearningUnitView
          Box type_semantics_decltype_unit_host {
            name: "type_semantics_decltype_unit_host";
            orientation: vertical;
            hexpand: true;
          }

          // 6. 去实验里核对
          Frame {
            label: "去实验里核对";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 12;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "进入前先预测两件事：decltype(value) 和 decltype((value)) 各自声明出来的变量，改动它时 value 会不会跟着变；以及从 const 引用出发，auto 和 decltype 分别落到什么类型。实验用赋值后的数值变化把类型差异显示出来——别名会把改动传回原对象，副本不会。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                label: "不求值语境和 const 引用不能赋值都是编译期的事，不会出现在输出里，源码里保留成注释——判断依据是「编译过不过」，不是「打印了什么」。";
                halign: start; wrap: true; xalign: 0;
                styles [ "native-lesson-safe" ]
              }
              Button type_semantics_decltype_button {
                name: "type_semantics_decltype_button";
                label: "验证 decltype";
                halign: start;
                styles [ "btn-primary" ]
              }
            }
          }

          // 这一节的收束。随堂考核逐题验证单点判断，给不了"两条规则怎么串成
          // 一个判断动作"和"学到哪里为止"——那正是这一节掌握目标只到「一般
          // 了解」时最需要说清的东西，所以小结和考核并存，不是二选一。
          Frame {
            label: "总结：先看括号，再看它问的是谁";
            styles [ "panel-frame", "group-frame" ]

            Box {
              orientation: vertical;
              spacing: 10;
              margin-top: 14;
              margin-bottom: 14;
              margin-start: 18;
              margin-end: 18;

              Label {
                label: "拿到一个 decltype，判断分两步：先看有没有多那层括号——没有就是名字，取它的声明类型；有就成了表达式，按值类别取，左值 T&amp;、将亡值 T&amp;&amp;、纯右值 T。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                use-markup: true;
                label: "和 auto 的分工按你要什么来选：<span bgcolor='#fff3cd'>要一份可以单独动的新数据，用 auto</span>；<span bgcolor='#fff3cd'>要这一处的类型跟着别处走、连引用和 const 一起保留，用 decltype</span>。auto 站在新变量的立场，decltype 站在「它本来是什么」的立场。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
              Label {
                label: "这一节到此为止：能说出它解决哪类问题、和 auto 分工在哪、两条规则各管什么，就达到了本章对它的要求。引用折叠、完美转发、decltype(auto) 这些要等「模板、泛型与编译期」那一章真正写泛型代码时再回来补——那时你会需要这套判断，现在不会。";
                halign: start; wrap: true; xalign: 0;
                styles [ "lesson-prose" ]
              }
            }
          }

          // 随堂考核挂载点：CheckpointView 由 TypeSemanticsLessonPage 填入。
          Box type_semantics_decltype_checkpoint_host {
            name: "type_semantics_decltype_checkpoint_host";
            orientation: vertical;
          }
        }
      }

      [tab]
      Label { label: "decltype"; }


  }
}
