{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "athena-operating-system",
  "version": "0.1.0",
  "identifier": "cn.athena.operating-system",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1492",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "操作系统",
        "width": 1600,
        "height": 1000,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../content"]
  }
}
