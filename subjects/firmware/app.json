{
  "id": "firmware",
  "title": "嵌入式程序设计",
  "group": "电子信息",
  "description": "嵌入式系统设计师第 6、8、11 章的实践课程：嵌入式 C 位操作/寄存器真编译真跑，下午题 C 填空真验证。按 ADR 0103 从 embedded 独立成挂靠子应用，可单独使用。",
  "icon": {
    "type": "theme",
    "name": "firmware-symbolic",
    "symbol": "curlybraces.square",
    "letter": "嵌",
    "accent": "#5A2A8A",
    "file": "icon.svg",
    "renders": {
      "src-tauri/icons/32x32.png": 32,
      "src-tauri/icons/128x128.png": 128,
      "src-tauri/icons/128x128@2x.png": 256,
      "src-tauri/icons/icon.png": 512,
      "src-tauri/icons/icon.ico": "ico",
      "src-tauri/icons/icon.icns": "icns"
    }
  },
  "dev": {
    "prepare": [
      {
        "when_missing": "node_modules",
        "run": ["npm", "install"],
        "label": "安装前端依赖"
      }
    ],
    "run": ["npm", "run", "tauri:dev"],
    "ready": { "http": "http://localhost:1494" },
    "match": "src-tauri/target",
    "binary": "athena-firmware"
  }
}
