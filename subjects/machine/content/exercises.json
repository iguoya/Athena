  "machine.asm.basics.operands": {
    "intro": "核的是内存操作数 基址 + 下标×缩放 + 偏移 的计算和限制（Intel SDM Vol.1 §3.7.5、DIS §7.1.4），以及两种写法的对应（GNU as 手册）。",
    "in_class": [
      {
        "stem": "内存操作数 基址 + 下标×缩放 + 偏移 里，缩放（scale）可以取哪些值？",
        "choices": [
          "1、2、4、8",
          "任意整数",
          "只能是 4",
          "2 的任意次幂"
        ],
        "correct": 0,
        "explain": "GNU as 手册 i386-Memory：scale 取 1、2、4、8，不写就是 1。Intel SDM Vol.1 §3.7.5 同样只列出 2、4、8（以及不用缩放）。",
        "source_refs": [
          {
            "relation": "adapted",
            "source_id": "gnu-as",
            "locator": "i386-Memory"
          },
          {
            "relation": "adapted",
            "source_id": "intel-sdm",
            "locator": "Vol.1 §3.7.5 Specifying an Offset"
          }
        ],
        "difficulty": 1,
        "goal": "master"
      },
      {
        "stem": "下面哪一条是合法的 x86-64 指令形式？（Intel 写法）",
        "choices": [
          "mov [rbx], [rcx]",
          "mov 5, eax",
          "mov eax, [rbx]",
          "mov [rbx+rcx*3], eax"
        ],
        "correct": 2,
        "explain": "DIS §7.1.4：内存形式不能同时当一条指令的源和目的，所以第一条不行；常数不能当目的操作数，所以第二条不行；缩放只能是 1、2、4、8，第四条的 3 不行。",
        "source_refs": [
          {
            "relation": "adapted",
            "source_id": "dis",
            "locator": "Ch.7 §7.1.4 An Example with Operands"
          },
          {
            "relation": "adapted",
            "source_id": "gnu-as",
            "locator": "i386-Memory"
          }
        ],
        "difficulty": 2,
        "goal": "master"
      }
    ],
    "homework": [
      {
        "stem": "设 rbx = 0x2000，rcx = 3。指令 mov eax, dword ptr [rbx + rcx*4 + 8] 读取的内存地址是多少？",
