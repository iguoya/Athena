{
  "id": "design-patterns",
  "title": "设计模式",
  "group": "设计模式",
  "parent": "software",
  "description": "软考软件设计师第 7 章的实践课程：23 种设计模式逐个编码真跑，输出与结构断言判分。由素材坑转正为学习应用（ADR 0103），docs/ 下的素材保留为内容基础。挂靠 software。",
  "icon": {
    "type": "theme",
    "name": "design-patterns-symbolic",
    "symbol": "square.grid.2x2",
    "letter": "模",
    "accent": "#A8562A",
    "file": "icon.svg",
    "renders": {
      "src-tauri/icons/32x32.png": 32,
      "src-tauri/icons/128x128.png": 128,
      "src-tauri/icons/128x128@2x.png": 256,
      "src-tauri/icons/icon.png": 512,
      "src-tauri/icons/icon.ico": "ico",
      "src-tauri/icons/icon.icns": "icns"
    }
  },
  "dev": {
    "prepare": [
      {
        "when_missing": "node_modules",
        "run": ["npm", "install"],
        "label": "安装前端依赖"
      }
    ],
    "run": ["npm", "run", "tauri:dev"],
    "ready": { "http": "http://localhost:1491" },
    "match": "src-tauri/target",
    "binary": "athena-design-patterns"
  }
}
