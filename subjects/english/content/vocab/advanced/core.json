    {
      "id": "en.advanced.vocab.address",
      "word": "address",
      "senses": [
        {
          "pos": "v",
          "gloss": "处理；应对"
        }
      ],
      "sentence": "The new policy is intended to address concerns raised by small businesses.",
      "prompt": "address 在这里是什么意思？",
      "error_tag": "熟词生义",
      "choices": [
        {
          "label": "处理、应对",
          "ok": true,
          "why": "宾语是 concerns，address 表示着手处理问题。"
        },
        {
          "label": "地址",
          "ok": false,
          "why": "地址是名词义，与 intended to 后的动词位置不符。"
        },
        {
          "label": "发表正式演说",
          "ok": false,
          "why": "address an audience 才可能表示演说，这里的宾语是 concerns。"
        }
      ],
      "variants": [
        {
          "sentence": "Any serious reform must address the reasons why workers leave.",
          "prompt": "address the reasons 表示什么？",
          "choices": [
            {
              "label": "认真处理这些原因",
              "ok": true,
              "why": "这里仍是处理问题的动词义。"
            },
            {
              "label": "写下这些原因的地址",
              "ok": false,
              "why": "reasons 没有物理地址。"
            }
          ]
        }
      ],
      "source_refs": [
