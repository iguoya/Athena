    {
      "id": "en.advanced.vocab.assume",
      "word": "assume",
      "senses": [
        {
          "pos": "v",
          "gloss": "假定；把…当作前提"
        }
      ],
      "sentence": "The argument assumes that higher pay always leads to greater satisfaction.",
      "prompt": "assumes that 在这里表示什么？",
      "error_tag": "论证词义",
      "choices": [
        {
          "label": "把某件事当作前提",
          "ok": true,
          "why": "论证在没有先证明的情况下采用了这个前提。"
        },
        {
          "label": "承担一项职位",
          "ok": false,
          "why": "assume office 才是就职。"
        },
        {
          "label": "否认一个结论",
          "ok": false,
          "why": "assume 在这里不是 deny。"
        }
      ],
      "variants": [
        {
          "sentence": "The forecast assumes that demand will remain stable.",
          "prompt": "assumes that 表示什么？",
          "choices": [
            {
              "label": "预测把需求稳定作为前提",
              "ok": true,
              "why": "是未经先证实的计算前提。"
            },
            {
              "label": "预测证明了需求稳定",
              "ok": false,
              "why": "assume 不等于 prove。"
            }
          ]
        }
