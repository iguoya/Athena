{
  "id": "os",
  "title": "操作系统",
  "group": "操作系统",
  "parent": "software",
  "description": "软考软件设计师第 4 章的实践课程：进程/信号量 pthread 真编码、调度与页置换算法模拟器。按 ADR 0103 从 software 独立成挂靠子应用，可单独使用。",
  "icon": {
    "type": "theme",
    "name": "os-symbolic",
    "symbol": "desktopcomputer",
    "letter": "操",
    "accent": "#0E7A8A",
    "file": "icon.svg",
    "renders": {
      "src-tauri/icons/32x32.png": 32,
      "src-tauri/icons/128x128.png": 128,
      "src-tauri/icons/128x128@2x.png": 256,
      "src-tauri/icons/icon.png": 512,
      "src-tauri/icons/icon.ico": "ico",
      "src-tauri/icons/icon.icns": "icns"
    }
  },
  "dev": {
    "prepare": [
      {
        "when_missing": "node_modules",
        "run": ["npm", "install"],
        "label": "安装前端依赖"
      }
    ],
    "run": ["npm", "run", "tauri:dev"],
    "ready": { "http": "http://localhost:1492" },
    "match": "src-tauri/target",
    "binary": "athena-os"
  }
}
