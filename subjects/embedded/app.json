{
  "id": "embedded",
  "title": "嵌入式系统设计师",
  "group": "嵌入式系统设计师",
  "description": "软考中级·嵌入式系统设计师备考：教材章树对齐、考纲权重驱动，章节考核与历年真题演练。从 software（原 softcert）拆出独立成应用（ADR 0090、0100），Vue 3 技术体系换一种学习体验。",
  "icon": {
    "type": "theme",
    "name": "cpu-symbolic",
    "symbol": "cpu",
    "letter": "嵌",
    "accent": "#0E8A6D",
    "file": "icon.svg",
    "renders": {
      "src-tauri/icons/32x32.png": 32,
      "src-tauri/icons/128x128.png": 128,
      "src-tauri/icons/128x128@2x.png": 256,
      "src-tauri/icons/icon.png": 512,
      "src-tauri/icons/icon.ico": "ico"
    }
  },
  "dev": {
    "prepare": [
      {
        "when_missing": "node_modules",
        "run": [
          "npm",
          "install"
        ],
        "label": "安装前端依赖"
      }
    ],
    "run": [
      "npm",
      "run",
      "tauri:dev"
    ],
    "ready": {
      "http": "http://localhost:1480"
    },
    "match": "src-tauri/target",
    "binary": "athena-embedded"
  }
}
