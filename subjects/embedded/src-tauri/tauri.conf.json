{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "athena-embedded",
  "version": "0.1.0",
  "identifier": "cn.athena.embedded",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1480",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "嵌入式系统设计师",
        "width": 1500,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
