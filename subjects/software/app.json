{
  "id": "software",
  "title": "软件设计师",
  "group": "程序设计",
  "description": "软考中级·软件设计师备考：考纲对齐、分值驱动，章节考核与历年真题演练；数据库等实践章配 SQL 真跑实验（仓库 ADR 0091）。",
  "icon": {
    "type": "theme",
    "name": "certificate-applet-symbolic",
    "symbol": "checkmark.seal",
    "letter": "考",
    "accent": "#6D5AE6",
    "file": "icon.svg",
    "renders": {
      "src-tauri/icons/32x32.png": 32,
      "src-tauri/icons/128x128.png": 128,
      "src-tauri/icons/128x128@2x.png": 256,
      "src-tauri/icons/icon.png": 512,
      "src-tauri/icons/icon.ico": "ico"
    }
  },
  "dev": {
    "prepare": [
      {
        "when_missing": "node_modules",
        "run": [
          "npm",
          "install"
        ],
        "label": "安装前端依赖"
      }
    ],
    "run": [
      "npm",
      "run",
      "tauri:dev"
    ],
    "ready": {
      "http": "http://localhost:1450"
    },
    "match": "src-tauri/target",
    "binary": "athena-software"
  }
}
