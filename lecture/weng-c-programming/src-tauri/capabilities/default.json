{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "应用界面（主窗口里的 ui webview）",
  "permissions": [
    "core:default",
    "updater:default",
    "process:allow-restart",
    "allow-get-curriculum",
    "allow-get-lesson",
    "allow-open-external",
    "allow-record-attempt",
    "allow-get-attempts",
    "allow-player-load",
    "allow-player-seek",
    "allow-player-play",
    "allow-player-pause",
    "allow-player-set-pause-point",
    "allow-player-set-visible",
    "allow-player-open-login",
    "allow-save-marks",
    "allow-load-marks",
    "allow-player-poll"
  ],
  "webviews": [
    "ui"
  ]
}