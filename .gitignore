# 构建目录。Meson 一律用 build/。builddir/ 是 C++ 教程还在仓库根时的旧名
# （ADR 0045），作废，避免再在根上或应用旁边长出第二份。
build/
builddir/
dist/

# Meson internal files
meson-private/
meson-logs/
_deps/

# C/C++ object and executable files
*.o
*.a
*.so
*.dll
*.exe

# IDE/Editor specific files
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.clangd/
.cache
__pycache__/
*.pyc
# OS specific files
.DS_Store
Thumbs.db

# 代理工具的本地状态：会话设置、临时工作树、会话计划。都是本机产物，
# 不是项目的一部分（.claude/worktrees 单独就有 93M）。
# 例外是 .claude/settings.json：项目共享配置（启用的插件等），要随仓库走。
# 用 .claude/* 而不是 .claude/：忽略整个目录后，git 无法再放行其中的文件。
.claude/*
!.claude/settings.json
.zcode/

# Swift Package Manager（launcher）
launcher/.build/

# 共享的 cargo 构建缓存（launcher/core 统一注入 CARGO_TARGET_DIR）
.cache/

# 进度库本身要进版本库（ADR 0053），但 SQLite 的伴生文件不要：
# -wal / -shm 是未落盘的日志和共享内存，跟着提交会让库在别的机器上打不开。
subjects/*/progress/*.db-wal
subjects/*/progress/*.db-shm
subjects/*/progress/*.db-journal
