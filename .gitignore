# Meson build directories（builddir=本地 debug，build=复现 CI 的 debugoptimized）
build/
dist/

# Meson internal files
meson-private/
meson-logs/
_deps/

# C/C++ object and executable files
*.o
*.a
*.so
*.dll
*.exe

# IDE/Editor specific files
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
.idea/
.clangd/
.cache
__pycache__/
*.pyc
# OS specific files
.DS_Store
Thumbs.db

# 代理工具的本地状态：会话设置、临时工作树、会话计划。都是本机产物，
# 不是项目的一部分（.claude/worktrees 单独就有 93M）。
.claude/
.zcode/

# Swift Package Manager（launcher）
launcher/.build/

# 共享的 cargo 构建缓存（launcher/core 统一注入 CARGO_TARGET_DIR）
.cache/
