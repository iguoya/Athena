{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "athena-comms-console",
  "version": "10.1.0",
  "identifier": "cn.athena.comms-console",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1521",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "协作观察台",
        "width": 1440,
        "height": 960,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3NUQ0NjZDQzRFRDE0QTcKUldTbkZPM0ViRVpkdDNDcHdhZHdTS0N6dTZ2REp5Q2NjcTN6UzE4dzRqL3FLWHlOeFVjODFjNXgK",
      "endpoints": [
        "https://github.com/iguoya/Athena/releases/download/app-updates/comms-console.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
