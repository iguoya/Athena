  },
  {
   "from": 13.64,
   "to": 16.22,
   "text": "或者在使用计算机给你提供的服务"
  },
  {
   "from": 16.22,
   "to": 17.74,
   "text": "比如说你去银行取钱"
  },
  {
   "from": 17.76,
   "to": 20.04,
   "text": "atm是一台计算机"
  },
  {
   "from": 20.28,
   "to": 21.96,
   "text": "你在柜台上取钱"
  },
  {
   "from": 21.96,
   "to": 24.72,
   "text": "银行的资源使用的也是计算机"
  },
  {
   "from": 25.2,
   "to": 27.03,
   "text": "当我们使用计算机的时候"
  },
  {
   "from": 27.03,
   "to": 30.76,
   "text": "我们都是要用计算机上面已经有的软件"
  },
  {
   "from": 31.14,
   "to": 32.73,
   "text": "比如说你在使用手机"
  },
  {
   "from": 32.73,
   "to": 35.36,
   "text": "当然首先我们得说手机也是一台计算机"
  },
  {
   "from": 36.02,
   "to": 37.16,
   "text": "我们要用手机的时候"
  },
  {
   "from": 37.16,
   "to": 40.13,
   "text": "我们想的是去哪找一个app"
  },
  {
   "from": 40.13,
