   "to": 961.67,
   "text": "零"
  },
  {
   "from": 961.67,
   "to": 964.15,
   "text": "非零"
  },
  {
   "from": 964.15,
   "to": 967.59,
   "text": "你get到我的点了没有啊"
  },
  {
   "from": 967.59,
   "to": 970.63,
   "text": "理解我的意思没有啊"
  },
  {
   "from": 970.63,
   "to": 972.15,
   "text": "非零"
  },
  {
   "from": 972.15,
   "to": 974.95,
   "text": "它有非零解的冲要条件是"
  },
  {
   "from": 974.95,
   "to": 976.03,
