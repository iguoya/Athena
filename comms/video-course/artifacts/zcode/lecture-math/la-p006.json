   "from": 577.23,
   "to": 578.71,
   "text": "一会让人家等于1"
  },
  {
   "from": 578.71,
   "to": 580.47,
   "text": "一会让人家等于5"
  },
  {
   "from": 580.47,
   "to": 581.91,
   "text": "人家怎么能一会等于1"
  },
  {
   "from": 581.91,
   "to": 584.03,
   "text": "一会等于5啊"
  },
  {
   "from": 584.03,
   "to": 585.39,
   "text": "所以这个方案组"
  },
  {
   "from": 585.39,
   "to": 587.83,
   "text": "它的解是什么情况"
