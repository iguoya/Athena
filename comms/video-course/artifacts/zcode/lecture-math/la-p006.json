  {
   "from": 1000.95,
   "to": 1003.87,
   "text": "给个奇责线方案组"
  },
  {
   "from": 1003.87,
   "to": 1006.76,
   "text": "不就可以用吗"
  },
  {
   "from": 1006.76,
   "to": 1009.2,
   "text": "那我随便给你写一个"
  },
  {
   "from": 1009.2,
   "to": 1011.28,
   "text": "说有个奇责线方案组"
  },
  {
   "from": 1011.28,
   "to": 1016.32,
   "text": "x1加x2加x3等量"
  },
  {
   "from": 1016.32,
   "to": 1021.32,
   "text": "x1-x2-x3等量"
  },
  {
   "from": 1021.32,
   "to": 1023.2,
   "text": "请问我写的这个例子"
  },
  {
   "from": 1023.2,
   "to": 1024.68,
   "text": "这个奇责线方案组"
  },
  {
   "from": 1024.68,
   "to": 1028.68,
   "text": "能不能用刚才讲过的这两句话"
  },
  {
   "from": 1028.68,
   "to": 1030.6,
   "text": "能还不能"
  },
  {
   "from": 1030.6,
   "to": 1031.28,
   "text": "不能"
  },
  {
   "from": 1031.28,
   "to": 1033.28,
   "text": "而为什么不能"
  },
  {
   "from": 1033.28,
   "to": 1035.84,
   "text": "它这个奇责线方案组啊"
  },
  {
   "from": 1035.84,
   "to": 1038.72,
   "text": "它有个什么要求呢"
  },
  {
   "from": 1038.72,
   "to": 1043.35,
   "text": "就是方程的个数"
  },
  {
   "from": 1043.35,
   "to": 1045.55,
   "text": "必须等于"
  },
  {
   "from": 1045.55,
   "to": 1048.47,
   "text": "位置量的个数"
  },
  {
   "from": 1048.47,
   "to": 1049.75,
   "text": "它这不是说了吗"
  },
  {
   "from": 1049.75,
   "to": 1053.07,
   "text": "既上述奇责线方案组"
  },
  {
   "from": 1053.07,
   "to": 1054.51,
   "text": "所谓的上述"
  },
  {
   "from": 1054.51,
   "to": 1055.87,
   "text": "这俩字的意思就是"
  },
  {
   "from": 1055.87,
   "to": 1056.71,
   "text": "方程的个数"
  },
  {
   "from": 1056.71,
   "to": 1060.14,
   "text": "必须等于位置量的个数"
  },
  {
   "from": 1060.14,
   "to": 1061.94,
   "text": "我这个奇责线方案组"
  },
  {
   "from": 1061.94,
   "to": 1063.66,
   "text": "为什么不能用呢"
  },
  {
   "from": 1063.66,
   "to": 1067.1,
   "text": "你不是这个地吗"
  },
  {
   "from": 1067.1,
   "to": 1069.14,
   "text": "一一一一"
  },
  {
   "from": 1069.14,
   "to": 1072.14,
   "text": "一富一富一"
  },
  {
   "from": 1072.14,
   "to": 1075.3,
   "text": "大家抬头看一眼"
  },
  {
   "from": 1075.3,
   "to": 1076.94,
   "text": "这个行列是"
  },
  {
   "from": 1076.94,
   "to": 1079.02,
   "text": "是几行几列"
  },
  {
   "from": 1079.02,
   "to": 1083.67,
   "text": "或者说这个行列是几届的啊"
  },
  {
   "from": 1083.67,
   "to": 1087.14,
   "text": "这是错的"
  },
  {
   "from": 1087.14,
   "to": 1089.94,
   "text": "行列是必须是方的"
  },
  {
   "from": 1089.94,
   "to": 1092.3,
   "text": "有几行是不是必须有几列啊"
  },
  {
   "from": 1092.3,
   "to": 1094.78,
   "text": "所以为什么这个奇责线方案组"
  },
  {
   "from": 1094.78,
   "to": 1097.82,
   "text": "不能用这个结论"
  },
  {
   "from": 1097.82,
   "to": 1099.74,
   "text": "那老师你举这个奇责线方案组"
  },
  {
   "from": 1099.74,
   "to": 1101.18,
   "text": "那怎么做题呢"
  },
  {
   "from": 1101.18,
   "to": 1103.82,
   "text": "那我们在后面解题的时候"
  },
  {
   "from": 1103.82,
   "to": 1106.06,
   "text": "有其他的这个方法"
  },
  {
   "from": 1106.06,
   "to": 1107.58,
   "text": "再给大家去解释"
  },
  {
   "from": 1107.58,
   "to": 1111.02,
   "text": "好 这是这两个结论"
  },
  {
   "from": 1111.02,
   "to": 1112.62,
   "text": "好 我们看一下例三"
  },
  {
   "from": 1112.62,
   "to": 1114.58,
   "text": "问奇责线方案组"
  },
  {
   "from": 1114.58,
   "to": 1117.9,
   "text": "是不是有非灵解啊"
  },
  {
   "from": 1117.9,
   "to": 1119.02,
   "text": "那么这两方案组啊"
  },
  {
   "from": 1119.02,
   "to": 1120.98,
   "text": "我们先看一下第一个"
  },
  {
   "from": 1120.98,
   "to": 1123.82,
   "text": "三个方程三个位置量"
  },
  {
   "from": 1123.82,
   "to": 1126.3,
   "text": "那么第二个是四个方程"
  },
  {
   "from": 1126.3,
   "to": 1127.26,
   "text": "四个位置量"
  },
  {
   "from": 1127.26,
   "to": 1131.7,
   "text": "所以可以用刚才的那两个结论"
  },
  {
   "from": 1131.7,
   "to": 1133.42,
   "text": "第一题"
  },
  {
   "from": 1133.42,
   "to": 1137.1,
   "text": "我们算一下它的系数行列是"
  },
  {
   "from": 1137.1,
   "to": 1139.82,
   "text": "一一一富二"
  },
  {
   "from": 1139.82,
   "to": 1142.98,
   "text": "五富二七"
  },
  {
   "from": 1142.98,
   "to": 1145.7,
   "text": "二富五四"
  },
  {
   "from": 1145.7,
   "to": 1147.3,
   "text": "这个算出来啊"
  },
  {
   "from": 1147.3,
   "to": 1149.46,
   "text": "是个不等于零"
  },
  {
   "from": 1149.46,
   "to": 1151.3,
   "text": "第一不等于零"
  },
  {
   "from": 1151.3,
   "to": 1154.26,
   "text": "它的充要条件是"
  },
  {
   "from": 1154.26,
   "to": 1157.38,
   "text": "是有灵解还是非灵解"
  },
  {
   "from": 1157.38,
   "to": 1163.32,
   "text": "只有灵解"
  },
  {
   "from": 1163.32,
   "to": 1165.08,
   "text": "第二题"
  },
  {
   "from": 1165.08,
   "to": 1166.68,
   "text": "这个第一算出来啊"
  },
  {
   "from": 1166.68,
   "to": 1167.6,
   "text": "是等于零"
  },
  {
   "from": 1167.6,
   "to": 1169.6,
   "text": "怎么算的我就不啰嗦了"
  },
  {
   "from": 1169.6,
   "to": 1171.32,
   "text": "那么第一等于零"
  },
  {
   "from": 1171.32,
   "to": 1172.8,
   "text": "那么这个奇责线方案组"
  },
  {
   "from": 1172.8,
   "to": 1175.32,
   "text": "是有什么解啊"
  },
  {
   "from": 1175.32,
   "to": 1178.68,
   "text": "有非灵解"
  },
  {
   "from": 1178.68,
   "to": 1180.28,
   "text": "好看呀 最后一题"
  },
  {
   "from": 1180.28,
   "to": 1181.88,
   "text": "说了奇责线方案组"
  },
  {
   "from": 1181.88,
   "to": 1184.64,
   "text": "是只有灵解"
  },
  {
   "from": 1184.64,
   "to": 1186.52,
   "text": "只有灵解的充要条件是那个"
  },
  {
   "from": 1186.52,
   "to": 1187.64,
   "text": "第一"
  },
  {
   "from": 1187.64,
   "to": 1189.84,
   "text": "等于零还是不等于零"
  },
  {
   "from": 1189.84,
   "to": 1192.96,
   "text": "不等于零"
  },
  {
   "from": 1192.96,
   "to": 1194.6,
   "text": "那这个系数行列是"
  },
  {
   "from": 1194.6,
   "to": 1196.4,
   "text": "你就朝你做呗"
  },
  {
   "from": 1196.4,
   "to": 1198.92,
   "text": "开一一"
  },
  {
   "from": 1198.92,
   "to": 1202.0,
   "text": "一开富一"
  },
  {
   "from": 1202.0,
   "to": 1205.28,
   "text": "二富一一"
  },
  {
   "from": 1205.28,
   "to": 1209.28,
   "text": "那这个做"
  },
  {
   "from": 1209.28,
   "to": 1211.28,
   "text": "那这个做呢"
  },
  {
   "from": 1211.28,
   "to": 1212.84,
   "text": "首先说"
  },
  {
   "from": 1212.84,
   "to": 1215.08,
   "text": "不要干嘛呢"
  },
  {
   "from": 1215.08,
   "to": 1218.8,
   "text": "不要六条线给它完全展开"
  },
  {
   "from": 1218.8,
   "to": 1220.56,
   "text": "因为它里边一个零都没有"
  },
  {
   "from": 1220.56,
   "to": 1224.48,
   "text": "这个算起来肯定是挺麻烦的"
  },
  {
   "from": 1224.48,
   "to": 1225.2,
   "text": "做的时候啊"
  },
  {
   "from": 1225.2,
   "to": 1226.88,
   "text": "你找找有什么规律"
  },
  {
   "from": 1226.88,
   "to": 1229.68,
   "text": "或者说哪些点比较简单"
  },
  {
   "from": 1229.68,
   "to": 1231.6,
   "text": "这个比较明显就是"
  },
  {
   "from": 1231.6,
   "to": 1234.08,
   "text": "这些一是不挺简单的嘛"
  },
  {
   "from": 1234.08,
   "to": 1235.12,
   "text": "所以呢"
  },
  {
   "from": 1235.12,
   "to": 1239.0,
   "text": "我用这一行乘以富一"
  },
  {
   "from": 1239.0,
   "to": 1243.51,
   "text": "这一行乘以一"
  },
  {
   "from": 1243.51,
   "to": 1246.79,
   "text": "k减二"
  },
  {
   "from": 1246.79,
   "to": 1249.51,
   "text": "二零"
  },
  {
   "from": 1249.51,
   "to": 1250.87,
   "text": "三"
  },
  {
   "from": 1250.87,
   "to": 1253.95,
   "text": "k减一零"
  },
  {
   "from": 1253.95,
   "to": 1257.99,
   "text": "二富一一"
  },
  {
   "from": 1257.99,
   "to": 1261.11,
   "text": "那你按照第三列展开呗"
  },
  {
   "from": 1261.11,
   "to": 1262.71,
   "text": "这不零零吗"
  },
  {
   "from": 1262.71,
   "to": 1264.79,
   "text": "那展开不就挺简单的了嘛"
  },
  {
   "from": 1264.79,
   "to": 1266.15,
   "text": "所以算出来就是个"
  },
  {
   "from": 1266.15,
   "to": 1269.71,
   "text": "k方减三k"
  },
  {
   "from": 1269.71,
   "to": 1274.79,
   "text": "减四不是不党于零吗"
  },
  {
   "from": 1274.79,
   "to": 1280.03,
   "text": "所以开不党于富一"
  },
  {
   "from": 1280.03,
   "to": 1287.78,
   "text": "且开不党于四就开"
  },
  {
   "from": 1287.78,
   "to": 1290.02,
   "text": "就是克莱姆法则"
  },
  {
   "from": 1290.02,
   "to": 1291.42,
   "text": "我们就讲到这里"
  },
  {
   "from": 1291.42,
   "to": 1296.86,
   "text": "那这样的话我们整个行列实际上就结束掉了"
  }
 ]
}