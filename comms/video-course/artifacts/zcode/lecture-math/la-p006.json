  {
   "from": 596.15,
   "to": 597.83,
   "text": "所以我们在后边讲方案组"
  },
  {
   "from": 597.83,
   "to": 598.95,
   "text": "它的解"
  },
  {
   "from": 598.95,
   "to": 600.91,
   "text": "其实是三种情况"
