   "text": "说完了 这个方程"
  },
  {
   "from": 547.38,
   "to": 550.83,
   "text": "其实是不是没啥用啊"
  },
  {
   "from": 550.83,
   "to": 553.51,
   "text": "X1加X2等于1啊"
  },
  {
   "from": 553.51,
   "to": 555.15,
   "text": "那这情况多了去了"
  },
  {
   "from": 555.15,
   "to": 556.83,
   "text": "0加1等于1"
  },
  {
   "from": 556.83,
   "to": 559.63,
   "text": "这个2加-1等于1"
  },
  {
   "from": 559.63,
   "to": 561.39,
   "text": "3加-2等于1"
  },
  {
   "from": 561.39,
   "to": 563.43,
   "text": "所以X1 X2"
  },
  {
   "from": 563.43,
   "to": 567.43,
   "text": "其实是无穷多解"
  },
  {
   "from": 567.43,
   "to": 569.67,
   "text": "第三种情况"
  },
  {
   "from": 569.67,
   "to": 572.71,
   "text": "X1加X2等于1"
  },
  {
   "from": 572.71,
   "to": 575.11,
   "text": "X1加X2等于5"
  },
  {
   "from": 575.15,
   "to": 577.23,
   "text": "有些团团老师你有兵吗你"
