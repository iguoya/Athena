  {
   "from": 623.67,
   "to": 625.35,
   "text": "四个"
  },
  {
   "from": 625.35,
   "to": 630.15,
   "text": "我们再求它的系数行列是"
  },
  {
   "from": 630.15,
   "to": 632.71,
   "text": "一一一一"
  },
  {
   "from": 632.71,
   "to": 636.03,
   "text": "一二三复一"
  },
  {
   "from": 636.03,
   "to": 639.15,
