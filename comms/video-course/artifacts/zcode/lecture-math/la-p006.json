  },
  {
   "from": 639.15,
   "to": 643.91,
   "text": "一八二十七复一"
  },
  {
   "from": 643.91,
   "to": 646.43,
   "text": "大家有没有察觉出来"
  },
  {
   "from": 646.43,
   "to": 651.92,
