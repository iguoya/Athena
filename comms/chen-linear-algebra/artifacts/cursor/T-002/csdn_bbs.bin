  transition: transform 330ms var(--tao-ease) 160ms, opacity 270ms ease 160ms;
}
.csdn-taotoken-motion__decor {
  position: absolute; inset: 0; opacity: 0;
  transform: scale(.18) rotate(var(--tao-enter-angle, 0deg)); transform-origin: 165px 231px;
  transition: transform 180ms var(--tao-ease), opacity 150ms ease;
}
.csdn-taotoken-motion__decor img { position: absolute; height: auto; }
/* Opposing entrance turns settle back to the original supplied composition. */
.csdn-taotoken-motion__ribbons { z-index: 1; --tao-enter-angle: 7deg; }
.csdn-taotoken-motion__ribbons img { width: 317px !important; left: 2px; top: 105px; }
.csdn-taotoken-motion__prizes { z-index: 2; --tao-enter-angle: -7deg; }
.csdn-taotoken-motion__prizes img { width: 275px !important; left: 37px; top: 64px; }
.csdn-taotoken-motion__tickets { z-index: 3; --tao-enter-angle: 5deg; }
.csdn-taotoken-motion__tickets img { width: 318px !important; left: 23px; top: 135px; }
.csdn-taotoken-motion--right[data-ready="true"]:is(:hover, :focus-visible, .is-preview-active) .csdn-taotoken-motion__title {
  opacity: 0; transform: translate(14px, 30px) scale(.78); transition-delay: 0ms;
}
.csdn-taotoken-motion--right[data-ready="true"]:is(:hover, :focus-visible, .is-preview-active) .csdn-taotoken-motion__main {
  opacity: 1; transform: translate(0, 0) scale(1); transition-delay: 0ms;
}
.csdn-taotoken-motion--right[data-ready="true"]:is(:hover, :focus-visible, .is-preview-active) .csdn-taotoken-motion__decor {
  opacity: 1; transform: scale(1) rotate(0deg);
  transition-duration: 330ms, 190ms; transition-delay: 340ms;
}
/* Embedded-slot adapter. Keep the host's column widths and central article intact. */
html body.has-simple-ad-background-skin:has(.csdn-taotoken-motion) {
  background: linear-gradient(90deg,#f6f2ed 0%,#fcfaf7 28%,#fff 76%) !important;
}
html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) main,
html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .blog-content-box,
html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) #article-header-box {
  background-color: transparent !important;
}
.simple-ad-slot__fixed:has(> .csdn-taotoken-motion) {
  background-image: none !important;
  overflow: hidden !important;
  pointer-events: none;
}
html body .simple-column-page.has-ad-slots #mainBox .simple-ad-slot__fixed:has(> .csdn-taotoken-motion) {
  top: var(--mogrow-skin-toolbar-height, 48px) !important;
}
/* Artwork expansion stays outside the article and its independent action rail. */
html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) {
  max-width: calc(max(45vw, 820px) + 660px);
}
html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .simple-ad-slot-left {
  width: 200px; min-width: 200px; max-width: 200px; flex: 0 0 200px;
}
html body .simple-column-page.has-ad-slots #mainBox .simple-ad-slot-left .simple-ad-slot__fixed:has(> .csdn-taotoken-motion) {
  --tao-left-frame: clamp(200px, calc((100vw - max(45vw, 820px)) / 2 - 196px), 320px);
  width: var(--tao-left-frame) !important;
  margin-left: calc(200px - var(--tao-left-frame)) !important;
}
html body .simple-column-page.has-ad-slots #mainBox .simple-ad-slot-right .simple-ad-slot__fixed:has(> .csdn-taotoken-motion) {
  width: clamp(256px, calc((100vw - max(45vw, 820px)) / 2 - 100px), 400px) !important;
  margin-left: 0 !important;
}
/* Remove legacy side backgrounds only inside this creative. */
html body.has-simple-ad-background-skin .simple-column-page.has-ad-slots #mainBox .simple-ad-slot-right .simple-ad-slot__fixed:has(> .csdn-taotoken-motion) {
  background-color: transparent !important;
}
html body.has-simple-ad-background-skin .simple-column-page.has-ad-slots #mainBox .simple-ad-slot-right .simple-ad-slot__fixed:has(> .csdn-taotoken-motion)::before,
html body.has-simple-ad-background-skin .simple-column-page.has-ad-slots #mainBox .simple-ad-slot-right .simple-ad-slot__fixed:has(> .csdn-taotoken-motion)::after {
  content: none !important;
}
@media (prefers-reduced-motion: reduce) {
  .csdn-taotoken-motion *, .csdn-taotoken-motion *::before {
    transition-duration: 0s !important; transition-delay: 0s !important;
  }
}
/* No hovering required on touch devices. PC background slots are hidden by host
   on mobile; if independently embedded on touch, show the completed composition. */
@media (hover: none) {
  .csdn-taotoken-motion__card { transform: translate(var(--open-x), var(--open-y)) rotate(var(--angle)); }
  .csdn-taotoken-motion__cards, .csdn-taotoken-motion__brand { opacity: 1; }
  .csdn-taotoken-motion--right[data-ready="true"] .csdn-taotoken-motion__title { opacity: 0; }
  .csdn-taotoken-motion--right[data-ready="true"] .csdn-taotoken-motion__main,
  .csdn-taotoken-motion--right[data-ready="true"] .csdn-taotoken-motion__decor { opacity: 1; transform: none; }
}

/* Reserve an independent right column and scale artwork within it. */
@media (max-width: 1599px) {
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) {
    max-width: none; justify-content: flex-start; gap: 24px; padding: 0 12px;
  }
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .simple-ad-slot-left {
    display: none;
  }
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) > main {
    width: auto; min-width: 0; flex: 1 1 0;
  }
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .article-aside-container {
    width: 36px; flex: 0 0 36px;
  }
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .simple-ad-slot-right {
    display: block !important; width: 224px; min-width: 224px; max-width: 224px; flex: 0 0 224px;
  }
  html body .simple-column-page.has-ad-slots #mainBox .simple-ad-slot-right .simple-ad-slot__fixed:has(> .csdn-taotoken-motion) {
    left: auto !important; right: 12px !important; width: 224px !important; margin-left: 0 !important;
  }
}
@media (max-width: 900px) {
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .simple-ad-slot-right { display: none !important; }
  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) { gap: 16px; }
}
