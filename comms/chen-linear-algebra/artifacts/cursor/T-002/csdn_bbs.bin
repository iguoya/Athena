idth: 0; flex: 1 1 0;\n  }\n  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .article-aside-container {\n    width: 36px; flex: 0 0 36px;\n  }\n  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .simple-ad-slot-right {\n    display: block !important; width: 224px; min-width: 224px; max-width: 224px; flex: 0 0 224px;\n  }\n  html body .simple-column-page.has-ad-slots #mainBox .simple-ad-slot-right .simple-ad-slot__fixed:has(\u003E .csdn-taotoken-motion) {\n    left: auto !important; right: 12px !important; width: 224px !important; margin-left: 0 !important;\n  }\n}\n@media (max-width: 900px) {\n  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) .simple-ad-slot-right { display: none !important; }\n  html body .simple-column-page.has-ad-slots #mainBox:has(.csdn-taotoken-motion) { gap: 16px; }\n}\n\u003C\u002Fstyle\u003E\n\u003Cscript\u003E\n\u002F* Standalone, dependency-free skin. Use instead of, not alongside, the old skin. *\u002F\n(() =\u003E {\n  'use strict';\n  \u002F\u002F All twelve CDN assets are byte-for-byte verified against the lossless originals.\n  const assets = {\n    \"card-deepseek\": \"https:\u002F\u002Fi-operation.csdnimg.cn\u002Fimages\u002F6780bb9dd4eb484aae6d026902a7085a.webp\",\n    \"card-kimi\": \"https:\u002F\u002Fi-operation.csdnimg.cn\u002Fimages\u002F182f705e09ca456ca7b259e56072f461.webp\",\n    \"card-glm\": \"https:\u002F\u002Fi-operation.csdnimg.cn\u002Fimages\u002F335a569346564288bb730b4d21c44e22.webp\",\n    \"card-seedance\": \"https:\u002F\u002Fi-operation.csdnimg.cn\u002Fimages\u002F1cf91f268764483fb963d207269993ae.webp\",\n    \"card-qwen\": \"https:\u002F\u002Fi-operation.csdnimg.cn\u002Fimages\u002Fb351960e75d647b28ee26b8fcc8f2bf7.webp\",\n    \"card-minimax\": \"https:\u002F\u002Fi-operation.csdnimg.cn\u002Fimages\u002F7e3dc73b79514d1eb00c85c50f46c200.webp\",\n    \"card-doubao\": \"https:\u002F\u002Fi-operation.csdnimg.cn\u002Fimages\u002F9cbb1d0768ee4151ab915fd7dde33ee2.webp\",\n    \"right-main\": \"https:\u002F\u002Fi-operation.csdnimg.cn\u002Fimages\u002F4da2ad1333684acd965049252bde100e.webp\",\n    \"right-prizes\": \"https:\u002F\u002Fi-operation.csdnimg.cn\u002Fimages\u002Ffc0e45eaf47949cbb7cbf3c742d3a3be.webp\",\n    \"right-ribbons\": \"https:\u002F\u002Fi-operation.csdnimg.cn\u002Fimages\u002F488bf47c7b0b4cd6b94e98e6f08e1434.webp\",\n    \"right-title\": \"https:\u002F\u002Fi-operation.csdnimg.cn\u002Fimages\u002F118adbc7a8844a5b83022ccca40a1417.webp\",\n    \"right-tickets\": \"https:\u002F\u002Fi-operation.csdnimg.cn\u002Fimages\u002Fc96ae377edea42a5b293dd93acdeacdf.webp\"\n};\n  const asset = name =\u003E assets[name];\n  \u002F\u002F Campaign URL confirmed by the user; preserve channel attribution.\n  const target = 'https:\u002F\u002Ftaotoken.net\u002Fcoding-plan?utm_source=bbsbackground';\n  const cards = [\n    ['doubao', 'Doubao-Seed 系列', 96, 150, 48, 130, -22],\n    ['minimax', 'minimax', 85, 177, 40, 200, -24],\n    ['qwen', 'qwen 系列', 72, 211, 35, 270, -26],\n    ['seedance', 'seedance', 60, 254, 32, 340, -28],\n    ['glm', 'GLM 系列', 52, 308, 40, 415, -30],\n    ['kimi', 'kimi', 48, 378, 45, 490, -32],\n    ['deepseek', 'deepseek 系列', 45, 463, 55, 565, -34],\n  ];\n  function image(name, className, width, height) {\n    const img = document.createElement('img');\n    img.className = className;\n    img.src = asset(name);\n    img.alt = '';\n    img.width = width;\n    img.height = height;\n    img.draggable = false;\n    img.decoding = 'async';\n    return img;\n  }\n  function mount(host, side) {\n    if (host.querySelector('.csdn-taotoken-motion')) return;\n    const link = document.createElement('a');\n    link.className = `csdn-taotoken-motion csdn-taotoken-motion--${side}`;\n    link.href = target;\n    link.target = '_blank';\n    link.rel = 'noopener';\n    link.setAttribute('aria-label', side === 'left'\n      ? '了解 TaoToken：Doubao-Seed、minimax、qwen、seedance、GLM、kimi、deepseek（新窗口）'\n      : '1024 程序员节 Coding Plan 限时秒杀，查看活动（新窗口）');\n    const stage = document.createElement('span');\n    stage.className = 'csdn-taotoken-motion__stage';\n    stage.setAttribute('aria-hidden', 'true');\n    link.append(stage);\n    if (side === 'left') {\n      const deck = document.createElement('span');\n      deck.className = 'csdn-taotoken-motion__cards';\n      for (const [id, , x, y, ox, oy, angle] of cards) {\n        const card = image(`card-${id}`, 'csdn-taotoken-motion__card', 560, 640);\n        card.style.cssText = `--rest-x:${x}px;--rest-y:${y}px;--open-x:${ox}px;--open-y:${oy}px;--angle:${angle}deg`;\n        deck.append(card);\n      }\n      const brand = document.createElement('span');\n      brand.className = 'csdn-taotoken-motion__brand';\n      \u002F\u002F Official TaoToken mark: https:\u002F\u002Fstatic.taotoken.net\u002Frelease\u002Ftaotoken_fe\u002Fdist\u002Flogo.svg\n      const mark = document.createElementNS('http:\u002F\u002Fwww.w3.org\u002F2000\u002Fsvg', 'svg');\n      mark.setAttribute('viewBox', '0 0 152 145');\n      mark.setAttribute('class', 'csdn-taotoken-motion__mark');\n      mark.setAttribute('fill', 'currentColor');\n      const shapes = [\n        'M83 73C83 76.866 79.866 80 76 80C72.134 80 69 76.866 69 73C69 69.134 72.134 66 76 66C79.866 66 83 69.134 83 73Z',\n        'M0 83.6813V117L20 97H58.5C60.7091 97 62.5 98.7909 62.5 101V129L38.3135 145H76H113.687L89.5 129V101C89.5 98.7909 91.2909 97 93.5 97H132L152 117V83.6813C152 78.8277 147.713 75.0923 142.905 75.7565L76 85L9.09486 75.7565C4.28697 75.0923 0 78.8277 0 83.6813Z',\n        'M76 0H38.3135L62.5 16V44C62.5 46.2091 60.7091 48 58.5 48H20L0 28V61.3187C0 66.1723 4.28697 69.9077 9.09486 69.2435L76 60L142.905 69.2435C147.713 69.9077 152 66.1723 152 61.3187V28L132 48H93.5C91.2909 48 89.5 46.2091 89.5 44V16L113.687 0H76Z'\n      ];\n      for (const d of shapes) {\n        const path = document.createElementNS('http:\u002F\u002Fwww.w3.org\u002F2000\u002Fsvg', 'path');\n        path.setAttribute('d', d);\n        mark.append(path);\n      }\n      brand.append(mark, document.createTextNode('TaoToken'));\n      stage.append(deck, brand);\n    } else {\n      stage.append(image('right-title', 'csdn-taotoken-motion__title', 510, 618));\n      const composition = document.createElement('span');\n      composition.className = 'csdn-taotoken-motion__composition';\n      for (const [id, width, height] of [['ribbons',902,880], ['prizes',775,929], ['tickets',906,498]]) {\n        const layer = document.createElement('span');\n        layer.className = `csdn-taotoken-motion__decor csdn-taotoken-motion__${id}`;\n        layer.append(image(`right-${id}`, '', width, height));\n        composition.append(layer);\n      }\n      composition.append(image('right-main', 'csdn-taotoken-motion__main', 811, 679));\n      stage.append(composition);\n      \u002F\u002F No delayed JS animation jobs: CSS cancels pending transitions on reversal.\n      Promise.all(Array.from(stage.querySelectorAll('img'), img =\u003E img.decode())).then(() =\u003E {\n        link.dataset.ready = 'true';\n      }).catch(() =\u003E {\n        link.dataset.ready = 'false'; \u002F\u002F Keep text + accessible link if any art fails.\n      });\n    }\n    host.replaceChildren(link);\n    const resize = () =\u003E {\n      const width = link.clientWidth;\n      const nominal = side === 'left' ? 320 : 360;\n      const maxScale = side === 'left' ? 1 : Math.min(4 \u002F 3, link.clientHeight \u002F 500);\n      link.style.setProperty('--tao-scale', (Math.min(maxScale, width \u002F nominal) * 0.94).toFixed(4));\n    };\n    resize();\n    if ('ResizeObserver' in window) {\n      const observer = new ResizeObserver(resize);\n      observer.observe(link);\n      const cleanup = () =\u003E observer.disconnect();\n      window.addEventListener('pagehide', cleanup, { once: true });\n      window.addEventListener('pageshow', event =\u003E {\n        if (event.persisted && link.isConnected) { observer.observe(link); resize(); }\n      });\n    }\n  }\n  function mountAll() {\n    const left = document.querySelector('[data-taotoken-slot=\"left\"], .simple-ad-slot-left .simple-ad-slot__fixed');\n    const right = document.querySelector('[data-taotoken-slot=\"right\"], .simple-ad-slot-right .simple-ad-slot__fixed');\n    if (left) mount(left, 'left');\n    if (right) mount(right, 'right');\n    return Boolean(left && right);\n  }\n  function init() {\n    if (mountAll()) return;\n    const observer = new MutationObserver(() =\u003E {\n      if (mountAll()) { observer.disconnect(); clearTimeout(timeout); }\n    });\n    observer.observe(document.body, { childList: true, subtree: true });\n    const timeout = setTimeout(() =\u003E observer.disconnect(), 10000);\n  }\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });\n  else init();\n})();\n\u003C\u002Fscript\u003E\u003Cimg class=\"pre-img-lasy\" data-src=\"https:\u002F\u002Fkunyu.csdn.net\u002F1.png?p=1127&adId=1112469&adBlockFlag=0&a=1112469&c=0&k=-&spm=3001.12025&d=1&t=3&u=6d67886fc1f444f4a79d5754a8b7574b\" style=\"display: block;width: 0px;height: 0px;\"\u003E\u003C\u002Fdiv\u003E","type":"0","source":1}},"staffDOList":[{"id":null,"communityId":381,"username":"community_269","userNickname":"下载资源悬赏专区社区","roleCode":1,"status":1,"createUsername":"","updateUsername":"","avatarUrl":"https:\u002F\u002Fprofile-avatar.csdnimg.cn\u002Fdefault.jpg!1","createTime":"2021-05-12 18:10:11","updateTime":"2021-05-12 18:10:11","lastLoginTime":"2021-05-12 18:10:11"}],"communityConfig":{"scoreType":0,"scoreItems":{"0":"给本帖投票","1":"锋芒小试，眼前一亮","2":"潜力巨大，未来可期","3":"持续贡献，值得关注","4":"成绩优异，大力学习","5":"贡献巨大，全力支持"}},"shouldApply":false,"subscribeAble":false,"operatorAble":false,"commentNeedJoinCommunity":false,"authorMemberInfo":null},"default2014LiveRoom":[{"itemType":"","description":"高峰论坛","title":"2022 技术英雄会","url":"https:\u002F\u002Flive.csdn.net\u002Froom\u002Fi