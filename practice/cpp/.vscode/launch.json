{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C++ 教程（Ubuntu：构建并用 GDB 调试）",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/athena-cpp",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "cpp: Build"
        },
        {
            "name": "C++ 教程（macOS：构建并用 LLDB 调试）",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/athena-cpp",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "cpp: Build",
            "initCommands": [
                "process handle SIGTERM --stop false --pass true --notify true"
            ]
        },
        {
            "name": "附加到 C++ 教程",
            "type": "cppdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}
