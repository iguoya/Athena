using Gtk 4.0;

Box chapter_page {
  orientation: vertical;
  spacing: 14;
  hexpand: true;
  vexpand: true;
  margin-top: 16;
  margin-start: 20;
  margin-end: 20;
  margin-bottom: 18;

  // 紧凑章节导语：由 chapter.icon/title/description 驱动；本章总纲
  // 按钮跟标题/简介放在同一个 Frame 里。
  Frame chapter_header_frame {
    hexpand: true;

    styles [
      "panel-frame"
    ]

    Box chapter_header {
      orientation: horizontal;
      spacing: 14;
      margin-top: 10;
      margin-bottom: 10;
      margin-start: 14;
      margin-end: 14;

      Image chapter_icon {
        name: "chapter_icon";
        pixel-size: 34;
        valign: center;
      }

      Box {
        orientation: vertical;
        spacing: 3;
        hexpand: true;
        valign: center;

        Label chapter_title_label {
          name: "chapter_title_label";
          halign: start;

          styles [
            "title-2"
          ]
        }

        Label chapter_description_label {
          name: "chapter_description_label";
          halign: start;
          wrap: true;
          xalign: 0;

          styles [
            "header-description"
          ]
        }
      }

      Button chapter_overview_button {
        name: "chapter_overview_button";
        label: "说明文档";
        valign: center;
        tooltip-text: "把本章标题、简介与全部知识点组成总纲请求放入剪贴板，并唤起本机 AI 助手";

        styles [
          "btn-sm",
          "btn-chapter-overview"
        ]
      }
    }
  }

  Separator {
    orientation: horizontal;
  }

  // 主体只保留章节知识点导航；源码、运行状态和观察结果迁到进程内
  // 主窗口内唯一的专注实验页。
  Frame {
    name: "topics_frame";
    label: "本章知识点";
    hexpand: true;
    vexpand: true;

    styles [
      "panel-frame",
      "group-frame"
    ]

    ScrolledWindow {
      hscrollbar-policy: never;
      hexpand: true;
      vexpand: true;

      ListBox topics_list {
        name: "topics_list";
        selection-mode: none;
        show-separators: true;

        styles [
          "topic-list"
        ]
      }
    }
  }

  // 底部说明只跟随当前激活的知识点，不再承担实验运行状态。
  Frame {
    height-request: 58;
    hexpand: true;

    styles [
      "knowledge-status-bar"
    ]

    Box {
      orientation: horizontal;
      spacing: 14;
      margin-top: 8;
      margin-start: 16;
      margin-end: 16;
      margin-bottom: 8;

      Image {
        icon-name: "dialog-information-symbolic";
        pixel-size: 24;
        valign: center;

        styles [
          "knowledge-status-icon"
        ]
      }

      Label knowledge_description_label {
        name: "knowledge_description_label";
        label: "选择知识点后，这里会显示对应的学习目标和实验提示。";
        halign: start;
        valign: center;
        hexpand: true;
        wrap: true;
        wrap-mode: word_char;
        xalign: 0;

        styles [
          "knowledge-status-text"
        ]
      }
    }
  }
}
