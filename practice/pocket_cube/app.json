{
  "id": "pocket-cube",
  "title": "PocketCube 2 阶魔方（旧版）",
  "group": "程序设计",
  "parent": "c-plus-plus",
  "description": "旧版，供参考：用 C++ 演示和操作 2 阶魔方的状态表示、旋转和展开图，没有求解。会求解的学习应用版见「二阶魔方」（pocket-cube-solver）。",
  "icon": {
    "type": "theme",
    "name": "applications-games-symbolic",
    "symbol": "cube",
    "letter": "魔",
    "accent": "#6F42C1",
    "file": "icon.svg",
    "renders": {
      "icon.png": 256,
      "icon.ico": "ico"
    }
  },
  "dev": {
    "prepare": [
      {
        "when_missing": "build",
        "run": [
          "meson",
          "setup",
          "build",
          "--buildtype=debug"
        ],
        "label": "配置构建目录"
      },
      {
        "run": [
          "meson",
          "compile",
          "-C",
          "build"
        ],
        "label": "增量编译"
      }
    ],
    "run": [
      "build/pocket-cube"
    ],
    "ready": "process",
    "match": "build",
    "binary": "pocket-cube"
  }
}
