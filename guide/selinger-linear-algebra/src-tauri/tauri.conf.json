{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "athena-selinger-linear-algebra",
  "version": "10.0.0",
  "identifier": "cn.athena.selinger-linear-algebra",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1517",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Selinger 线性代数",
        "width": 1500,
        "height": 960,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../content"
    ]
  }
}
