      "sha": "4829bda83799",
      "zh": ""
     }
    }
   ],
   "sol": [
    {
     "k": "math",
     "tex": "\\begin{array}{rcl}\\left[\\begin{array}{cc}\n        1 & 2 \\\\\n        3 & 4\n      \\end{array}\\right] \\left[\\begin{array}{cc}\n        1 & 2 \\\\\n        1 & k\n      \\end{array}\\right] &=& \\left[\\begin{array}{cc}\n        3 & 2k+2 \\\\\n        7 & 4k+6\n      \\end{array}\\right], \\\\\n      \\left[\\begin{array}{cc}\n        1 & 2 \\\\\n        1 & k\n      \\end{array}\\right] \\left[\\begin{array}{cc}\n        1 & 2 \\\\\n        3 & 4\n      \\end{array}\\right] &=& \\left[\\begin{array}{cc}\n        7 & 10 \\\\\n        3k+1 & 4k+2\n      \\end{array}\\right].\\end{array}"
    },
    {
     "k": "p",
     "t": {
      "en": "However, $7\\neq 3$ and so there is no possible choice of $k$ which will make these matrices commute.",
      "sha": "d80cb019690c",
      "zh": ""
     }
    }
