     }
    },
    {
     "k": "math",
     "tex": "(a)~ \\left[\\begin{array}{r} 1 \\\\ 0 \\\\ 0 \\end{array}\\right],\\quad\n    (b)~ \\left[\\begin{array}{r} 0 \\\\ 1 \\\\ -1 \\end{array}\\right],\\quad\n    (c)~ \\left[\\begin{array}{r} 2 \\\\ 1 \\\\ 0 \\end{array}\\right],\\quad\n    (d)~ \\left[\\begin{array}{r} 0 \\\\ 0 \\\\ 0 \\end{array}\\right],\\quad\n    (e)~ \\left[\\begin{array}{r} 1 \\\\ 0 \\\\ 3 \\end{array}\\right].\\quad"
    }
   ],
   "sol": [
