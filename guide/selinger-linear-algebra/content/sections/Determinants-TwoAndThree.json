     "k": "math",
     "tex": "(a)~\\left[\\begin{array}{rr}\n      1 & 3 \\\\\n      0 & 2\n    \\end{array}\\right]\n    \\quad\n    (b)~\\left[\\begin{array}{rr}\n      0 & 3 \\\\\n      0 & 2\n    \\end{array}\\right]\n    \\quad\n    (c)~\\left[\\begin{array}{rr}\n      4 & 3 \\\\\n      6 & 2\n    \\end{array}\\right]\n    \\quad\n    (d)~\\left[\\begin{array}{rr}\n      -3 & 4 \\\\\n      -1 & 2\n    \\end{array}\\right]"
    }
   ],
