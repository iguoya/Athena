     "url": "https://github.com/selinger/linear-algebra/blob/master/baseText/exercises/InnerProductSpaces-GramSchmidt.tex"
    }
   ]
  },
  {
   "id": "ex2",
   "stem": [
    {
     "k": "p",
     "t": {
      "en": "In $\\R^4$ with the usual dot product, find an orthogonal basis for",
      "sha": "e63e5e3cefbb",
      "zh": ""
     }
    },
    {
     "k": "math",
     "tex": "\\sspan\\set{\n      \\left[\\begin{array}{c} 0 \\\\ 1 \\\\ 1 \\\\  0 \\end{array}\\right],~\n      \\left[\\begin{array}{c} 3 \\\\ 0 \\\\ 2 \\\\ -1 \\end{array}\\right]\n    }."
    }
   ],
   "sol": [
    {
     "k": "p",
     "t": {
      "en": "$\\vect{u}_1 = \\left[\\begin{array}{c} 0 \\\\ 1 \\\\ 1 \\\\ 0 \\end{array}\\right]$, $\\vect{u}_2 = \\left[\\begin{array}{c} 3 \\\\ -1 \\\\ 1 \\\\ -1 \\end{array}\\right]$.",
      "sha": "ba6415516ee8",
      "zh": ""
     }
    }
   ],
   "source_refs": [
    {
     "relation": "verbatim",
     "site": "Selinger《Linear Algebra: A First Course》（CC BY 4.0 开源教材）",
     "locator": "The Gram-Schmidt orthogonalization procedure · 习题 2（上游 exercises/InnerProductSpaces-GramSchmidt.tex）",
     "url": "https://github.com/selinger/linear-algebra/blob/master/baseText/exercises/InnerProductSpaces-GramSchmidt.tex"
    }
   ]
  },
  {
   "id": "ex3",
   "stem": [
    {
     "k": "p",
     "t": {
      "en": "In $\\R^4$ with the usual dot product, find an orthogonal basis for",
      "sha": "e63e5e3cefbb",
      "zh": ""
     }
    },
