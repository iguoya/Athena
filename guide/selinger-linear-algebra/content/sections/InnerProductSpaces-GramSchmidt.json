      "en": "$\\vect{u}_1 = \\left[\\begin{array}{c} 1 \\\\ 2 \\\\ 3 \\end{array}\\right]$, $\\vect{u}_2 = \\left[\\begin{array}{c} 1 \\\\ 4 \\\\ -3 \\end{array}\\right]$.",
      "sha": "a9bd987361c4",
      "zh": ""
     }
    }
   ],
   "source_refs": [
