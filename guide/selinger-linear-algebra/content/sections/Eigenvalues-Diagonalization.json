    }
   ]
  },
  {
   "id": "ex2",
   "stem": [
    {
     "k": "p",
     "t": {
      "en": "Find the eigenvalues and eigenvectors of the matrix",
      "sha": "95c965d190fc",
      "zh": ""
     }
    },
    {
     "k": "math",
     "tex": "\\left[\\begin{array}{rrr}\n      -13 & -28 & 28 \\\\\n      4 & 9 & -8 \\\\\n      -4 & -8 & 9\n    \\end{array}\\right]."
    },
    {
     "k": "p",
     "t": {
      "en": "One eigenvalue is $3$. Diagonalize if possible.",
      "sha": "7ee1aa97df11",
      "zh": ""
     }
    }
   ],
   "sol": [
    {
     "k": "p",
     "t": {
      "en": "The eigenvectors and eigenvalues are:",
      "sha": "53e1f61f3559",
      "zh": ""
     }
    },
    {
     "k": "math",
