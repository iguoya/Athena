{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-G",
        "Ninja",
        "-S",
        ".",
        "-B",
        "build"
      ],
      "options": {
        "env": {
          "PATH": "C:/msys64/mingw64/bin;${env:PATH}",
          "PKG_CONFIG_PATH": "C:/msys64/mingw64/lib/pkgconfig"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build"
      ],
      "options": {
        "env": {
          "PATH": "C:/msys64/mingw64/bin;${env:PATH}",
          "PKG_CONFIG_PATH": "C:/msys64/mingw64/lib/pkgconfig"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": "configure",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "run",
      "type": "shell",
      "command": "./build/example-buttons-button",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:/msys64/mingw64/bin;${env:PATH}"
        }
      },
      "dependsOn": "build",
      "problemMatcher": []
    }
  ]
}
