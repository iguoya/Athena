{
  "course": {
    "id": "linear-algebra",
    "title": "线性代数（自考）",
    "code": "13175 / 02198",
    "textbook": {
      "title": "线性代数（工）",
      "authors": "申亚男、卢刚",
      "press": "北京大学出版社",
      "year": "2023",
      "note": "全国高等教育自学考试指定教材，附自学考试大纲。章节结构跟随教材目录；节级划分在逐章编写时与教材实物核对，发现出入以版权页目录为准。课改过渡期，报考代码以所在省考试院当年安排为准。"
    },
    "method": {
      "primary": "问题解决",
      "secondary": "检索强化"
    }
  },
  "chapters": [
    {
      "id": "ch1",
      "no": "第一章",
      "title": "行列式",
      "sections": [
        {
          "id": "ch1-sec1",
          "no": "§1.1",
          "title": "行列式的定义",
          "knowledge": [
            "linalg.det2x2",
            "linalg.det3x3",
            "linalg.det2x2_geometry"
          ]
        },
        {
          "id": "ch1-sec2",
          "no": "§1.2",
          "title": "行列式的性质",
          "knowledge": [
            "linalg.det_props",
            "linalg.det_row_ops"
          ]
        },
        {
          "id": "ch1-sec3",
          "no": "§1.3",
          "title": "行列式按一行（或一列）展开",
          "knowledge": [
            "linalg.det_cofactor",
            "linalg.det_expansion",
            "linalg.det_alien_cofactor"
          ]
        },
        {
          "id": "ch1-sec5",
          "no": "§1.5",
          "title": "克拉默（Cramer）法则",
          "knowledge": [
            "linalg.cramer",
            "linalg.cramer_homogeneous"
          ]
        }
      ]
    },
    {
      "id": "ch2",
      "no": "第二章",
      "title": "矩阵",
      "sections": [
        {
          "id": "ch2-sec1",
          "no": "§2.1",
          "title": "矩阵的概念",
          "knowledge": [
            "linalg.matrix_def",
            "linalg.special_matrices"
          ]
        },
        {
          "id": "ch2-sec2",
          "no": "§2.2",
          "title": "矩阵的运算",
          "knowledge": [
            "linalg.mat_mul",
            "linalg.mat_noncomm",
            "linalg.mat_transpose",
            "linalg.mat_power"
          ]
        },
        {
          "id": "ch2-sec3",
          "no": "§2.3",
          "title": "矩阵的分块",
          "knowledge": [
            "linalg.block_ops"
          ]
        },
        {
          "id": "ch2-sec4",
          "no": "§2.4",
          "title": "可逆矩阵",
          "knowledge": [
            "linalg.inverse_def",
            "linalg.adjugate_inverse",
            "linalg.inverse_props",
            "linalg.matrix_equation"
          ]
        },
        {
          "id": "ch2-sec5",
          "no": "§2.5",
          "title": "矩阵的初等变换和初等矩阵",
          "knowledge": [
            "linalg.elementary_matrix",
            "linalg.inverse_by_rowop"
          ]
        },
        {
          "id": "ch2-sec6",
          "no": "§2.6",
          "title": "矩阵的秩",
          "knowledge": [
            "linalg.rank_def",
            "linalg.rank_by_echelon",
            "linalg.rank_props"
          ]
        }
      ]
    },
    {
      "id": "ch3",
      "no": "第三章",
      "title": "向量空间",
      "sections": [
        {
          "id": "ch3-sec1",
          "no": "§3.1",
          "title": "n 维向量空间 Rⁿ",
          "knowledge": [
            "linalg.vector_ops",
            "linalg.linear_combination"
          ]
        },
        {
          "id": "ch3-sec2",
          "no": "§3.2",
          "title": "向量间的线性关系",
          "knowledge": [
            "linalg.lin_dep_def",
            "linalg.lin_dep_test"
          ]
        },
        {
          "id": "ch3-sec3",
          "no": "§3.3",
          "title": "向量组的极大线性无关组",
          "knowledge": [
            "linalg.max_indep",
            "linalg.max_indep_find"
          ]
        },
        {
          "id": "ch3-sec4",
          "no": "§3.4",
          "title": "向量组的秩与矩阵的秩",
          "knowledge": [
            "linalg.vector_rank",
            "linalg.rep_by_rank"
          ]
        },
        {
          "id": "ch3-sec5",
          "no": "§3.5",
          "title": "Rⁿ 的标准正交基",
          "knowledge": [
            "linalg.inner_product",
            "linalg.orthonormal",
            "linalg.gram_schmidt"
          ]
        }
      ]
    },
    {
      "id": "ch4",
      "no": "第四章",
      "title": "线性方程组",
      "sections": [
        {
          "id": "ch4-sec1",
          "no": "§4.1",
          "title": "高斯消元法",
          "knowledge": [
            "linalg.linear_system",
            "linalg.gauss_elim"
          ]
        },
        {
          "id": "ch4-sec2",
          "no": "§4.2",
          "title": "齐次线性方程组",
          "knowledge": [
            "linalg.homog_solution",
            "linalg.fundamental_system"
          ]
        },
        {
          "id": "ch4-sec3",
          "no": "§4.3",
          "title": "非齐次线性方程组",
          "knowledge": [
            "linalg.nonhomog_criterion",
            "linalg.nonhomog_structure",
            "linalg.param_system"
          ]
        }
      ]
    },
    {
      "id": "ch5",
      "no": "第五章",
      "title": "矩阵的相似对角化",
      "sections": [
        {
          "id": "ch5-sec1",
          "no": "§5.1",
          "title": "特征值与特征向量",
          "knowledge": [
            "linalg.eigen_def",
            "linalg.eigen_compute",
            "linalg.eigen_props"
          ]
        },
        {
          "id": "ch5-sec2",
          "no": "§5.2",
          "title": "相似矩阵与矩阵的对角化",
          "knowledge": [
            "linalg.similar",
            "linalg.diagonalizable",
            "linalg.diagonalize_compute"
          ]
        },
        {
          "id": "ch5-sec3",
          "no": "§5.3",
          "title": "实对称矩阵的对角化",
          "knowledge": [
            "linalg.symmetric_props",
            "linalg.orthogonal_diagonalize"
          ]
        }
      ]
    },
    {
      "id": "ch6",
      "no": "第六章",
      "title": "实二次型",
      "sections": [
        {
          "id": "ch6-sec1",
          "no": "§6.1",
          "title": "二次型的定义及其矩阵表示",
          "knowledge": [
            "linalg.quadratic_def",
            "linalg.quadratic_matrix",
            "linalg.congruence"
          ]
        },
        {
          "id": "ch6-sec2",
          "no": "§6.2",
          "title": "实二次型的标准形",
          "knowledge": [
            "linalg.standard_form",
            "linalg.orth_transform",
            "linalg.completing_square",
            "linalg.inertia"
          ]
        },
        {
          "id": "ch6-sec3",
          "no": "§6.3",
          "title": "正定二次型与正定矩阵",
          "knowledge": [
            "linalg.pos_def_concept",
            "linalg.pos_def_test"
          ]
        }
      ]
    }
  ]
}
