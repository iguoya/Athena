          "id": "ch1-sec1",
          "no": "§1",
          "title": "空间直角坐标系",
          "knowledge": [
            "advmath.coord_sys",
            "advmath.point_distance"
          ]
        },
        {
          "id": "ch1-sec2",
          "no": "§2",
