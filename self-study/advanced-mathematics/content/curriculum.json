{
  "course": {
    "id": "advanced-mathematics",
    "title": "高等数学（工本）",
    "code": "00023",
    "textbook": {
      "title": "高等数学（工本）",
      "authors": "陈兆斗等",
      "press": "北京大学出版社",
      "year": "2023",
      "note": "全国高等教育自学考试指定教材，附自学考试大纲。全书六章（空间解析几何与向量代数、多元函数微分学、重积分、曲线积分与曲面积分、常微分方程、无穷级数），不含一元微积分——一元微积分是先修（专科段高等数学（工专）的内容），需要时以 prereq 层补缺口。章节结构跟随教材目录；节级划分在逐章编写时与教材实物核对，发现出入以版权页目录为准。主编署名以教材版权页为准。"
    },
    "method": {
      "primary": "问题解决",
      "secondary": "检索强化"
    }
  },
  "chapters": [
    {
      "id": "ch1",
      "no": "第一章",
      "title": "空间解析几何与向量代数",
      "sections": [
        {
          "id": "ch1-sec1",
          "no": "§1",
          "title": "空间直角坐标系",
          "knowledge": [
            "advmath.coord_sys",
            "advmath.point_distance"
          ]
        },
        {
          "id": "ch1-sec2",
          "no": "§2",
          "title": "向量代数",
          "knowledge": [
            "advmath.vec_basic",
            "advmath.vec_linear",
            "advmath.vec_coord_norm",
            "advmath.dir_cosine",
            "advmath.projection"
          ]
        },
        {
          "id": "ch1-sec3",
          "no": "§3",
          "title": "向量的数量积与向量积",
          "knowledge": [
            "advmath.dot_product",
            "advmath.angle_perp",
            "advmath.cross_product",
            "advmath.cross_applications"
          ]
        },
        {
          "id": "ch1-sec4",
          "no": "§4",
          "title": "空间中的曲面和曲线",
          "knowledge": [
            "advmath.surface_eq",
            "advmath.cylinder_rotation",
            "advmath.space_curve"
          ]
        },
        {
          "id": "ch1-sec5",
          "no": "§5",
          "title": "空间中的平面与直线",
          "knowledge": [
            "advmath.plane_eq",
            "advmath.line_eq",
            "advmath.plane_line_relation"
          ]
        },
        {
          "id": "ch1-sec6",
          "no": "§6",
          "title": "二次曲面",
          "knowledge": [
            "advmath.quadric_standard",
            "advmath.quadric_sections"
          ]
        }
      ]
    },
    {
      "id": "ch2",
      "no": "第二章",
      "title": "多元函数的微分学",
      "sections": [
        {
          "id": "ch2-sec1",
          "no": "§1",
          "title": "多元函数的基本概念",
          "knowledge": [
            "advmath.func_two_vars",
            "advmath.limit_multi",
            "advmath.continuity_multi"
          ]
        },
        {
          "id": "ch2-sec2",
          "no": "§2",
          "title": "偏导数与全微分",
          "knowledge": [
            "advmath.partial_deriv",
            "advmath.higher_partial",
            "advmath.total_diff"
          ]
        },
        {
          "id": "ch2-sec3",
          "no": "§3",
          "title": "复合函数与隐函数的导数和偏导数",
          "knowledge": [
            "advmath.chain_rule",
            "advmath.implicit_func"
          ]
        },
        {
          "id": "ch2-sec4",
          "no": "§4",
          "title": "偏导数的应用",
          "knowledge": [
            "advmath.extremum",
            "advmath.lagrange",
            "advmath.tangent_plane",
            "advmath.directional_grad"
          ]
        }
      ]
    },
