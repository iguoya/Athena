// 启动器的全部界面。声明式写法，和项目里的 .blp（GTK）、.qml（Qt）是同一种思路：
// 布局写在这里，Rust 只负责填数据和响应回调。

import { ScrollView } from "std-widgets.slint";

/// 一条学科之间的关系：谁从谁长出来的，按 apps 里的下标指。
export struct LinkSpec {
    from: int,
    to: int,
}

export struct AppEntry {
    id: string,
    title: string,
    // 图块里的图标，来自应用自己的 icon.svg；没有图标时用 letter 顶上。
    icon: image,
    has-icon: bool,
    // 图块里的字，取自 app.json 的 icon.letter（"C++"、"算"）。
    letter: string,
    // 图块底色，取自 icon.accent，用各自技术生态的惯用色；常驻显示，
    // 不随运行状态变化（见 Tile 的 plate-color）。
    accent: color,
    // 运行状态点的颜色：绿=运行中、橙=启动中、灰=未运行。
    tint: brush,
    running: bool,
    starting: bool,
}

component Tile inherits Rectangle {
    in property <AppEntry> entry;
    callback open();
    callback stop();

    width: 116px;
    height: 124px;
    border-radius: 12px;
    background: touch.has-hover ? #00000010 : transparent;
    animate background { duration: 120ms; }

    // 图块里的东西全部绝对定位，共用同一条中轴线。交给 VerticalLayout 排的话，
    // 定宽的色块和整宽居中的标题各按各的算，看着就是散的。
    property <length> hub: 56px;
    property <length> hub-top: 10px;

    // 色块常驻应用自己的 accent 原色——未运行也不褪灰。运行态用 accent 光环
    // + 同色投影，每个应用颜色不同，不再共用一颗单调绿点。
    property <brush> plate-color: entry.accent;
    property <bool> live: entry.running;

    // 运行态光环：贴在色块外侧，颜色跟 accent 走。
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.hub-top + (root.hub - self.height) / 2;
        width: root.live ? root.hub + 10px : root.hub + 2px;
        height: self.width;
        border-radius: self.width / 3.2;
        background: transparent;
        border-width: root.live ? 2.5px : 0px;
        border-color: entry.accent;
        opacity: root.live ? (entry.starting ? 0.55 : 0.85) : 0;
        drop-shadow-blur: root.live ? (entry.starting ? 16px : 12px) : 0px;
        drop-shadow-color: entry.accent;
        animate width, opacity, drop-shadow-blur, border-width {
            duration: 180ms;
            easing: ease-out;
        }
    }

    plate := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.hub-top + (root.hub - self.height) / 2;
        width: touch.has-hover || root.live ? root.hub + 3px : root.hub;
        height: self.width;
        border-radius: self.width / 3.6;
        background: root.plate-color;
        drop-shadow-blur: root.live ? 14px : (touch.has-hover ? 10px : 5px);
        drop-shadow-offset-y: root.live ? 0px : (touch.has-hover ? 3px : 1px);
        drop-shadow-color: root.live ? entry.accent : #00000024;
        animate width, drop-shadow-blur, drop-shadow-offset-y, drop-shadow-color, background {
            duration: 140ms;
            easing: ease-out;
        }

        Image {
            source: entry.icon;
            visible: entry.has-icon;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: parent.width * 0.56;
            height: self.width;
            image-fit: contain;
        }

        Text {
            text: entry.letter;
            visible: !entry.has-icon;
            color: white;
            font-size: entry.letter.character-count > 1 ? 19px : 24px;
            font-weight: 600;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 标题紧跟色块，两者当成一组；状态另起一行，离得开一点。
    Text {
        x: 4px;
        y: root.hub-top + root.hub + 8px;
        width: parent.width - 8px;
        text: entry.title;
        font-size: 12px;
        color: #1c1c1e;
        horizontal-alignment: center;
        overflow: elide;
    }

    // 状态点：运行中更大并带同色光晕；tint 仍由 Rust 按三态算好。
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.hub-top + root.hub + 28px;
        width: root.live ? 9px : 6px;
        height: self.width;
        border-radius: self.width / 2;
        background: entry.tint;
        drop-shadow-blur: root.live ? 8px : 0px;
        drop-shadow-color: entry.tint;
        animate width, drop-shadow-blur {
            duration: 160ms;
            easing: ease-out;
        }
    }

    touch := TouchArea {
        clicked => { root.open(); }
    }

    // 悬停时右上角出现停止按钮，只对正在运行的显示。
    Rectangle {
        x: parent.width - 28px;
        y: 8px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        visible: entry.running && (touch.has-hover || stop-touch.has-hover);
        background: stop-touch.has-hover ? #d32f2f : #0000002e;

        stop-touch := TouchArea {
            clicked => { root.stop(); }
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 1.5px;
                background: white;
            }
        }
    }
}

// 实践面板用：跟学习应用那张图谱不同，没有"谁从谁长出来"的演进关系可画
// （practice/ 下的小项目彼此独立），复用同一个 Tile，去掉连线那一套。
component PracticeGrid inherits ScrollView {
    in property <[AppEntry]> apps;
    callback open(string);
    callback stop(string);

    property <int> columns: max(1, floor(self.width / 124px));
    property <int> rows: max(1, floor((apps.length + self.columns - 1) / self.columns));
    property <length> stride-x: 124px;
    property <length> stride-y: 132px;
    viewport-width: self.width;
    viewport-height: max(self.height, self.rows * self.stride-y);

    for entry[index] in apps: Tile {
        x: mod(index, columns) * stride-x;
        y: floor(index / columns) * stride-y;
        entry: entry;
        open => { root.open(entry.id); }
        stop => { root.stop(entry.id); }
    }
}

export component LauncherWindow inherits Window {
    in property <[AppEntry]> apps;
    // 实践面板：跟学习应用区隔开的独立分区（practice/ 下的小项目），
    // 侧重动手练习，不是知识学习——两者背后是同一套发现和启动逻辑，只是
    // 数据源（发现根目录）和界面分区不同。空的时候整个分区隐藏，不占地方。
    in property <[AppEntry]> practice-apps;
    in property <string> status;
    in property <[LinkSpec]> links;
    // 必须点名带简体的 UI 字体。Slint 缺字回退在英文 Windows 上会先命中
    // Yu Gothic，简体独有的「语」「习」「结」直接空白。具体家族名由 Rust 按
    // 平台填进来，这里只负责接到 Window 的默认字体上。
    in property <string> ui-font: "sans-serif";
    callback open(string);
    callback stop(string);

    title: "Athena 启动器";
    // 标题栏左上角：与托盘、任务栏同一份虎头（build.rs 从 tiger.svg 裁出）。
    icon: @image-url("../assets/tiger-mark.png");
    default-font-family: ui-font;
    // 初始大小按三列两行估：现在有六个学习应用，窄窗口改走滚动，不裁掉后排。
    preferred-width: 404px;
    preferred-height: 420px;
    min-width: 280px;
    min-height: 280px;
    background: #fbfbfd;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        Text {
            text: "学习应用";
            font-size: 12px;
            font-weight: 600;
            color: #8a8a8e;
            height: 20px;
        }

        graph := ScrollView {
            // 按内容实际的行数定高，不铺满剩余空间——不然只有六七个应用时
            // 这块区域会占满整个窗口，实践面板被挤到底部，中间空出一大截。
            // 内容超出窗口才需要滚动，用 min() 卡个上限，避免窗口本来就矮时
            // 这块还硬要按满行数撑高，反而把下面的实践面板推出可视区域。
            height: min(self.rows * self.stride-y, 320px);

            // 一行放得下几个由当前宽度决定，窗口拉大就多排几个。
            property <int> columns: max(1, floor(self.width / 124px));
            property <int> rows: max(1, floor((root.apps.length + self.columns - 1) / self.columns));
            property <length> stride-x: 124px;
            property <length> stride-y: 132px;
            viewport-width: self.width;
            viewport-height: max(self.height, self.rows * self.stride-y);
            // 图块内那个圆角色块的中心，连线从这里出发、到这里收尾。
            property <length> hub-x: 58px;
            property <length> hub-y: 38px;

            // 学科之间的历史演进关系（C++ 从 C 长出来）。画法照搬 C++ 教程首页
            // 那张学科图谱（subjects/cpp/render/domain_graph_view.cc）：两个控制点
            // 都落在两个节点之间的中线上，出来就是一条规整的 S 形；箭头是实心
            // 三角；颜色淡到退成背景，不喧宾夺主。
            for link in root.links: edge := Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;

                property <int> from-col: mod(link.from, graph.columns);
                property <int> from-row: floor(link.from / graph.columns);
                property <int> to-col: mod(link.to, graph.columns);
                property <int> to-row: floor(link.to / graph.columns);
                // 同一行就左右连（从色块右缘到左缘），跨行就上下连（底缘到顶缘）
                // ——和图谱里"上一层指向下一层"是同一个手法，只是转了 90 度。
                property <bool> sideways: from-row == to-row;
                property <float> half: 28;

                property <float> x0: (from-col * graph.stride-x + graph.hub-x) / 1px
                    + (sideways ? (to-col > from-col ? half : -half) : 0);
                property <float> y0: (from-row * graph.stride-y + graph.hub-y) / 1px
                    + (sideways ? 0 : half);
                property <float> x1: (to-col * graph.stride-x + graph.hub-x) / 1px
                    + (sideways ? (to-col > from-col ? -half : half) : 0);
                property <float> y1: (to-row * graph.stride-y + graph.hub-y) / 1px
                    + (sideways ? 0 : -half);
                property <float> mid: sideways ? (x0 + x1) / 2 : (y0 + y1) / 2;
                // 线在离箭头 7 处收住，剩下的交给三角形，不然线头会从尖端支出来。
                property <float> tip: 7;
                property <float> back: sideways ? (x1 > x0 ? -tip : tip) : -tip;

                Path {
                    x: 0; y: 0;
                    width: parent.width;
                    height: parent.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: parent.width / 1px;
                    viewbox-height: parent.height / 1px;
                    stroke: #bcc4ce;
                    stroke-width: 1.6px;

                    MoveTo { x: edge.x0; y: edge.y0; }
                    CubicTo {
                        control-1-x: edge.sideways ? edge.mid : edge.x0;
                        control-1-y: edge.sideways ? edge.y0 : edge.mid;
                        control-2-x: edge.sideways ? edge.mid : edge.x1;
                        control-2-y: edge.sideways ? edge.y1 : edge.mid;
                        x: edge.sideways ? edge.x1 + edge.back : edge.x1;
                        y: edge.sideways ? edge.y1 : edge.y1 + edge.back;
                    }
                }

                // 实心三角：尖端顶在目标色块的边上。
                Path {
                    x: 0; y: 0;
                    width: parent.width;
                    height: parent.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: parent.width / 1px;
                    viewbox-height: parent.height / 1px;
                    fill: #bcc4ce;

                    MoveTo { x: edge.x1; y: edge.y1; }
                    LineTo {
                        x: edge.sideways ? edge.x1 + edge.back * 1.15 : edge.x1 - 5;
                        y: edge.sideways ? edge.y1 - 5 : edge.y1 + edge.back * 1.15;
                    }
                    LineTo {
                        x: edge.sideways ? edge.x1 + edge.back * 1.15 : edge.x1 + 5;
                        y: edge.sideways ? edge.y1 + 5 : edge.y1 + edge.back * 1.15;
                    }
                    Close {}
                }
            }

            for entry[index] in apps: Tile {
                x: mod(index, graph.columns) * graph.stride-x;
                y: floor(index / graph.columns) * graph.stride-y;
                entry: entry;
                open => { root.open(entry.id); }
                stop => { root.stop(entry.id); }
            }
        }

        if practice-apps.length > 0: Rectangle {
            height: 1px;
            background: #e5e5ea;
        }

        if practice-apps.length > 0: Text {
            text: "实践面板";
            font-size: 12px;
            font-weight: 600;
            color: #8a8a8e;
            height: 20px;
        }

        if practice-apps.length > 0: PracticeGrid {
            height: 132px;
            apps: practice-apps;
            open(id) => { root.open(id); }
            stop(id) => { root.stop(id); }
        }

        // 吸收窗口拉大之后多出来的空间：两个面板紧跟着排，不会被这块
        // 撑开的空白隔在中间——多余的高度全部堆到这里，状态栏底下。
        Rectangle { vertical-stretch: 1; }

        Text {
            text: status;
            font-size: 11px;
            color: #8a8a8e;
            wrap: word-wrap;
            height: 28px;
        }
    }
}
