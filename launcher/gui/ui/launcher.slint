// 启动器的全部界面。声明式写法，和项目里的 .blp（GTK）、.qml（Qt）是同一种思路：
// 布局写在这里，Rust 只负责填数据和响应回调。

import { ScrollView } from "std-widgets.slint";

export struct AppEntry {
    id: string,
    title: string,
    // 图块里的字，取自 app.json 的 icon.letter（"C++"、"算"）。
    letter: string,
    // 图块底色，取自 icon.accent，用各自技术生态的惯用色。
    accent: brush,
    state: string,
    // 状态点的颜色：绿=运行中、橙=启动中、灰=未运行，按通行约定。
    tint: brush,
    running: bool,
}

component Tile inherits Rectangle {
    in property <AppEntry> entry;
    callback open();
    callback stop();

    width: 116px;
    height: 124px;
    border-radius: 10px;
    background: touch.has-hover ? #00000010 : transparent;

    touch := TouchArea {
        clicked => { root.open(); }

        VerticalLayout {
            padding: 10px;
            spacing: 7px;
            alignment: start;

            // 图块：圆角方块 + 一到三个字。三个 Tauri 应用的自带图标是同一张
            // 模板图，区分不了谁是谁，所以按字和配色来认。
            Rectangle {
                width: 56px;
                height: 56px;
                horizontal-stretch: 0;
                border-radius: 14px;
                background: entry.accent;
                opacity: entry.running ? 1.0 : 0.72;

                Text {
                    text: entry.letter;
                    color: white;
                    font-size: entry.letter.character-count > 1 ? 19px : 24px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: entry.title;
                font-size: 12px;
                color: #1c1c1e;
                horizontal-alignment: center;
                overflow: elide;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 5px;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    y: 4px;
                    border-radius: 3px;
                    background: entry.tint;
                }

                Text {
                    text: entry.state;
                    font-size: 10px;
                    color: #6b6b70;
                }
            }
        }
    }

    // 悬停时右上角出现停止按钮，只对正在运行的显示。
    stop-button := Rectangle {
        x: parent.width - 26px;
        y: 6px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        visible: entry.running && (touch.has-hover || stop-touch.has-hover);
        background: stop-touch.has-hover ? #d32f2f : #00000026;

        stop-touch := TouchArea {
            clicked => { root.stop(); }
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 1px;
                background: stop-touch.has-hover ? white : #4a4a4f;
            }
        }
    }
}

export component LauncherWindow inherits Window {
    in property <[AppEntry]> apps;
    in property <string> status;
    callback open(string);
    callback stop(string);

    title: "Athena 启动器";
    width: 392px;
    height: 356px;
    background: #fbfbfd;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        Text {
            text: "学习应用";
            font-size: 12px;
            font-weight: 600;
            color: #8a8a8e;
            height: 20px;
        }

        ScrollView {
            vertical-stretch: 1;
            GridLayout {
                spacing: 2px;
                for entry[index] in apps: Tile {
                    row: floor(index / 3);
                    col: mod(index, 3);
                    entry: entry;
                    open => { root.open(entry.id); }
                    stop => { root.stop(entry.id); }
                }
            }
        }

        Text {
            text: status;
            font-size: 11px;
            color: #8a8a8e;
            wrap: word-wrap;
            height: 28px;
        }
    }
}
