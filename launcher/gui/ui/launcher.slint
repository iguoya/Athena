// 启动器的全部界面。声明式写法，和项目里的 .blp（GTK）、.qml（Qt）是同一种思路：
// 布局写在这里，Rust 只负责填数据和响应回调。

import { ScrollView } from "std-widgets.slint";

/// 一条学科之间的关系：谁从谁长出来的，按 apps 里的下标指。
export struct LinkSpec {
    from: int,
    to: int,
}

export struct AppEntry {
    id: string,
    title: string,
    // 图块里的图标，来自应用自己的 icon.svg；没有图标时用 letter 顶上。
    icon: image,
    has-icon: bool,
    // 图块里的字，取自 app.json 的 icon.letter（"C++"、"算"）。
    letter: string,
    // 图块底色，取自 icon.accent，用各自技术生态的惯用色。
    accent: brush,
    state: string,
    // 状态点的颜色：绿=运行中、橙=启动中、灰=未运行，按通行约定。
    tint: brush,
    running: bool,
}

component Tile inherits Rectangle {
    in property <AppEntry> entry;
    callback open();
    callback stop();

    width: 116px;
    height: 124px;
    border-radius: 10px;
    background: touch.has-hover ? #00000010 : transparent;

    touch := TouchArea {
        clicked => { root.open(); }

        VerticalLayout {
            padding: 10px;
            spacing: 7px;
            alignment: start;

            // 图块：圆角方块 + 一到三个字。三个 Tauri 应用的自带图标是同一张
            // 模板图，区分不了谁是谁，所以按字和配色来认。
            Rectangle {
                width: 56px;
                height: 56px;
                horizontal-stretch: 0;
                border-radius: 14px;
                background: entry.accent;
                opacity: entry.running ? 1.0 : 0.72;

                // 图标和文字都铺满图块再居中：只设对齐方式的话，它们按自身
                // 尺寸定位，看起来会偏。
                Image {
                    source: entry.icon;
                    visible: entry.has-icon;
                    width: 30px;
                    height: 30px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    image-fit: contain;
                }

                Text {
                    text: entry.letter;
                    visible: !entry.has-icon;
                    color: white;
                    font-size: entry.letter.character-count > 1 ? 19px : 24px;
                    font-weight: 600;
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: entry.title;
                font-size: 12px;
                color: #1c1c1e;
                horizontal-alignment: center;
                overflow: elide;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 5px;

                Rectangle {
                    width: 6px;
                    height: 6px;
                    y: 4px;
                    border-radius: 3px;
                    background: entry.tint;
                }

                Text {
                    text: entry.state;
                    font-size: 10px;
                    color: #6b6b70;
                }
            }
        }
    }

    // 悬停时右上角出现停止按钮，只对正在运行的显示。
    stop-button := Rectangle {
        x: parent.width - 26px;
        y: 6px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        visible: entry.running && (touch.has-hover || stop-touch.has-hover);
        background: stop-touch.has-hover ? #d32f2f : #00000026;

        stop-touch := TouchArea {
            clicked => { root.stop(); }
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 1px;
                background: stop-touch.has-hover ? white : #4a4a4f;
            }
        }
    }
}

export component LauncherWindow inherits Window {
    in property <[AppEntry]> apps;
    in property <string> status;
    in property <[LinkSpec]> links;
    callback open(string);
    callback stop(string);

    title: "Athena 启动器";
    // 初始大小，不是上限：窗口可以拉大，图块和连线跟着重排。
    preferred-width: 404px;
    preferred-height: 372px;
    min-width: 280px;
    min-height: 240px;
    background: #fbfbfd;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        Text {
            text: "学习应用";
            font-size: 12px;
            font-weight: 600;
            color: #8a8a8e;
            height: 20px;
        }

        graph := Rectangle {
            vertical-stretch: 1;

            // 一行放得下几个由当前宽度决定，窗口拉大就多排几个。
            property <int> columns: max(1, floor(self.width / 124px));
            property <length> stride-x: 124px;
            property <length> stride-y: 132px;
            // 图块内那个圆角色块的中心，连线从这里出发、到这里收尾。
            property <length> hub-x: 58px;
            property <length> hub-y: 38px;

            // 学科之间的历史演进关系（C++ 从 C 长出来）。画在图块下面，
            // 坐标和图块用同一套算式，窗口一变两边一起动。
            for link in root.links: Path {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                viewbox-x: 0;
                viewbox-y: 0;
                viewbox-width: parent.width / 1px;
                viewbox-height: parent.height / 1px;
                stroke: #a8a8b0;
                stroke-width: 1.5px;

                property <float> fx: (mod(link.from, graph.columns) * graph.stride-x + graph.hub-x) / 1px;
                property <float> fy: (floor(link.from / graph.columns) * graph.stride-y + graph.hub-y) / 1px;
                property <float> tx: (mod(link.to, graph.columns) * graph.stride-x + graph.hub-x) / 1px;
                property <float> ty: (floor(link.to / graph.columns) * graph.stride-y + graph.hub-y) / 1px;
                // 单位向量：线从色块边缘起止，不压在图标上；箭头也按它算。
                property <float> span: max(1, sqrt((tx - fx) * (tx - fx) + (ty - fy) * (ty - fy)));
                property <float> ux: (tx - fx) / span;
                property <float> uy: (ty - fy) / span;
                property <float> gap: 33;
                property <float> head: 5.5;
                // 起止点：落在两端色块的边缘，不压住图标。
                property <float> sx: fx + ux * gap;
                property <float> sy: fy + uy * gap;
                property <float> ex: tx - ux * gap;
                property <float> ey: ty - uy * gap;
                // 思维导图那种弧：控制点沿法线拱起一点，线就不是硬邦邦的直线。
                property <float> arc: 13;
                property <float> nx: -uy * arc;
                property <float> ny: ux * arc;

                MoveTo { x: parent.sx; y: parent.sy; }
                CubicTo {
                    control-1-x: parent.sx + (parent.ex - parent.sx) * 0.35 + parent.nx;
                    control-1-y: parent.sy + (parent.ey - parent.sy) * 0.35 + parent.ny;
                    control-2-x: parent.sx + (parent.ex - parent.sx) * 0.65 + parent.nx;
                    control-2-y: parent.sy + (parent.ey - parent.sy) * 0.65 + parent.ny;
                    x: parent.ex;
                    y: parent.ey;
                }
                // 箭头：贴着终点，沿进入方向的两笔。
                MoveTo {
                    x: parent.ex - parent.ux * parent.head - parent.uy * parent.head * 0.9;
                    y: parent.ey - parent.uy * parent.head + parent.ux * parent.head * 0.9;
                }
                LineTo { x: parent.ex; y: parent.ey; }
                LineTo {
                    x: parent.ex - parent.ux * parent.head + parent.uy * parent.head * 0.9;
                    y: parent.ey - parent.uy * parent.head - parent.ux * parent.head * 0.9;
                }
            }

            for entry[index] in apps: Tile {
                x: mod(index, graph.columns) * graph.stride-x;
                y: floor(index / graph.columns) * graph.stride-y;
                entry: entry;
                open => { root.open(entry.id); }
                stop => { root.stop(entry.id); }
            }
        }

        Text {
            text: status;
            font-size: 11px;
            color: #8a8a8e;
            wrap: word-wrap;
            height: 28px;
        }
    }
}
