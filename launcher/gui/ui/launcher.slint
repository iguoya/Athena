// 启动器的全部界面。声明式写法，和项目里的 .blp（GTK）、.qml（Qt）是同一种思路：
// 布局写在这里，Rust 只负责填数据和响应回调。

import { ScrollView } from "std-widgets.slint";

/// 思维导图里一个应用的位置：图标中心，单位是画布坐标（不带 px，由 Rust 的布局给出）。
export struct NodePos {
    x: float,
    y: float,
}

/// 一条同心椭圆轨道：长半轴沿横向（launcher ADR 0002）。
export struct RingSpec {
    rx: float,
    ry: float,
}

/// 领域分组节点：胶囊中心与颜色。
export struct GroupSpec {
    name: string,
    color: color,
    x: float,
    y: float,
    // 胶囊宽度：按名字的字数由布局算好。
    w: float,
}

/// 一条连线：三次贝塞尔（起点、两个控制点、终点）。kind：0 虎头→领域，1 领域→应用，
/// 2 演进（带箭头），3 相关，4 挂靠，5 引用挂靠（ADR 0116）。颜色连透明度一起由 Rust 按 kind 算好。
export struct MapLink {
    kind: int,
    color: color,
    x0: float, y0: float,
    cx1: float, cy1: float,
    cx2: float, cy2: float,
    x1: float, y1: float,
    has-arrow: bool,
    ax: float, ay: float,
    bx: float, by: float,
    cx: float, cy: float,
}

export struct AppEntry {
    id: string,
    title: string,
    // 图块里的图标，来自应用自己的彩色 icon.svg（ADR 0065），原样显示；
    // 没有图标时用 accent 色块 + letter 顶上。
    icon: image,
    has-icon: bool,
    // 兜底色块里的字，取自 app.json 的 icon.letter（"C++"、"算"）。
    letter: string,
    // 兜底色块的底色，取自 icon.accent。有图标的应用用不上它。
    accent: color,
    // 运行状态点的颜色：绿=运行中、橙=启动中、灰=未运行。
    tint: brush,
    running: bool,
}

component Tile inherits Rectangle {
    in property <AppEntry> entry;
    callback open();
    callback stop();

    width: 116px;
    height: 124px;
    border-radius: 12px;

    // 图块里的东西全部绝对定位，共用同一条中轴线。交给 VerticalLayout 排的话，
    // 定宽的色块和整宽居中的标题各按各的算，看着就是散的。
    property <length> hub: 56px;
    property <length> hub-top: 10px;

    // 图标在三种运行状态下一模一样（ADR 0065）：同一张图、同样大小，
    // 状态只交给下面那颗状态点。悬停放大一点是在回应指针，不是状态。
    property <length> side: touch.has-hover ? root.hub + 4px : root.hub;

    Image {
        source: entry.icon;
        visible: entry.has-icon;
        x: (parent.width - self.width) / 2;
        y: root.hub-top + (root.hub - self.height) / 2;
        width: root.side;
        height: self.width;
        image-fit: contain;
        animate width { duration: 140ms; easing: ease-out; }
    }

    // 兜底：没有 icon.svg 的应用，用 accent 色块加 letter。
    Rectangle {
        visible: !entry.has-icon;
        x: (parent.width - self.width) / 2;
        y: root.hub-top + (root.hub - self.height) / 2;
        width: root.side;
        height: self.width;
        border-radius: self.width / 3.6;
        background: entry.accent;
        drop-shadow-blur: 5px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: #00000024;
        animate width { duration: 140ms; easing: ease-out; }

        Text {
            text: entry.letter;
            color: white;
            font-size: entry.letter.character-count > 1 ? 19px : 24px;
            font-weight: 600;
            width: parent.width;
            height: parent.height;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // 标题紧跟色块，两者当成一组；状态另起一行，离得开一点。
    Text {
        x: 4px;
        y: root.hub-top + root.hub + 8px;
        width: parent.width - 8px;
        text: entry.title;
        font-size: 12px;
        color: #1c1c1e;
        horizontal-alignment: center;
        overflow: elide;
    }

    // 状态点：运行状态唯一的表达。运行中更大并带同色光晕；tint 由 Rust 按三态算好。
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.hub-top + root.hub + 28px;
        width: entry.running ? 9px : 6px;
        height: self.width;
        border-radius: self.width / 2;
        background: entry.tint;
        drop-shadow-blur: entry.running ? 8px : 0px;
        drop-shadow-color: entry.tint;
        animate width, drop-shadow-blur {
            duration: 160ms;
            easing: ease-out;
        }
    }

    touch := TouchArea {
        clicked => { root.open(); }
    }

    // 悬停时右上角出现停止按钮，只对正在运行的显示。
    Rectangle {
        x: parent.width - 28px;
        y: 8px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        visible: entry.running && (touch.has-hover || stop-touch.has-hover);
        background: stop-touch.has-hover ? #d32f2f : #0000002e;

        stop-touch := TouchArea {
            clicked => { root.stop(); }
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 1.5px;
                background: white;
            }
        }
    }
}

// 实践面板用：跟学习应用那张图谱不同，没有"谁从谁长出来"的演进关系可画
// （practice/ 下的小项目彼此独立），复用同一个 Tile，去掉连线那一套。
component PracticeGrid inherits ScrollView {
    in property <[AppEntry]> apps;
    callback open(string);
    callback stop(string);

    property <int> columns: max(1, floor(self.width / 124px));
    property <int> rows: max(1, floor((apps.length + self.columns - 1) / self.columns));
    property <length> stride-x: 124px;
    property <length> stride-y: 132px;
    viewport-width: self.width;
    viewport-height: max(self.height, self.rows * self.stride-y);

    for entry[index] in apps: Tile {
        x: mod(index, columns) * stride-x;
        y: floor(index / columns) * stride-y;
        entry: entry;
        open => { root.open(entry.id); }
        stop => { root.stop(entry.id); }
    }
}

// 领域分组的胶囊：颜色、宽度都来自布局（颜色按分组出现顺序取，宽度按名字字数算），高度与 core 的 PILL_H 一致。
component GroupPill inherits Rectangle {
    in property <GroupSpec> spec;
    width: spec.w * 1px;
    height: 32px;
    border-radius: 16px;
    background: spec.color;
    Text {
        text: spec.name;
        color: white;
        font-size: 13px;
        font-weight: 600;
        width: parent.width - 12px;
        x: 6px;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

// 学习应用面板：放射状思维导图（ADR 0083）。位置全部由 core 的布局算好，这里只负责画：
// 同心圈（空间感）→ 连线 → 虎头与领域胶囊 → 应用图块。图块仍是原来的 Tile，图标原样显示（ADR 0065）。
component MindMap inherits ScrollView {
    in property <[AppEntry]> apps;
    in property <[NodePos]> positions;
    in property <[GroupSpec]> groups;
    in property <[MapLink]> map-links;
    in property <[RingSpec]> rings;
    in property <float> map-width;
    in property <float> map-height;
    in property <float> center-x;
    in property <float> center-y;
    callback open(string);
    callback stop(string);

    // 窗口比画布大时把画布摆在正中；比画布小时靠滚动。
    property <length> canvas-w: max(self.width, root.map-width * 1px);
    property <length> canvas-h: max(self.height, root.map-height * 1px);
    property <length> ox: (self.canvas-w - root.map-width * 1px) / 2;
    property <length> oy: (self.canvas-h - root.map-height * 1px) / 2;
    viewport-width: self.canvas-w;
    viewport-height: self.canvas-h;

    // 同心椭圆：从外到内叠着画，每一圈淡淡地铺一层底，叠起来中间深、外面浅——
    // 这就是「立体」的来源，不碰图标本身。椭圆而不是正圆：屏幕是横向的，
    // 内容铺进宽屏真正看得到的宽度（launcher ADR 0002）。椭圆用四段三次贝塞尔
    // 近似（κ ≈ 0.5523 是圆弧贝塞尔的标准系数），肉眼与真椭圆无差。
    property <float> kappa: 0.552284749;
    for r in rings: Path {
        x: 0; y: 0;
        width: root.canvas-w;
        height: root.canvas-h;
        viewbox-width: root.canvas-w / 1px;
        viewbox-height: root.canvas-h / 1px;
        fill: #5468a40a;
        stroke: #5468a418;
        stroke-width: 1px;

        MoveTo { x: root.ox / 1px + root.center-x - r.rx; y: root.oy / 1px + root.center-y; }
        CubicTo {
            control-1-x: root.ox / 1px + root.center-x - r.rx;
            control-1-y: root.oy / 1px + root.center-y - r.ry * root.kappa;
            control-2-x: root.ox / 1px + root.center-x - r.rx * root.kappa;
            control-2-y: root.oy / 1px + root.center-y - r.ry;
            x: root.ox / 1px + root.center-x;
            y: root.oy / 1px + root.center-y - r.ry;
        }
        CubicTo {
            control-1-x: root.ox / 1px + root.center-x + r.rx * root.kappa;
            control-1-y: root.oy / 1px + root.center-y - r.ry;
            control-2-x: root.ox / 1px + root.center-x + r.rx;
            control-2-y: root.oy / 1px + root.center-y - r.ry * root.kappa;
            x: root.ox / 1px + root.center-x + r.rx;
            y: root.oy / 1px + root.center-y;
        }
        CubicTo {
            control-1-x: root.ox / 1px + root.center-x + r.rx;
            control-1-y: root.oy / 1px + root.center-y + r.ry * root.kappa;
            control-2-x: root.ox / 1px + root.center-x + r.rx * root.kappa;
            control-2-y: root.oy / 1px + root.center-y + r.ry;
            x: root.ox / 1px + root.center-x;
            y: root.oy / 1px + root.center-y + r.ry;
        }
        CubicTo {
            control-1-x: root.ox / 1px + root.center-x - r.rx * root.kappa;
            control-1-y: root.oy / 1px + root.center-y + r.ry;
            control-2-x: root.ox / 1px + root.center-x - r.rx;
            control-2-y: root.oy / 1px + root.center-y + r.ry * root.kappa;
            x: root.ox / 1px + root.center-x - r.rx;
            y: root.oy / 1px + root.center-y;
        }
        Close {}
    }

    for link in root.map-links: Rectangle {
        x: 0; y: 0;
        width: root.canvas-w;
        height: root.canvas-h;
        Path {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: parent.width / 1px;
            viewbox-height: parent.height / 1px;
            stroke: link.color;
            stroke-width: link.kind == 2 ? 2.2px : link.kind == 3 ? 1.6px : link.kind == 0 ? 2.4px : 1.6px;

            MoveTo { x: root.ox / 1px + link.x0; y: root.oy / 1px + link.y0; }
            CubicTo {
                control-1-x: root.ox / 1px + link.cx1;
                control-1-y: root.oy / 1px + link.cy1;
                control-2-x: root.ox / 1px + link.cx2;
                control-2-y: root.oy / 1px + link.cy2;
                x: root.ox / 1px + link.x1;
                y: root.oy / 1px + link.y1;
            }
        }
        if link.has-arrow: Path {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            viewbox-x: 0;
            viewbox-y: 0;
            viewbox-width: parent.width / 1px;
            viewbox-height: parent.height / 1px;
            fill: link.color;

            MoveTo { x: root.ox / 1px + link.ax; y: root.oy / 1px + link.ay; }
            LineTo { x: root.ox / 1px + link.bx; y: root.oy / 1px + link.by; }
            LineTo { x: root.ox / 1px + link.cx; y: root.oy / 1px + link.cy; }
            Close {}
        }
    }

    // 中心：启动器自己的虎头。
    Image {
        source: @image-url("../assets/tiger-mark.png");
        width: 72px;
        height: 72px;
        x: root.ox + root.center-x * 1px - 36px;
        y: root.oy + root.center-y * 1px - 36px;
        image-fit: contain;
    }

    for group in root.groups: GroupPill {
        spec: group;
        x: root.ox + group.x * 1px - group.w * 0.5px;
        y: root.oy + group.y * 1px - 16px;
    }

    for entry[index] in root.apps: Tile {
        // 节点坐标是图标中心；图块的图标中心在 (58, 38)。
        x: root.ox + root.positions[index].x * 1px - 58px;
        y: root.oy + root.positions[index].y * 1px - 38px;
        entry: entry;
        open => { root.open(entry.id); }
        stop => { root.stop(entry.id); }
    }
}

export component LauncherWindow inherits Window {
    in property <[AppEntry]> apps;
    // 实践面板：跟学习应用区隔开的独立分区（practice/ 下的小项目），
    // 侧重动手练习，不是知识学习——两者背后是同一套发现和启动逻辑，只是
    // 数据源（发现根目录）和界面分区不同。空的时候整个分区隐藏，不占地方。
    in property <[AppEntry]> practice-apps;
    in property <string> status;
    // 思维导图（ADR 0083）：位置、分组和连线全部由 launcher-core 的布局算好。
    in property <[NodePos]> positions;
    in property <[GroupSpec]> groups;
    in property <[MapLink]> map-links;
    in property <[RingSpec]> rings;
    in property <float> map-width: 600;
    in property <float> map-height: 600;
    in property <float> center-x: 300;
    in property <float> center-y: 300;
    // 必须点名带简体的 UI 字体。Slint 缺字回退在英文 Windows 上会先命中
    // Yu Gothic，简体独有的「语」「习」「结」直接空白。具体家族名由 Rust 按
    // 平台填进来，这里只负责接到 Window 的默认字体上。
    in property <string> ui-font: "sans-serif";
    callback open(string);
    callback stop(string);

    title: "Athena 启动器";
    // 标题栏左上角：与托盘、任务栏同一份虎头（build.rs 从 tiger.svg 渲染）。
    icon: @image-url("../assets/tiger-mark.png");
    default-font-family: ui-font;
    // 思维导图是横向的椭圆画布（launcher ADR 0002），窗口跟着宽一点才放得下
    // 内容；放不下就在画布里滚动。下面还有实践面板和状态栏。
    preferred-width: 960px;
    preferred-height: 820px;
    min-width: 360px;
    min-height: 420px;
    background: #fbfbfd;

    VerticalLayout {
        padding: 12px;
        spacing: 6px;

        Text {
            text: "学习应用";
            font-size: 12px;
            font-weight: 600;
            color: #8a8a8e;
            height: 20px;
        }

        graph := MindMap {
            // 思维导图吃掉窗口里剩下的高度；放不下就滚动。
            vertical-stretch: 1;
            min-height: 320px;
            apps: root.apps;
            positions: root.positions;
            groups: root.groups;
            map-links: root.map-links;
            rings: root.rings;
            map-width: root.map-width;
            map-height: root.map-height;
            center-x: root.center-x;
            center-y: root.center-y;
            open(id) => { root.open(id); }
            stop(id) => { root.stop(id); }
        }

        if practice-apps.length > 0: Rectangle {
            height: 1px;
            background: #e5e5ea;
        }

        if practice-apps.length > 0: Text {
            text: "实践面板";
            font-size: 12px;
            font-weight: 600;
            color: #8a8a8e;
            height: 20px;
        }

        if practice-apps.length > 0: PracticeGrid {
            height: 132px;
            apps: practice-apps;
            open(id) => { root.open(id); }
            stop(id) => { root.stop(id); }
        }

        Text {
            text: status;
            font-size: 11px;
            color: #8a8a8e;
            wrap: word-wrap;
            height: 28px;
        }
    }
}
