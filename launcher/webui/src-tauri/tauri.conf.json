{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "athena-launcher",
  "version": "0.1.0",
  "identifier": "cn.athena.launcher.webui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1510",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Athena 启动器",
        "width": 1600,
        "height": 1000,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
