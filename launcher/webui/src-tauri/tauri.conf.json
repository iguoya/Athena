{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "athena-launcher",
  "version": "10.0.0",
  "identifier": "cn.athena.launcher.webui",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1510",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Athena 启动器",
        "width": 1600,
        "height": 1000,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3NUQ0NjZDQzRFRDE0QTcKUldTbkZPM0ViRVpkdDNDcHdhZHdTS0N6dTZ2REp5Q2NjcTN6UzE4dzRqL3FLWHlOeFVjODFjNXgK",
      "endpoints": [
        "https://github.com/iguoya/Athena/releases/download/app-updates/launcher.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
