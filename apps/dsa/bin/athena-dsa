#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export ATHENA_DSA_ROOT="$ROOT"

if [[ "$(uname -s)" == "Darwin" ]]; then
  TARGET="$ROOT/bin/athena-dsa.app/Contents/MacOS/athena-dsa"
else
  TARGET="$ROOT/bin/athena-dsa.bin"
fi

if [[ ! -x "$TARGET" ]]; then
  echo "数据结构与算法应用尚未构建：$TARGET" >&2
  echo "请在 $ROOT 执行 npm run build:app" >&2
  exit 1
fi

exec "$TARGET" "$@"
