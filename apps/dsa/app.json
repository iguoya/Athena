{
  "id": "dsa",
  "title": "数据结构与算法",
  "description": "独立的数据结构与算法学习应用：大纲、教案、可视化与可即时编译运行的 C++ 实验；可脱离 Athena 主程序单独使用。",
  "icon": {
    "type": "theme",
    "name": "applications-science-symbolic",
    "symbol": "point.3.connected.trianglepath.dotted",
    "letter": "算",
    "accent": "#2E7D32",
    "file": "icon.svg"
  },
  "dev": {
    "env": {
      "ATHENA_DSA_ROOT": "${dir}"
    },
    "prepare": [
      {
        "when_missing": "node_modules",
        "run": [
          "npm",
          "install"
        ],
        "label": "安装前端依赖"
      }
    ],
    "run": [
      "npm",
      "run",
      "tauri:dev"
    ],
    "ready": {
      "http": "http://localhost:1420"
    },
    "match": "src-tauri/target",
    "binary": "athena-dsa"
  }
}
