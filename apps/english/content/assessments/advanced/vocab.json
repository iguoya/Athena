    {
      "id": "en.assessment.advanced.vocab.qualify",
      "word": "qualify",
      "senses": [
        {
          "pos": "v",
          "gloss": "限制；给主张加上限定"
        }
      ],
      "sentence": "The author later qualifies this optimistic conclusion by noting two practical limits.",
      "prompt": "qualifies the conclusion 表示什么？",
      "error_tag": "论证词义",
      "choices": [
        {
          "label": "给乐观结论加上限制条件",
          "ok": true,
          "why": "后面的 two practical limits 说明原结论被限定。"
        },
        {
          "label": "证明结论绝对正确",
          "ok": false,
          "why": "加限制不是加强到绝对。"
        },
        {
          "label": "使作者获得资格",
          "ok": false,
          "why": "宾语是 conclusion，不是人。"
        }
      ],
