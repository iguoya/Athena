    {
      "id": "en.assessment.advanced.vocab.assume",
      "word": "assume",
      "senses": [
        {
          "pos": "v",
          "gloss": "假定；把…当作前提"
        }
      ],
      "sentence": "Such estimates assume that people will continue to travel in the same way.",
      "prompt": "assume that 揭示了什么？",
      "error_tag": "论证前提",
      "choices": [
        {
          "label": "估算把出行方式不变当作前提",
          "ok": true,
          "why": "assume that 引出尚未被证明但被采用的前提。"
        },
        {
          "label": "估算已经证明出行方式不会变",
          "ok": false,
          "why": "假设不等于证明。"
        },
        {
          "label": "人们承担了出行责任",
          "ok": false,
          "why": "这是对 assume 另一义项的误用。"
        }
      ],
