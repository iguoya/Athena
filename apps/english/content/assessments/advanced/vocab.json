      "word": "address",
      "senses": [
        {
          "pos": "v",
          "gloss": "处理；应对"
        }
      ],
      "sentence": "The proposal addresses the immediate shortage but says little about its underlying causes.",
      "prompt": "addresses 在这里表示什么？",
      "error_tag": "熟词生义",
      "choices": [
        {
          "label": "处理、应对",
          "ok": true,
          "why": "宾语是 shortage，表示着手解决问题。"
        },
        {
          "label": "写下地址",
          "ok": false,
          "why": "address 作地址时通常是名词。"
        },
        {
          "label": "向短缺发表演讲",
          "ok": false,
          "why": "address an audience 才可能表示演说。"
        }
      ],
