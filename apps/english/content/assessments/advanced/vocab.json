        }
      ],
      "sentence": "Changes in family size may account for much of the difference between the two surveys.",
      "prompt": "account for 在这里是什么意思？",
      "error_tag": "熟词生义",
      "choices": [
        {
          "label": "解释差异的大部分原因",
          "ok": true,
          "why": "account for 在分析中表示解释或构成。"
        },
        {
          "label": "为两项调查开设账户",
          "ok": false,
          "why": "语境不是金融账户。"
        },
        {
          "label": "把两个调查逐字记录下来",
          "ok": false,
          "why": "这里讨论 difference 的来源。"
        }
      ],
