    {
      "id": "en.vocab.substantial",
      "word": "substantial",
      "senses": [
        {
          "pos": "adj",
          "gloss": "相当大的；实质的"
        }
      ],
      "sentence": "The reform produced a substantial decline in rural poverty.",
      "prompt": "句中 substantial 修饰的是哪一层意思？",
      "choices": [
        {
          "label": "幅度大、分量够的（下降）",
          "ok": true,
          "why": "这里说的是 poverty 下降的规模，不是“固体的”。"
        },
        {
          "label": "固体的、有形体的",
          "ok": false,
          "why": "那是物质义，议论文里更常见“相当大的”。"
        },
        {
          "label": "可疑的、靠不住的",
          "ok": false,
          "why": "那是 dubious / questionable。"
        },
        {
          "label": "暂时的",
          "ok": false,
          "why": "temporary 才是暂时。"
        }
      ],
      "variants": [
        {
          "sentence": "The project requires a substantial amount of time.",
          "prompt": "substantial amount 指什么？",
          "choices": [
            {
              "label": "相当多的时间",
              "ok": true,
              "why": "强调数量大。"
            },
            {
              "label": "一小会儿",
              "ok": false,
              "why": "语义相反。"
            }
          ]
        }
      ],
      "source_refs": [
        {
          "source_id": "tatoeba-sentences",
          "relation": "adapted",
