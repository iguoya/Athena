    {
      "id": "en.vocab.maintain",
      "word": "maintain",
      "senses": [
        {
          "pos": "v",
          "gloss": "主张；坚称"
        },
        {
          "pos": "v",
          "gloss": "维持；维护"
        }
      ],
      "sentence": "The authors maintain that the change is cultural, not technical.",
      "prompt": "这句里 maintain 更接近哪个意思？",
      "choices": [
        {
          "label": "主张 / 坚称",
          "ok": true,
          "why": "maintain that … 在议论文里几乎总是“认为并坚持”。"
        },
        {
          "label": "维修机器",
          "ok": false,
          "why": "维修义后面常接设备，不接 that 从句。"
        },
        {
          "label": "维持原状不改",
          "ok": false,
          "why": "maintain a level 才是维持；这里带 that。"
        },
        {
          "label": "资助",
          "ok": false,
          "why": "sponsor / fund 才是资助。"
        }
      ],
      "variants": [
        {
          "sentence": "Officials maintain that the measure is temporary.",
          "prompt": "maintain that 表示什么？",
          "choices": [
            {
              "label": "官员坚持认为措施是临时的",
              "ok": true,
              "why": "表示主张。"
            },
            {
              "label": "官员维修临时措施",
              "ok": false,
              "why": "不是维护设备。"
            }
          ]
        }
      ],
