  "items": [
    {
      "id": "en.vocab.nevertheless",
      "word": "nevertheless",
      "senses": [
        {
          "pos": "adv",
          "gloss": "尽管如此；然而"
        }
      ],
      "sentence": "The pay was low; nevertheless, she accepted the offer.",
      "prompt": "句中 nevertheless 在这里是什么意思？",
      "choices": [
        {
          "label": "尽管如此；然而",
          "ok": true,
          "why": "承认前半句为真，再转出她仍接受了。"
        },
        {
          "label": "因此",
          "ok": false,
          "why": "therefore 才是因果，这里是让步转折。"
        },
        {
          "label": "尤其是",
          "ok": false,
          "why": "especially 是递进，不是转折。"
        },
        {
          "label": "换句话说",
          "ok": false,
          "why": "in other words 是换述，不是让步。"
        }
      ],
      "variants": [
        {
          "sentence": "The route was longer; nevertheless, it proved safer.",
          "prompt": "nevertheless 表达什么？",
          "choices": [
            {
              "label": "尽管路更长，结果仍更安全",
              "ok": true,
              "why": "表示让步转折。"
            },
            {
              "label": "因为路更长，所以更安全",
              "ok": false,
              "why": "不是直接因果。"
            }
          ]
        }
      ],
      "source_refs": [
        {
          "source_id": "tatoeba-sentences",
          "relation": "adapted",
          "locator": "Sentence 11690915 · contributor sundown",
          "locator_url": "https://tatoeba.org/en/sentences/show/11690915",
