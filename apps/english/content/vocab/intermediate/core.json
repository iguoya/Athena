    {
      "id": "en.vocab.attribute",
      "word": "attribute",
      "senses": [
        {
          "pos": "v",
          "gloss": "把……归因于（attribute A to B）"
        }
      ],
      "sentence": "Critics attribute the decline to weaker demand rather than to new technology.",
      "prompt": "attribute the decline to weaker demand 在说什么？",
      "choices": [
        {
          "label": "把下降归因于需求变弱",
          "ok": true,
          "why": "attribute A to B = 认为 A 的原因是 B。"
        },
        {
          "label": "把下降描述为需求变弱的一种属性",
          "ok": false,
          "why": "名词 attribute（属性）不是这个句型。"
        },
        {
          "label": "把下降分配给各个部门",
          "ok": false,
          "why": "allocate / assign 才是分配。"
        },
        {
          "label": "否认下降与需求有关",
          "ok": false,
          "why": "rather than 否定的是 new technology，不是归因本身。"
        }
      ],
      "variants": [
        {
          "sentence": "The authors attribute the change to lower transport costs.",
          "prompt": "attribute A to B 是什么关系？",
          "choices": [
            {
              "label": "把变化归因于运输成本下降",
              "ok": true,
              "why": "A 是结果，B 是原因。"
            },
            {
              "label": "把成本分配给作者",
              "ok": false,
              "why": "不是分配义。"
            }
          ]
        }
      ],
      "source_refs": [
        {
          "source_id": "tatoeba-sentences",
          "relation": "adapted",
          "locator": "Sentence 5744643 · contributor zumley",
