// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. Shown in the menu bar, Dock, and About panel.
// Bundle on disk stays athena_driver.app so Flutter tooling can find it.
PRODUCT_NAME = athena_driver
PRODUCT_BUNDLE_IDENTIFIER = dev.athena.athenaDriver
PRODUCT_COPYRIGHT = Copyright © 2026 dev.athena. All rights reserved.
