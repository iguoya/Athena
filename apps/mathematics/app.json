{
  "id": "mathematics",
  "title": "数学学习",
  "description": "独立的数学学习应用：按线性变换主线组织线性代数，先看见平面被搬了一次，再用符号说清楚；可脱离 Athena 主程序单独使用。",
  "icon": {
    "type": "theme",
    "name": "accessories-calculator-symbolic",
    "symbol": "x.squareroot"
  },
  "dev": {
    "env": {
      "ATHENA_MATH_ROOT": "${dir}"
    },
    "prepare": [
      {
        "when_missing": "node_modules",
        "run": [
          "npm",
          "install"
        ],
        "label": "安装前端依赖"
      }
    ],
    "run": [
      "npm",
      "run",
      "tauri:dev"
    ],
    "ready": {
      "http": "http://localhost:1430"
    },
    "match": "src-tauri/target",
    "binary": "athena-math"
  }
}
