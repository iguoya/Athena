{
  "name": "athena-math",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/lint-content.mjs && node scripts/test-speech.mjs && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "build:app": "LIBSQLITE3_SYS_USE_PKG_CONFIG=1 tauri build --bundles app",
    "lint:content": "node scripts/lint-content.mjs",
    "dev:app": "bash scripts/dev.sh",
    "build:dmg": "LIBSQLITE3_SYS_USE_PKG_CONFIG=1 tauri build --bundles dmg",
    "test:speech": "node scripts/test-speech.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~5.8.3",
    "vite": "^6.0.3"
  }
}
