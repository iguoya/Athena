{
  "id": "cpp",
  "title": "C++ 教程",
  "description": "Athena 主程序：C++ 知识点的教学大纲、学习页与可运行实验，首页还有学科路线图。启动器里它和 apps/ 下的独立应用平级，不再是打开别的应用的必经之路。",
  "icon": {
    "type": "theme",
    "name": "text-x-cpp-symbolic",
    "symbol": "chevron.left.forwardslash.chevron.right"
  },
  "dev": {
    "prepare": [
      {
        "when_missing": "builddir",
        "run": [
          "meson",
          "setup",
          "builddir",
          "--buildtype=debug"
        ],
        "label": "配置构建目录"
      },
      {
        "run": [
          "meson",
          "compile",
          "-C",
          "builddir"
        ],
        "label": "增量编译"
      }
    ],
    "run": [
      "builddir/Athena"
    ],
    "ready": "process",
    "match": "builddir",
    "binary": "Athena"
  }
}
