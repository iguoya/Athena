{
  "id": "cpp",
  "title": "C++ 教程",
  "description": "Athena 主程序：C++ 知识点的教学大纲、学习页与可运行实验，首页还有学科路线图。启动器里它和 apps/ 下的独立应用平级，不再是打开别的应用的必经之路。",
  "icon": {
    "type": "theme",
    "name": "text-x-cpp-symbolic",
    "symbol": "chevron.left.forwardslash.chevron.right",
    "letter": "C++",
    "accent": "#00599C",
    "file": "icon.svg"
  },
  "dev": {
    "prepare": [
      {
        "when_missing": "build",
        "run": [
          "meson",
          "setup",
          "build",
          "--buildtype=debug"
        ],
        "label": "配置构建目录"
      },
      {
        "run": [
          "meson",
          "compile",
          "-C",
          "build"
        ],
        "label": "增量编译"
      }
    ],
    "run": [
      "build/Athena"
    ],
    "ready": "process",
    "match": "build",
    "binary": "Athena"
  },
  "evolves_from": "c"
}
