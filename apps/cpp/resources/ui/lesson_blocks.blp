using Gtk 4.0;

// 学习页反复出现的内容块模板。
//
// 为什么要有这个文件：type_semantics 一章的 .blp 有 2700 行，其中「带标题的
// 内容区」出现 54 次、「callout」58 次、正文段落 63 次——结构完全同构，差别
// 只在文字和一个变体类名。后续章节如果照抄这个厚度会失控；该复制的是范式，
// 不是行数。
//
// 用法见 ui/lesson_blocks.h：代码按数据实例化这些模板，往返回的容器里继续
// 塞内容。真正有教学信息量的部分（对象图、逐步演示、值类别矩阵这些需要
// Cairo 自绘或由运行时数据决定结构的）仍然各写各的，不强行套模板。

// 一个带标题的内容区：Frame 外壳 + 统一内边距的纵向容器。
Frame lesson_section {
  styles [ "panel-frame", "group-frame" ]

  Box lesson_section_body {
    orientation: vertical;
    spacing: 10;
    margin-top: 16;
    margin-bottom: 16;
    margin-start: 18;
    margin-end: 18;
  }
}

// 提示框。变体（why / key / note / trap / use）由代码加类名决定，
// 对应 style.css 里那套 Bootstrap alert 配色。
Box lesson_callout {
  orientation: vertical;
  spacing: 6;

  styles [ "lesson-callout" ]

  Label lesson_callout_title {
    halign: start;
    wrap: true;
    xalign: 0;
    styles [ "lesson-callout-title" ]
  }

  Box lesson_callout_body {
    orientation: vertical;
    spacing: 4;
  }
}

// 正文段落。单独成模板是因为它有四个固定属性要写，散在各处就是 63 组重复。
Label lesson_prose {
  halign: start;
  wrap: true;
  xalign: 0;
  styles [ "lesson-prose" ]
}

// 图 + 图注。图源由代码填，静态 SVG 与数据驱动的 DrawingArea 各用各的，
// 这里只负责统一外框与图注排版。
Box lesson_figure {
  orientation: vertical;
  spacing: 4;

  styles [ "lesson-figure" ]

  Picture lesson_figure_image {
    content-fit: contain;
    halign: fill;
    hexpand: true;
    can-shrink: true;
  }

  Label lesson_figure_caption {
    halign: start;
    wrap: true;
    xalign: 0;
    styles [ "lesson-figure-caption" ]
  }
}

// 代码块。教学页里出现 53 次，一直是手写 Label 加四行属性。
Box lesson_code {
  orientation: vertical;
  spacing: 4;

  Label lesson_code_text {
    halign: fill;
    xalign: 0;
    wrap: false;
    selectable: true;

    styles [ "native-lesson-code" ]
  }

  Label lesson_code_caption {
    halign: start;
    wrap: true;
    xalign: 0;

    styles [ "lesson-figure-caption" ]
  }
}

// 对照表。行列数由数据决定，所以 Grid 的格子由代码填（GTK 规则 2），
// 这里只固定外壳与表注的排版；单元格用下面那个模板。
Box lesson_table {
  orientation: vertical;
  spacing: 4;

  Grid lesson_table_grid {
    column-spacing: 14;
    row-spacing: 6;
    hexpand: true;
  }

  Label lesson_table_note {
    halign: start;
    wrap: true;
    xalign: 0;

    styles [ "figure-note" ]
  }
}

// 表格单元格。表头 / 普通 / 判定三种语气由代码加类名区分。
Label lesson_table_cell {
  halign: start;
  valign: start;
  wrap: true;
  xalign: 0;

  styles [ "figure-cell" ]
}

// 有序步骤的一条。
Box lesson_step {
  orientation: horizontal;
  spacing: 10;

  Label lesson_step_index {
    valign: start;

    styles [ "outline-step" ]
  }

  Label lesson_step_text {
    halign: start;
    wrap: true;
    xalign: 0;
    hexpand: true;

    styles [ "lesson-prose" ]
  }
}

// 随堂题。讲解里当场检验一次，选完立刻给对错与解析——练习和即时反馈要跟上，
// 不能只在章末挂一套题（ADR 0055 第一次扩充块词汇的原因）。
Box lesson_quiz {
  orientation: vertical;
  spacing: 8;

  styles [ "lesson-quiz" ]

  Label lesson_quiz_stem {
    halign: start;
    wrap: true;
    xalign: 0;

    styles [ "lesson-callout-title" ]
  }

  Box lesson_quiz_options {
    orientation: vertical;
    spacing: 6;
  }

  Label lesson_quiz_explain {
    visible: false;
    halign: start;
    wrap: true;
    xalign: 0;

    styles [ "figure-note" ]
  }
}

// 一个选项。整行可点（点击区域大是对的），但视觉上要轻：文字左对齐、
// 留白收紧、不用实心按钮的重边框——一排居中的蓝框读起来像命令按钮，
// 不像选项。选中后由代码加 correct / wrong 类名。
Button lesson_quiz_option {
  halign: fill;

  styles [ "lesson-quiz-option" ]

  Label lesson_quiz_option_label {
    halign: start;
    xalign: 0;
    wrap: true;
  }
}
