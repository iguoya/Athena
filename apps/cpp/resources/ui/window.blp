using Gtk 4.0;
using GtkSource 5;

// 首页：按计算机专业学习脉络铺开的学科知识图谱，取代旧的九宫格入口。
// MainWindow 运行时把 render/domain_graph_view 生成的视图挂进 home_graph。
Box home_page {
  name: "home_page";
  orientation: vertical;
  vexpand: true;

  styles [
    "app-content"
  ]

    // 学科图谱的两张图是固定宽度、不压缩的，窄窗口时整页横向滚动查看。
  ScrolledWindow {
    hscrollbar-policy: automatic;
    vexpand: true;

    Box {
      orientation: vertical;
      spacing: 28;
      valign: start;
      halign: start;
      margin-top: 40;
      margin-bottom: 56;
      margin-start: 40;
      margin-end: 40;

      Box home_graph {
        name: "home_graph";
        orientation: vertical;
        valign: start;
        halign: start;
      }
    }
  }
}

// 某一分类内部：只有章节内容栈。进入分类默认落在生成的索引页（章节网格），
// 章节之间的横向切换由顶栏的章节切换器承担，不再有常驻标签条（见 ADR 0021）。
// 分类切换只影响这里，首页布局与它互不干扰——两者是 root_stack 里并列的两页。
Box content_area {
  name: "content_area";
  orientation: vertical;
  vexpand: true;

  styles [
    "app-content"
  ]

  Stack chapter_stack {
    name: "chapter_stack";
    transition-type: crossfade;
    hexpand: true;
    vexpand: true;
  }
}

// ADR 0025：主窗口内的专注实验工作区。原章节/文档页面仍留在 chapter_stack
// 中，只在 root_stack 切换时隐藏；标签页为源码、观察和未来的可视化留出空间。
Box experiment_page {
  name: "experiment_page";
  orientation: vertical;
  spacing: 12;
  hexpand: true;
  vexpand: true;
  margin-top: 16;
  margin-bottom: 18;
  margin-start: 20;
  margin-end: 20;

  styles [
    "app-content"
  ]

  Frame {
    hexpand: true;

    styles [
      "panel-frame",
      "group-frame"
    ]

    Box {
      orientation: horizontal;
      spacing: 14;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 14;
      margin-end: 14;

      Button experiment_back_button {
        name: "experiment_back_button";
        label: "← 返回原文";
        valign: center;

        styles [
          "btn-sm"
        ]
      }

      Separator {
        orientation: vertical;
      }

      Box {
        orientation: vertical;
        spacing: 4;
        hexpand: true;

        Label experiment_title_label {
          name: "experiment_title_label";
          halign: start;
          wrap: true;
          xalign: 0;

          styles [
            "title-3"
          ]
        }

        Label experiment_objective_label {
          name: "experiment_objective_label";
          halign: start;
          wrap: true;
          wrap-mode: word_char;
          xalign: 0;

          styles [
            "dim-label"
          ]
        }
      }
    }
  }

  // 内容在前、[tab] 在后：反过来写 GtkBuilder 会在 page 尚未加入时就去设
  // tab label，每次加载打两条 GTK-CRITICAL（详见 chapters/type_semantics_lesson.blp）。
  Notebook experiment_notebook {
    name: "experiment_notebook";
    hexpand: true;
    vexpand: true;

    Paned experiment_workspace_paned {
      name: "experiment_workspace_paned";
      orientation: horizontal;
      // 具体位置在 ExperimentPage 首次获得实际可用宽度后设为一半；不要把
      // 某个开发机的固定像素宽度当作左右分栏比例。
      position: 0;
      wide-handle: true;
      resize-start-child: true;
      resize-end-child: true;
      shrink-start-child: false;
      shrink-end-child: false;
      hexpand: true;
      vexpand: true;

      Frame {
        label: "真实源码";
        hexpand: true;
        vexpand: true;

        styles [ "panel-frame", "group-frame" ]

        ScrolledWindow {
          hexpand: true;
          vexpand: true;

          GtkSource.View experiment_source_view {
            name: "experiment_source_view";
            editable: false;
            cursor-visible: false;
            monospace: true;
            show-line-numbers: true;
            highlight-current-line: false;
            tab-width: 4;
            left-margin: 14;
            right-margin: 14;
            top-margin: 12;
            bottom-margin: 12;

            styles [ "code-view" ]
          }
        }
      }

      Box {
        orientation: vertical;
        spacing: 10;
        margin-start: 12;
        hexpand: true;
        vexpand: true;

        Box {
          orientation: horizontal;
          spacing: 8;

          Spinner experiment_spinner {
            name: "experiment_spinner";
            visible: false;
            valign: center;
          }

          Label experiment_status_label {
            name: "experiment_status_label";
            visible: false;
            halign: start;
            valign: center;
            hexpand: true;

            styles [ "dim-label" ]
          }

          Button experiment_run_button {
            name: "experiment_run_button";
            label: "▶ 运行验证";
            halign: end;

            styles [ "btn-sm", "btn-primary" ]
          }
        }

        Frame {
          label: "观察结果";
          hexpand: true;
          vexpand: true;

          styles [ "panel-frame", "group-frame" ]

          ScrolledWindow {
            hexpand: true;
            vexpand: true;

            TextView experiment_result_view {
              name: "experiment_result_view";
              editable: false;
              cursor-visible: false;
              monospace: true;
              wrap-mode: word_char;
              left-margin: 14;
              right-margin: 14;
              top-margin: 12;
              bottom-margin: 12;

              styles [ "code-view" ]
            }
          }
        }
      }
    }

    [tab]
    Label { label: "验证工作台"; }


    // 动手实验（ADR 0053）：左边是学员自己的代码，右边是题目与结果。
    // 与「验证工作台」并列而不是取代它——那边看真实工程源码（示范），
    // 这边自己写一遍（待填），两半都要有。
    Paned case_workspace_paned {
      name: "case_workspace_paned";
      orientation: horizontal;
      // 同 experiment_workspace_paned：实际位置由代码在拿到可用宽度后设成
      // 一半，不写死某台开发机的像素。
      position: 0;
      wide-handle: true;
      resize-start-child: true;
      resize-end-child: true;
      shrink-start-child: false;
      shrink-end-child: false;
      hexpand: true;
      vexpand: true;

      Box {
        orientation: vertical;
        spacing: 6;
        hexpand: true;
        vexpand: true;

        Box {
          orientation: horizontal;
          spacing: 8;

          Label case_file_label {
            name: "case_file_label";
            halign: start;
            valign: center;
            hexpand: true;

            styles [ "dim-label" ]
          }

          Button case_reset_button {
            name: "case_reset_button";
            label: "重置骨架";
            tooltip-text: "丢弃你的修改，恢复成最初的骨架";
            halign: end;

            styles [ "btn-sm" ]
          }
        }

        Frame {
          label: "你的代码";
          hexpand: true;
          vexpand: true;

          styles [ "panel-frame", "group-frame" ]

          ScrolledWindow {
            hexpand: true;
            vexpand: true;

            GtkSource.View case_source_view {
              name: "case_source_view";
              editable: true;
              cursor-visible: true;
              monospace: true;
              show-line-numbers: true;
              highlight-current-line: true;
              auto-indent: true;
              insert-spaces-instead-of-tabs: true;
              tab-width: 4;
              left-margin: 14;
              right-margin: 14;
              top-margin: 12;
              bottom-margin: 12;

              styles [ "code-view" ]
            }
          }
        }
      }

      Box {
        orientation: vertical;
        spacing: 10;
        margin-start: 12;
        hexpand: true;
        vexpand: true;

        // 题干在最上面且醒目：读者第一眼该看到「要解决什么」，而不是
        // 「补全哪个函数」（apps/dsa ADR 0003 第 5 条）。
        Frame {
          label: "题目";
          hexpand: true;

          styles [ "panel-frame", "group-frame" ]

          Box {
            orientation: vertical;
            spacing: 8;
            margin-top: 10;
            margin-bottom: 10;
            margin-start: 12;
            margin-end: 12;

            Label case_prompt_label {
              name: "case_prompt_label";
              halign: start;
              wrap: true;
              xalign: 0;

              styles [ "lesson-callout-title" ]
            }

            Label case_goal_label {
              name: "case_goal_label";
              halign: start;
              wrap: true;
              xalign: 0;
            }

            Label case_hint_label {
              name: "case_hint_label";
              visible: false;
              halign: start;
              wrap: true;
              xalign: 0;

              styles [ "dim-label" ]
            }
          }
        }

        Box {
          orientation: horizontal;
          spacing: 8;

          Spinner case_spinner {
            name: "case_spinner";
            visible: false;
            valign: center;
          }

          Label case_status_label {
            name: "case_status_label";
            visible: false;
            halign: start;
            valign: center;
            hexpand: true;

            styles [ "dim-label" ]
          }

          Button case_run_button {
            name: "case_run_button";
            label: "▶ 编译并运行";
            halign: end;

            styles [ "btn-sm", "btn-primary" ]
          }
        }

        Frame {
          label: "编译与输出";
          hexpand: true;
          vexpand: true;

          styles [ "panel-frame", "group-frame" ]

          ScrolledWindow {
            hexpand: true;
            vexpand: true;

            TextView case_output_view {
              name: "case_output_view";
              editable: false;
              cursor-visible: false;
              monospace: true;
              wrap-mode: word_char;
              left-margin: 14;
              right-margin: 14;
              top-margin: 12;
              bottom-margin: 12;

              styles [ "code-view" ]
            }
          }
        }
      }
    }

    [tab]
    Label { label: "动手实验"; }


    Box {
      orientation: vertical;
      spacing: 12;
      margin-top: 24;
      margin-start: 24;
      margin-end: 24;
      hexpand: true;
      vexpand: true;

      Label {
        label: "这里将承载对象图、生命周期时间线、编译诊断和迁移变体。当前先保留稳定的工作区，不把复杂探索控件挤进正文。";
        halign: start;
        wrap: true;
        xalign: 0;

        styles [ "dim-label" ]
      }
    }

    [tab]
    Label { label: "探索（暂定）"; }

  }
}

ApplicationWindow window {
  title: "计算机与电子信息学习实验室";
  default-width: 1440;
  default-height: 900;

  styles [
    "athena-window"
  ]

  Box main_container {
    orientation: vertical;

    // === 顶栏：应用菜单、返回首页、当前位置 ===
    Box top_bar {
      name: "top_bar";
      orientation: horizontal;
      spacing: 4;

      styles [
        "app-topbar"
      ]

      // macOS 上系统标准菜单栏已经接管同一份菜单模型，这里保持隐藏；
      // 其他平台没有这层系统集成，MainWindow 在此显示它并绑定菜单。
      PopoverMenuBar app_menu_bar {
        name: "app_menu_bar";
        visible: false;
      }

      Button home_button {
        name: "home_button";
        tooltip-text: "返回首页";

        styles [
          "flat",
          "home-button"
        ]

        Box {
          orientation: horizontal;
          spacing: 8;
          valign: center;

          Image {
            icon-name: "go-home-symbolic";
            pixel-size: 18;
          }

          Label {
            label: "首页";
          }
        }
      }

      // 当前位置：MainWindow 按层级填充。分类名是一个 breadcrumb-link
      // 按钮（点回本分类索引页），其余层级是纯文本 Label。
      Box breadcrumb_box {
        name: "breadcrumb_box";
        orientation: horizontal;
        spacing: 6;
        halign: start;
        hexpand: true;
        valign: center;

        styles [
          "breadcrumb"
        ]
      }

      // 章节切换器：进入分类后显示，弹出层列出目录 + 本分类各章 + 学习工具。
      // 只在分类页可见，首页隐藏。内容由 MainWindow 按当前分类重建。
      MenuButton chapter_switcher {
        name: "chapter_switcher";
        visible: false;
        tooltip-text: "切换章节";

        styles [
          "flat"
        ]
      }
    }

    Separator {
      orientation: horizontal;
    }

    // 首页 / 分类内容 / 专注实验三选一；MainWindow 运行时把三个页面
    // 加进来，各页面的内部状态在切换时保持不变。
    Stack root_stack {
      name: "root_stack";
      transition-type: crossfade;
      vexpand: true;
    }
  }
}
