 "policy": {
  "entry": {
   "text": "中华人民共和国公民，不受性别、年龄、民族、种族和已受教育程度的限制，均可按省招生考试管理中心规定的网上报名时间报考参加山西省高等教育自学考试。我省高等教育自学考试每年举行两次，时间为 4 月、10 月。报名在「山西自学考试信息服务平台」进行。",
   "verify": {
    "level": "official",
    "source": "http://www.sxkszx.cn/news/20241127/n7326122617.html",
    "date": "2026-11-03",
    "note": "2025 年报考简章四、网上报考须知（一）（二）（五）"
   }
  },
  "graduate": {
   "text": "具备下列条件可申请毕业：①学完本专业考试计划规定的全部课程并取得合格成绩；②完成规定的实习、实验、论文答辩（设计）或其它实践性环节考核并合格；③政治思想品德鉴定合格；④申请本科毕业须取得专科（含）以上毕业证书且学信网可查。申报毕业在每年 6 月和 12 月上旬，经审核通过后在线缴费 40 元/生（晋价费字〔1996〕140 号）。",
   "verify": {
    "level": "official",
    "source": "http://www.sxkszx.cn/news/20241127/n7326122617.html",
    "date": "2026-11-03",
    "note": "2025 年报考简章八、如何办理毕业手续"
   }
  },
  "degree": null,
  "exemption": {
   "text": "按《山西省高等教育自学考试免考课程暂行管理办法》（2025 年报考简章载，含 2024 年补充）：国民教育系列相应学历毕业生与持非学历证书者可按规定免考名称相同、要求相同且学分不低于自考课程的课程；公共政治课、公共基础课（数学/外语/计算机/物理类）、计算机等级证书、CET 等对应免考关系见办法第一部分；免考申请在「山西自学考试信息服务平台」办理（2025 下半年免考申请公告：8 月下旬报名期间网上申请、现场确认）。",
   "verify": {
    "level": "official",
    "source": "http://www.sxkszx.cn/news/20241127/n7326122617.html",
    "date": "2026-11-03",
    "note": "报考简章五、免考课程暂行管理办法；申请流程见 http://www.sxkszx.cn/news/2025821/n0109126965.html（2025 下半年免考申请公告）"
   }
  }
 },
