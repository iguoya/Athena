 "policy": {
  "entry": {
   "text": "凡长期在四川省居住和工作的中华人民共和国公民（含港澳台同胞），不受性别、年龄、民族、信仰、职业和已受教育程度的限制，均可注册报考。社会型专业一个身份证只能注册一个准考证号，可报考当次开考的所有社会型专业课程；应用型专业最多可注册一个应用型专科及一个应用型专升本准考证，注册及报考事宜咨询主考学校。注册与报考在自学考试系统（zk.sceea.cn）进行。",
   "verify": {
    "level": "official",
    "source": "https://www.sceea.cn/Html/202608/Newsdetail_4929.html",
    "date": "2026-11-02",
    "note": "2026 下半年报考通告一·新生注册"
   }
  },
  "graduate": {
   "text": "专升本专业课程门数不少于 14 门（不包括毕业论文、毕业设计），总学分（不包括毕业论文、毕业设计的学分数）不低于 73 学分；各专业均设 15040 习近平新时代中国特色社会主义思想概论并纳入毕业条件。过渡期内未毕业在籍考生已合格课程按衔接表顶替，成绩全部合格后按新计划申请毕业。",
   "verify": {
    "level": "official",
    "source": "https://www.sceea.cn/Html/202507/Newsdetail_4372.html",
    "date": "2026-11-02",
    "note": "2025 版计划通告一、二；完整毕业条件表述未在已采文本中出现"
   }
  },
  "degree": null,
  "exemption": {
   "text": "课程免试分四个类型：自学考试毕业证书类（2005-06-30 以后四川省自考毕业证凭身份证办理；更早或外省自考毕业证须学信网可查毕业证书与标识免试课程的成绩档案）、其他学历证书类（毕业证须学信网可查，附标注免试课程的成绩档案；结业/肄业证书须本科及以上）、非学历证书类（中国教育考试网可查实的笔试成绩报告单或合格证书）和其他类型。免试审定费 8 元/科（川发改价格〔2022〕484号）。",
   "verify": {
    "level": "official",
    "source": "https://www.sceea.cn/Html/202609/Newsdetail_4958.html",
    "date": "2026-11-02",
    "note": "2026 下半年课程免试通告；办理时间以每期通告为准（每年 4 次）"
   }
  }
 },
