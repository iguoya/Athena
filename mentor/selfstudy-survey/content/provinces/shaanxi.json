  "policy": {
    "entry": {
      "text": "中华人民共和国公民不受性别、年龄、民族、种族和已受教育程度限制均可报名，有特殊要求的专业除外；被给予暂停参加自学考试处理且在停考期内的考生不得报名。",
      "verify": {
        "level": "official",
        "source": "https://www.sneea.cn/info/1032/16978.htm",
        "date": "2026-10-24"
      }
    },
    "graduate": {
      "text": "在籍考生符合下列条件可申请毕业：考完专业考试计划规定全部课程并取得合格成绩；完成毕业论文（设计）或其他实践性环节并合格；学分达到计划要求；考籍由省外转入者须在我省取得专科不少于 5 门、本科不少于 4 门合格成绩；课程免考符合陕考办〔2012〕1号细则；申请专升本毕业须持专科（或以上）学历证书并通过前置学历审核；思想品德鉴定合格。上半年 6 月上旬网上申请、6 月中旬前现场审核，电子注册后约 10 月中下旬发放证书。",
      "verify": {
        "level": "official",
        "source": "https://www.sneea.cn/info/1032/17510.htm",
        "date": "2026-10-31",
        "note": "2026年上半年高等教育自学考试毕业证书申办须知（2026-05-28）"
      }
    },
    "degree": {
      "text": "本科学士学位授予按《陕西省普通高等学校授予高等学历继续教育本科毕业生学士学位实施办法》（陕教规范〔2020〕7号，陕西省教育厅、陕西省学位委员会 2020-12-22 印发）执行，由各主考高校评审授予，具体申请条件（课程成绩、外语要求等）以主考学校细则为准。",
      "verify": {
        "level": "official",
        "source": "https://www.shaanxi.gov.cn/zfxxgk/fdzdgknr/zcwj/gfxwj/202209/t20220906_2250090.html",
        "date": "2026-10-31",
        "note": "陕西省人民政府网刊发的省教育厅规范性文件原文"
      }
    },
    "exemption": {
      "text": "免考依据《陕西省高等教育自学考试课程免考实施细则》（陕考办〔2012〕1号）：国家承认学历的本科（含）以上毕业生、在校生、退学生或肄业生报考本科层次，可免考名称相同且成绩合格的课程；数学类专业毕业生可免考高等数学（工本）、线性代数等，外国语言文学类毕业生可免考相应公共外语；大学英语四级合格或 425 分（含）以上可免考公共英语（英语专业除外）。免考每年上、下半年各集中办理一次（与毕业申办同期）：考务考籍系统提交申请，市级自考办初审，省自考办审批。",
      "verify": {
        "level": "notice",
        "source": "https://www.sneac.com/info/1016/3455.htm",
        "date": "2026-10-31",
        "note": "陕西招生考试信息网（省考试院主管）刊发的修订通知，附细则全文（2012-11-12）"
      }
    }
  },
