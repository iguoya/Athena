 "policy": {
  "entry": {
   "text": "中华人民共和国公民，不受性别、年龄、民族、种族和已受教育程度的限制，均可按规定报名参加高等教育自学考试。对有限制性报考条件的专业，考生须按有关规定报考（护理学、眼视光学、中药学、飞行器动力工程、交通运输专业新生注册需审核报名资格）。报名考务费每生每科 50 元（津发改价管〔2024〕16 号）。",
   "verify": {
    "level": "official",
    "source": "http://www.zhaokao.net/zxks/system/2026/05/17/030009744.shtml",
    "date": "2026-11-03",
    "note": "2026 下半年报考须知一、六"
   }
  },
  "graduate": {
   "text": "考生取得专业考试计划规定的全部课程合格成绩（含非笔试课程），并通过毕业论文答辩或毕业设计的，由天津市高等教育自学考试委员会颁发附署专业主考院校印章的专科或本科毕业证书；申请本科毕业须持有专科或专科以上毕业证书。2026 上半年毕业申请时间为 6 月 15 日至 17 日；申请毕业网上须交纳考试成绩复查费 56 元（津价费〔2001〕244 号）。",
   "verify": {
    "level": "official",
    "source": "http://www.zhaokao.net/zxks/system/2026/05/29/030009755.shtml",
    "date": "2026-11-03",
    "note": "2026 上半年毕业申请通知开头段+三、六"
   }
  },
  "degree": {
   "text": "取得本科毕业证书者，可与专业主考院校自学考试管理部门联系办理学士学位申请；申请学位的考生，请于毕业申请前主动联系本专业主考院校，了解该专业的学位授予标准及要求。",
   "verify": {
    "level": "official",
    "source": "http://www.zhaokao.net/zxks/system/2026/05/17/030009744.shtml",
    "date": "2026-11-03",
    "note": "报考须知开头段+七；具体授予条件由主考院校制定"
   }
  },
  "exemption": null
 },
