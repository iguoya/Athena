  "policy": {
    "entry": {
      "text": "中华人民共和国公民不受性别、年龄、民族、种族和已受教育程度限制，均可报名；报考本科层次专业的考生须在毕业前校验国民教育系列专科层次毕业证书；服刑人员经司法劳改管理部门审批后方可报考。高职（高专）在校生或自学考试专科在读考生可同时报考本科层次相关专业，办理毕业手续时须交验学信网认证的专科毕业证书。同一考试时间段只能选一门课程，当次最多报四门。",
      "verify": {
        "level": "official",
        "source": "https://www.ganseea.cn/zixuekaoshi/1820.html",
        "date": "2026-11-02",
        "note": "2026 年下半年报考简章「报考条件」「报考手续及相关要求」"
      }
    },
    "graduate": {
      "text": "未毕业考生可用同一准考证号选报其他专业课程，达到该专业毕业条件后申请毕业；毕业时到报名地所在市（州）教育考试招生机构办理；本科考生须交验学信网认证的专科毕业证书。论文（设计）答辩与考核费 180 元，由考生直接向主考学校缴纳。已停考专业不再办理毕业手续，在籍考生可转入现行开考的同层次相近专业，已通过课程按相同、相近和「一顶一」顶替（公共政治课、英语除外）。各专业毕业所需门数与学分见专业考试计划，本轮未取得甘肃现行专业计划。",
      "verify": {
        "level": "official",
        "source": "https://www.ganseea.cn/zixuekaoshi/1820.html",
        "date": "2026-11-02",
        "note": "2026 年下半年报考简章「报考手续及相关要求」第 5、9 条、「实践性环节考核」、「收费」"
      }
    },
    "degree": null,
    "exemption": {
      "text": "依据《甘肃省高等教育自学考试课程免考实施细则》（甘考委发〔2026〕2号），申请免考课程者在取得自学考试考籍后，通过甘肃省教育考试院首页登录甘肃省国家教育考试综合管理平台考生端网上申请办理；免考、转档手续费每人每次按一科次 40 元。不参加英语（专升本）考试的考生，可在非本专业的其他专升本专业计划中任选 2 门专业课，成绩合格可顶替英语（专升本）。细则全文本轮未取得。",
      "verify": {
        "level": "official",
        "source": "https://www.ganseea.cn/zixuekaoshi/1820.html",
        "date": "2026-11-02",
        "note": "2026 年下半年报考简章「注意事项」（一）、「报考手续及相关要求」第 8 条、「收费」"
      }
    }
  },
