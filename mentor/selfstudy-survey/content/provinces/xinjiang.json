  "policy": {
    "entry": {
      "text": "中华人民共和国公民不受性别、民族和已受教育程度等限制均可报名；可同时报考专科与本科层次各专业课程，本科毕业手续须在获得专科毕业证半年之后办理。",
      "verify": {
        "level": "official",
        "source": "https://www.xjzk.gov.cn/upload/resources/file/2025/12/18/29840.pdf",
        "date": "2026-10-24",
        "note": "简章二、三"
      }
    },
    "graduate": {
      "text": "通过专业计划全部课程考试，完成实践环节考核及毕业设计答辩，思想品德符合要求，准予毕业并颁发自学考试本科毕业证书；毕业手续可于每年上半年 6 月或下半年 12 月前往当地教育考试机构申请办理。",
      "verify": {
        "level": "official",
        "source": "https://www.xjzk.gov.cn/upload/resources/file/2025/12/18/29840.pdf",
        "date": "2026-10-24",
        "note": "简章一、八"
      }
    },
    "degree": {
      "text": "自学考试本科毕业考生可向有学位授予权的主考院校申请学位，条件由主考院校制定（080901 可按新疆师范大学学位授予相关规定申请）。",
      "verify": {
        "level": "official",
        "source": "https://www.xjzk.gov.cn/upload/resources/file/2025/12/18/29840.pdf",
        "date": "2026-10-24",
        "note": "简章一、八"
      }
    },
    "exemption": {
      "text": "已通过 03708 / 03709 / 03706 / 12656 的考生，不再要求参加对应的 15043 / 15044 / 15042 / 15041；新旧专业计划课程按简章附件 3 过渡顶替表顶替。",
      "verify": {
        "level": "official",
        "source": "https://www.xjzk.gov.cn/upload/resources/file/2025/12/18/29840.pdf",
        "date": "2026-10-24",
        "note": "简章一（二）4"
      }
    }
  },
