  "policy": {
    "entry": {
      "text": "申请毕业时须持有国家承认学历的专科（或以上）学历证书（证书信息学信网可查）；国（境）外学历须提供教育部留学服务中心认证书。",
      "verify": {
        "level": "official",
        "source": "https://www.gxeea.cn/gallary/upload_images//1148_31019_1730169712959.pdf",
        "date": "2026-10-24",
        "note": "2027 版 080901 计划说明 2"
      }
    },
    "graduate": {
      "text": "取得所有课程合格成绩，按主考学校要求撰写毕业论文并答辩合格方具备毕业条件；凡含理论考试与实践环节考核两部分的课程，须两部分都合格才算获得该课程学分；社会考生参加毕业考核与申请毕业证的学校须是同一所主考学校。",
      "verify": {
        "level": "official",
        "source": "https://www.gxeea.cn/view/content_1148_31019.htm",
        "date": "2026-10-24"
      }
    },
    "degree": {
      "text": "本科层次专业考生申请学士学位，须关注主考学校关于申请自学考试学士学位的有关规定。",
      "verify": {
        "level": "official",
        "source": "https://www.gxeea.cn/view/content_1148_31019.htm",
        "date": "2026-10-24"
      }
    },
    "exemption": {
      "text": "旧计划已合格课程按《新旧课程顶替对照表（2027 版）》顶替并换算学分；停考专业 2027-01-01 起未毕业的在籍考生，已合格课程继续有效，转入其他开考专业时代码与名称一致的课程无需再考，成绩不设有效期。",
      "verify": {
        "level": "official",
        "source": "https://www.gxeea.cn/view/content_1013_30189.htm",
        "date": "2026-10-24",
        "note": "与 https://www.gxeea.cn/view/content_1148_31019.htm 合并概括"
      }
    }
  },
