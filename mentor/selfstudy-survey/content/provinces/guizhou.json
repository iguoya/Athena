  "policy": {
    "entry": {
      "text": "在我省工作、学习、生活的中华人民共和国公民，不受性别、年龄、民族、种族和已受教育程度的限制，均可报考专科专业；报考专升本专业的考生，在申请毕业时须取得具有学历教育资格的高等学校、高等教育自学考试机构颁发的专科（或以上）学历证书。报名唯一渠道为「贵州自考」微信小程序；一个准考证号只能报考一个专业。",
      "verify": {
        "level": "official",
        "source": "http://zsksy.guizhou.gov.cn/zxks/ksbm/202606/t20260601_90233548.html",
        "date": "2026-10-31",
        "note": "贵州省2026年下半年高等教育自学考试报考通告（2026-06-01）第一节"
      }
    },
    "graduate": null,
    "degree": {
      "text": "本科各专业的学士学位授予条件及要求由相应主考学校制定和发布，各专业考试计划中不做具体说明。",
      "verify": {
        "level": "official",
        "source": "http://zsksy.guizhou.gov.cn/zxks/ksjh/202404/t20240410_84187881.html",
        "date": "2026-10-24",
        "note": "贵州省教育厅办公室关于调整我省高等教育自学考试专业考试计划的通知 五（三）"
      }
    },
    "exemption": {
      "text": "按《贵州省高等教育自学考试课程免考实施细则》（2026-04-01 起实施）：国家承认学历的本科及以上毕业生可免考本科层次 15043/15044 思政课及名称相同且要求相当的课程；专科毕业生可免考专科层次 15041/15042；PETS-3 及以上或 CET 合格成绩可免考英语（专）及英语（专升本），PETS-2 免英语（专）；NCRE 一级及以上免计算机应用基础（含实践）、二级及以上免管理系统中计算机应用（含实践）。免考全流程线上办理，每年 3 月上旬和 9 月上旬受理；准予免考课程学分不得超过专业计划总学分的 50%，新旧课程顶替课程不能免考。",
      "verify": {
        "level": "official",
        "source": "https://www.zsksy.guizhou.gov.cn/zxks/ksjh/202603/t20260310_89625957.html",
        "date": "2026-10-31",
        "note": "贵州省高等教育自学考试课程免考实施细则（2026-03-10 发布，2026-04-01 实施）；此前 exemption 条目为 2024 调整通知中的新旧课程顶替规定，与本条（免考）并存"
      }
    }
  },
