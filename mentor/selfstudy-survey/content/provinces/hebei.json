 "policy": {
  "entry": {
   "text": "凡中华人民共和国公民，不受性别、年龄、民族、种族和已受教育程度的限制，均可按规定在河北省报名参加自学考试；已公布停考的专业仅限在籍考生按有关规定报考；报考有特殊要求的专业须符合相关报考条件。每次仅限选择一个考区，最多报考两个专业，每半天限报一门课程；报考本科专业的须在毕业前取得专科（或以上）学历证书且学信网可查。",
   "verify": {
    "level": "official",
    "source": "http://www.bdksy.cn/bdattachedksy/file/20251124/20251124102600011.pdf",
    "date": "2026-11-03",
    "note": "2026 上半年报考简章一、四（二）"
   }
  },
  "graduate": {
   "text": "考生须在所学专业全部课程考试合格后，方可报名参加毕业论文（设计）等毕业环节课程考核；毕业环节课程考核由主考学校组织。毕业申请等业务在自考信息系统办理。",
   "verify": {
    "level": "official",
    "source": "https://zk.hebeea.edu.cn/HebzkWeb/content?id=1d7e260c-d6f8-42af-8a48-31cf2b40e7dc",
    "date": "2026-11-03",
    "note": "系统首页公告《实践性环节考核课程报名公告》第 3 条；完整毕业申请通知待浏览器核实"
   }
  },
  "degree": null,
  "exemption": null
