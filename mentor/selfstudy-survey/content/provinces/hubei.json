 "policy": {
  "entry": {
   "text": "所有中华人民共和国公民均可按规定报名参加自学考试专科专业考试；报考本科层次专业的考生，必须已获得国家承认的各类专科及以上学历证书，并满足所报专业的具体报考条件。报名注册与课程报考在湖北省高等教育自学考试考生服务平台进行。",
   "verify": {
    "level": "official",
    "source": "https://www.hbea.edu.cn/html/2025-12/15552.shtml",
    "date": "2026-11-02",
    "note": "2026 年报考简章一·1"
   }
  },
  "graduate": {
   "text": "凡按照本专业考试计划的规定，取得相应课程合格成绩且达到规定学分要求，实践环节考核合格，思想品德经鉴定符合要求者，经审核通过，由湖北省高等教育自学考试委员会颁发相应专业自学考试本科毕业证书，主考学校副署，国家承认学历。",
   "verify": {
    "level": "official",
    "source": "https://www.hbea.edu.cn/html/2024-07/14357.shtml",
    "date": "2026-11-02",
    "note": "2024 版计划各专业「学历层次及规格」节通用表述"
   }
  },
  "degree": {
   "text": "符合高等学历继续教育学士学位授予条件者，由主考学校按规定授予学士学位（各专业学位课程见计划课程设置表备注列）。",
   "verify": {
    "level": "official",
    "source": "https://www.hbea.edu.cn/html/2024-07/14357.shtml",
    "date": "2026-11-02",
    "note": "2024 版计划各专业「学历层次及规格」节"
   }
  },
  "exemption": {
   "text": "课程免考每年办理 4 次（学历课程与非学历课程上、下半年各一次），在考生服务平台「学历证书课程学习成果认证」模块申请。规则遵循「学历层次相当、课程相同或相近、学分相当」：已取得国家承认学历的合格课程（含自考课程），可免考已学过、课程名称和要求相当并取得合格成绩的公共基础课与选设课程中的理论课（部分 181 轮次专科专业的专业核心课不予免考）；肄业生、结业生可免公共基础课；原学历中课程须为必修，选修课、实践课不予免考；2021 年秋季及以后入学的本科/高职专科生已学过「习近平新时代中国特色社会主义思想概论」并通过考核的，可免考 15040。",
   "verify": {
    "level": "official",
    "source": "https://www.hbea.edu.cn/html/2026-09/16025.html",
    "date": "2026-11-02",
    "note": "2026 年 9 月学历证书课程免考办理须知三《学历证书课程免考规则》"
   }
  }
 },
