  "policy": {
    "entry": {
      "text": "持有具备学历教育资格的高等学校、高等教育自学考试机构颁发的专科（或以上）学历证书的考生，可取得本科段专业考试计划规定的课程成绩后毕业；申请毕业时须持该学历证书。",
      "verify": {
        "level": "official",
        "source": "https://eea.gd.gov.cn/attachment/0/532/532337/4260268.pdf",
        "date": "2026-10-24",
        "note": "各专业考试计划第二、四节通用表述"
      }
    },
    "graduate": {
      "text": "取得专业考试计划规定的全部课程合格成绩，完成规定的毕业论文（设计）或其他实践性学习环节并合格，思想品德鉴定合格，由广东省自学考试委员会颁发毕业证书，主考学校副署，国家承认本科学历。",
      "verify": {
        "level": "official",
        "source": "https://eea.gd.gov.cn/attachment/0/532/532337/4260268.pdf",
        "date": "2026-10-24",
        "note": "各专业考试计划第二节通用表述"
      }
    },
    "degree": {
      "text": "符合相应学位条件的本科毕业生，由有学位授予权的主考学校依照《中华人民共和国学位条例》等规定授予相应学位；具体条件由主考学校规定，未在此采集。",
      "verify": {
        "level": "official",
        "source": "https://eea.gd.gov.cn/attachment/0/532/532337/4260268.pdf",
        "date": "2026-10-24",
        "note": "各专业考试计划第二节通用表述"
      }
    },
    "exemption": null
  },
