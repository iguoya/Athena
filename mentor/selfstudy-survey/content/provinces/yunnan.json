  "policy": {
    "entry": {
      "text": "中华人民共和国公民，不受性别、年龄、民族、种族和已受教育程度的限制，均可按我省开考专业考试计划自愿选择专业报考（特殊要求专业除外）；申请本科毕业须持有专科（或以上）学历证书（含本科结业证），申请专科毕业无前置学历要求。课程报考费 32 元/科（云发改收费〔2006〕98号）。",
      "verify": {
        "level": "official",
        "source": "https://www.ynzs.cn/html/content/8722.html",
        "date": "2026-10-31",
        "note": "简章四「报考对象及条件」、六（四）"
      }
    },
    "graduate": {
      "text": "完成专业考试计划规定的全部课程并取得合格成绩，完成毕业论文（设计）或其他教学实践任务，思想品德鉴定合格者准予毕业，国家承认学历；有实践、实习、设计、毕业论文等考核要求的专业，须与主考学校联系完成并取得合格成绩后方可办理毕业。",
      "verify": {
        "level": "official",
        "source": "https://www.ynzs.cn/html/content/8722.html",
        "date": "2026-10-31",
        "note": "简章十（二）（三）"
      }
    },
    "degree": {
      "text": "符合学位条件的自学考试本科毕业生，由有学位授予权的主考学校依照有关规定授予学士学位；具体条件（课程成绩、外语要求等）以主考学校规定为准。",
      "verify": {
        "level": "official",
        "source": "https://www.ynzs.cn/html/content/8722.html",
        "date": "2026-10-31",
        "note": "简章十（三）"
      }
    },
