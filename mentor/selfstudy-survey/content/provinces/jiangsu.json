 "policy": {
  "entry": {
   "text": "凡中华人民共和国公民，不受性别、年龄、民族、种族和已受教育程度的限制，均可报考自学考试。申请自学考试本科毕业的考生，须持有具备学历教育资格的高等学校、高等教育自学考试机构颁发的专科（或以上）毕业证书或本科结业证书。中药学、药学、护理学等行业性较强的专业须符合相关专业报考条件。",
   "verify": {
    "level": "official",
    "source": "https://www.jseea.cn/webfile/self_learning_jhja/2026-05-25/7464464743114215424.html",
    "date": "2026-11-02",
    "note": "简编写说明二《关于报考条件的说明》"
   }
  },
  "graduate": {
   "text": "毕业论文（设计）报考条件：报考专业全部课程合格。（完整毕业条件表述在《专业考试计划（2024年版）》分册正文，本轮未转写）",
   "verify": {
    "level": "official",
    "source": "https://www.jseea.cn/webfile/self_learning_jhja/2026-05-25/7464464743114215424.html",
    "date": "2026-11-02",
    "note": "简编写说明三（四）3；完整表述待波 C 从分册 PDF 补"
   }
  },
  "degree": {
   "text": "本科专业学位授予条件由主考学校制定。凡符合学位授予条件的考生，可按规定向主考学校申请学士学位，经主考学校评审通过后授予相应学士学位证书。各专业◆标记课程为学位要求课程。",
   "verify": {
    "level": "official",
    "source": "https://www.jseea.cn/webfile/self_learning_jhja/2026-05-25/7464464743114215424.html",
    "date": "2026-11-02",
    "note": "简编写说明四《关于学位申请的说明》"
   }
  },
  "exemption": {
   "text": "按《江苏省高等教育自学考试课程免考实施细则（修订）》（苏教考自〔2025〕27号，2025-12-29 印发）：专科及以上毕业生（结业生、肄业生）报考专科专业、本科及以上毕业生报考本科专业，可免考名称相同、要求相同且已取得合格成绩的课程；免考仅限理论考试课程，实践环节课程不得申请免考（可用非学历证书免考的除外）；免考课程门数不得超过所报专业课程门数的一半。本科及以上毕业生可免考 15043 中国近现代史纲要、15044 马克思主义基本原理。00018/00019 计算机应用基础（含实践）可用全国计算机等级考试一级及以上证书或 NIT 两个科目（模块）证书免考（简编写说明三（三））。",
   "verify": {
    "level": "official",
    "source": "https://www.jseea.cn/webfile/index/index_zcwj/2026-01-04/7413474567542280192.html",
    "date": "2026-11-02"
   }
  }
 },
