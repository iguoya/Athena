{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "北极星",
  "version": "10.1.0",
  "identifier": "cn.athena.polaris",
  "mainBinaryName": "athena-polaris",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1470",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "北极星",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3NUQ0NjZDQzRFRDE0QTcKUldTbkZPM0ViRVpkdDNDcHdhZHdTS0N6dTZ2REp5Q2NjcTN6UzE4dzRqL3FLWHlOeFVjODFjNXgK",
      "endpoints": [
        "https://github.com/iguoya/Athena/releases/download/app-updates/polaris.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
