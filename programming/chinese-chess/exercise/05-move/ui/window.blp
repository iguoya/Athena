using Gtk 4.0;

// 按钮和侧栏写在这里。点下去做什么，由 C++ 接到 Position，不写在这份文件里。
ApplicationWindow main_window {
  title: "中国象棋";
  default-width: 1100;
  default-height: 760;

  titlebar: HeaderBar {
    show-title-buttons: true;
    title-widget: Label {
      label: "中国象棋";
      styles ["title"]
    };
  };

  Box {
    orientation: vertical;

    Box {
      orientation: horizontal;
      spacing: 12;
      margin-top: 12;
      margin-bottom: 12;
      margin-start: 12;
      margin-end: 12;

      Box board_slot {
        hexpand: true;
        vexpand: true;
      }

      Box {
        orientation: vertical;
        spacing: 8;
        margin-top: 12;
        margin-bottom: 12;
        margin-start: 12;
        margin-end: 12;
        width-request: 260;
        styles ["side"]

        Label black_label {
          label: "黑方";
          halign: start;
          styles ["player"]
        }

        ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;

          TextView moves {
            editable: false;
            cursor-visible: false;
            wrap-mode: word_char;
            vexpand: true;
          }
        }

        Label red_label {
          label: "红方";
          halign: start;
          styles ["player"]
        }

        Box {
          orientation: horizontal;
          spacing: 8;

          Button new_game {
            label: "新局";
            styles ["play"]
          }

          Button undo {
            label: "悔棋";
          }
        }
      }
    }

    Label status {
      label: "轮到红方";
      margin-top: 8;
      margin-bottom: 8;
      margin-start: 8;
      margin-end: 8;
      halign: start;
    }
  }
}
