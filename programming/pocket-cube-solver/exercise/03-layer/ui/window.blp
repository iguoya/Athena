using Gtk 4.0;

// 控件树写在这里。点下去做什么，由 C++ 的 Session 接上；魔方的两个视图是自绘的，放进空位。
ApplicationWindow main_window {
  title: "二阶魔方";
  default-width: 1200;
  default-height: 820;

  titlebar: HeaderBar {
    show-title-buttons: true;
    title-widget: Label {
      label: "二阶魔方 · 第一层";
      styles ["title"]
    };
  };

  Box {
    orientation: vertical;

    Box {
      orientation: horizontal;
      spacing: 12;
      margin-top: 12;
      margin-bottom: 8;
      margin-start: 12;
      margin-end: 12;

      Box {
        orientation: vertical;
        spacing: 8;
        hexpand: true;

        Box cube_slot {
          hexpand: true;
          vexpand: true;
        }

        Box {
          orientation: horizontal;
          spacing: 8;
          halign: center;

          Button scramble {
            label: "打乱";
          }

          Button reset {
            label: "复原";
          }

          Button solve {
            label: "做第一层";
            styles ["suggested-action"]
          }
        }

      }

      Box {
        orientation: vertical;
        spacing: 8;
        width-request: 380;

        Box net_slot {
          height-request: 250;
        }

        Label stage_1 {
          label: "① 做第一层";
          halign: fill;
          xalign: 0;
          styles ["stage"]
        }

        ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;

          Label moves {
            halign: start;
            valign: start;
            xalign: 0;
            wrap: true;
            styles ["moves"]
          }
        }

        Label note {
          halign: start;
          xalign: 0;
          wrap: true;
          styles ["note"]
        }

        Box {
          orientation: horizontal;
          spacing: 8;
          homogeneous: true;

          Button prev {
            label: "上一步";
          }

          Button play {
            label: "播放";
            styles ["suggested-action"]
          }

          Button next {
            label: "下一步";
          }
        }

        Box {
          orientation: horizontal;
          spacing: 8;

          Label {
            label: "速度";
          }

          Scale speed {
            hexpand: true;
            draw-value: false;
            adjustment: Adjustment {
              lower: 0.4;
              upper: 3;
              value: 1;
              step-increment: 0.1;
            };
          }
        }
      }
    }

    Label status {
      label: "";
      margin-top: 4;
      margin-bottom: 10;
      margin-start: 12;
      margin-end: 12;
      halign: start;
      wrap: true;
      styles ["status"]
    }
  }
}
