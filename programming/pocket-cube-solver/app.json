{
  "id": "pocket-cube-solver",
  "title": "二阶魔方",
  "group": "程序设计",
  "description": "从初学者的层先法出发，按七章写出一个能解任意状态的二阶魔方程序：每章一个能独立编译的 gtkmm 窗口，教程壳负责讲解、回放和启动（ADR 0169）。",
  "icon": {
    "type": "theme",
    "name": "applications-games-symbolic",
    "symbol": "cube",
    "letter": "魔",
    "accent": "#2F4F86",
    "file": "icon.svg",
    "renders": {
      "icon.ico": "ico",
      "src-tauri/icons/32x32.png": 32,
      "src-tauri/icons/128x128.png": 128,
      "src-tauri/icons/128x128@2x.png": 256,
      "src-tauri/icons/icon.ico": "ico",
      "src-tauri/icons/icon.icns": "icns"
    }
  },
  "dev": {
    "env": {
      "ATHENA_POCKET_CUBE_SOLVER_ROOT": "${dir}"
    },
    "prepare": [
      {
        "when_missing": "node_modules",
        "run": ["pnpm", "install"],
        "label": "安装前端依赖"
      }
    ],
    "run": ["pnpm", "run", "tauri:dev"],
    "ready": { "http": "http://localhost:1522" },
    "match": "src-tauri/target",
    "binary": "athena-pocket-cube-solver"
  },
  "progress": {
    "dir": "AthenaPocketCubeSolver",
    "tables": {
      "attempts": { "mode": "append", "key": ["function_id", "correct", "answered_at"] }
    }
  }
}
