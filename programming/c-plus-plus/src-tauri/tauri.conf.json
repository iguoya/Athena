{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "athena-c-plus-plus",
  "version": "10.0.0",
  "identifier": "cn.athena.cpp",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1512",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "C++ 教程",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3NUQ0NjZDQzRFRDE0QTcKUldTbkZPM0ViRVpkdDNDcHdhZHdTS0N6dTZ2REp5Q2NjcTN6UzE4dzRqL3FLWHlOeFVjODFjNXgK",
      "endpoints": [
        "https://github.com/iguoya/Athena/releases/download/app-updates/c-plus-plus.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
