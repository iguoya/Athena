{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "贪吃蛇",
  "version": "0.1.0",
  "mainBinaryName": "athena-snake",
  "identifier": "cn.athena.snake",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1514",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "贪吃蛇",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../content"]
  }
}
